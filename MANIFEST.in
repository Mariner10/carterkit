# What goes into the sdist. Tests, scratch dirs and docs never ship; the vendored
# ControlDocs and the type marker do (they are the catalog the library reads).
include LICENSE
include README.md
include CHANGELOG.md
include pyproject.toml
recursive-include carterkit/controldocs *.md *.schema.json capabilities.json
include carterkit/py.typed
prune tests
prune docs
prune examples
prune scripts
prune build
prune dist
global-exclude *.py[cod] __pycache__ .DS_Store
recursive-include carterkit/scaffold_templates *
recursive-include carterkit/tutorials *.md *.json
recursive-include carterkit/explore_assets *
include carterkit/schema.json
