    "getThere": {
     "canvas": {
      "app": "Tap **Menu**, then **Edit Layout**.",
      "points": {
       "Menu": "header.settings",
       "Edit Layout": "menu.row.editLayout"
      }
     },
     "studio": {
      "app": "Close Studio, then tap **Menu** and **Edit Layout**.",
