{
 "first-hub": {
  "id": "first-hub",
  "kind": "tutorial",
  "level": "beginner",
  "audience": "code",
  "title": "Your first hub",
  "time": 20,
  "builds": "A remote whose hub owns the state; its toggles and sliders only ask, and the hub decides and sends every value back.",
  "prerequisites": [
   "first-layout"
  ],
  "since": "2.2",
  "kit": ">=0.19",
  "uses": {
   "controls": [
    "control.toggle",
    "control.slider",
    "control.button",
    "control.label"
   ],
   "fields": [],
   "docs": [
    "doc.actions",
    "doc.sync"
   ],
   "carterkit": [
    "kit.layout.load",
    "kit.layout.serve",
    "kit.hub.on",
    "kit.hub.push"
   ]
  },
  "starterKit": "remote",
  "next": [
   "live-dashboard"
  ],
  "steps": [
   {
    "id": "layout",
    "goal": "Lay out the remote",
    "do": {
     "code": "load"
    },
    "check": "`carterkit validate layout.json` prints no errors, and `python hub.py` starts and prints a QR code."
   },
   {
    "id": "state",
    "goal": "Keep the state in the hub",
    "do": {
     "code": "state"
    },
    "check": "`STATE` in hub.py holds Power on, Mute off, Volume 30 and Brightness 70.",
    "expect": {
     "module": {
      "STATE": {
       "power": true,
       "mute": false,
       "volume": 30,
       "brightness": 70
      }
     }
    }
   },
   {
    "id": "rules",
    "goal": "Write the hub's rules",
    "do": {
     "code": "rules"
    },
    "check": "`apply(\"volume\", 95)` answers Volume stops at 80, and with Power off every other control answers that it stays as it was.",
    "expect": {
     "calls": [
      {
       "fn": "apply",
       "args": [
        "volume",
        95
       ],
       "returns": "Volume stops at 80"
      },
      {
       "fn": "apply",
       "args": [
        "power",
        false
       ],
       "returns": "Power off"
      },
      {
       "fn": "apply",
       "args": [
        "mute",
        true
       ],
       "returns": "Power is off: mute stays as it was"
      }
     ]
    }
   },
   {
    "id": "echo",
    "goal": "Send every value back",
    "do": {
     "code": "echo"
    },
    "check": "`send_state(hub, \"Ready\")` broadcasts a state frame for each of the four controls and a Ready status.",
    "expect": {
     "calls": [
      {
       "fn": "send_state",
       "args": [
        "@hub",
        "Ready"
       ]
      }
     ],
     "sent": [
      {
       "msg_type": "power_state",
       "value": true
      },
      {
       "msg_type": "volume_state",
       "value": 30
      },
      {
       "msg_type": "brightness_state",
       "value": 70
      },
      {
       "msg_type": "remote_status",
       "text": "Ready"
      }
     ]
    }
   },
   {
    "id": "listen",
    "goal": "Listen for the phone",
    "do": {
     "code": "listen"
    },
    "check": "A phone that asks for Volume 95 is sent Volume 80 and the status Volume stops at 80; asked for Brightness 10 while Power is off, it is sent 70 again.",
    "expect": {
     "when": [
      {
       "msg_type": "set_volume",
       "value": 95
      },
      {
       "msg_type": "set_power",
       "value": false
      },
      {
       "msg_type": "set_brightness",
       "value": 10
      },
      {
       "msg_type": "remote_reset"
      }
     ],
     "sent": [
      {
       "msg_type": "volume_state",
       "value": 80
      },
      {
       "msg_type": "remote_status",
       "text": "Volume stops at 80"
      },
      {
       "msg_type": "brightness_state",
       "value": 70
      },
      {
       "msg_type": "remote_status",
       "text": "Back to the defaults"
      }
     ]
    }
   },
   {
    "id": "run",
    "goal": "Run it on a phone",
    "do": {
     "code": "launch"
    },
    "check": "The phone shows the layout with the status line reading Ready; dragging Volume to the top springs it back to 80."
   }
  ]
 },
 "first-layout": {
  "id": "first-layout",
  "kind": "tutorial",
  "level": "beginner",
  "audience": "app",
  "title": "Your first layout",
  "time": 15,
  "builds": "A dial driven by a slider through a value on your phone, named and saved to your library.",
  "prerequisites": [],
  "since": "2.2",
  "uses": {
   "controls": [
    "control.gauge",
    "control.slider"
   ],
   "fields": [
    "gauge.min",
    "gauge.max",
    "gauge.label",
    "slider.min",
    "slider.max",
    "control-def.sync",
    "control-def.action"
   ],
   "docs": [
    "doc.local-store"
   ],
   "carterkit": [],
   "profiles": [
    "first-look"
   ]
  },
  "result": "first-layout.layout.json",
  "starterKit": null,
  "next": [
   "first-hub"
  ],
  "steps": [
   {
    "id": "place",
    "goal": "Place a gauge",
    "do": {
     "app": "In Studio, start a new blank layout. Tap **+** and choose **Dial**.",
     "target": "editor.add"
    },
    "as": "dial",
    "check": "A dial titled Dial sits on the page, marked 0 to 100.",
    "expect": {
     "signal": "editor.add",
     "target": "gauge"
    },
    "profile": {
     "add": [
      "gauge"
     ],
     "canvas": [
      "place",
      "resize"
     ]
    }
   },
   {
    "id": "bind",
    "goal": "Give it a value to show",
    "do": {
     "app": "Tap **Binding**. Under **What it shows**, choose **My Data**, then **New value**. Call it **Level** and make it a number.",
     "target": "editor.binding"
    },
    "check": "The Binding header says the dial shows Level, and the needle rests at 0, where Level starts.",
    "expect": {
     "signal": "editor.change",
     "target": "sync"
    },
    "profile": {
     "categories": [
      "data"
     ],
     "chips": [],
     "binding": [
      "receives"
     ]
    }
   },
   {
    "id": "range",
    "goal": "Set its range",
    "do": {
     "app": "Tap **Range** and drag the two ends to **0** and **10**.",
     "target": "editor.chip.control"
    },
    "check": "The dial is marked 0 to 10.",
    "expect": {
     "signal": "editor.change",
     "target": "max",
     "match": {
      "is": 10
     }
    },
    "profile": {
     "chips": [
      "control"
     ],
     "petals": 0,
     "rows": false
    }
   },
   {
    "id": "add-slider",
    "goal": "Add a slider under it",
    "do": {
     "app": "Tap **+**, choose **Slider** and drop it under the dial.",
     "target": "editor.add"
    },
    "as": "knob",
    "check": "A slider sits under the dial.",
    "expect": {
     "signal": "editor.add",
     "target": "slider"
    },
    "profile": {
     "add": [
      "slider"
     ],
     "canvas": [
      "place",
      "resize"
     ]
    }
   },
   {
    "id": "send",
    "goal": "Make the slider set Level",
    "do": {
     "app": "With the slider selected, tap **Binding**. Under **When you let go**, choose **Save on this phone**, then **Level**.",
     "target": "editor.binding"
    },
    "check": "The slider's Binding says it saves Level when you let go.",
    "expect": {
     "signal": "editor.change",
     "target": "action"
    },
    "profile": {
     "categories": [
      "data"
     ],
     "chips": [],
     "binding": [
      "emits"
     ]
    }
   },
   {
    "id": "match",
    "goal": "Give the slider the same range",
    "do": {
     "app": "Tap **Range** and set the slider's ends to **0** and **10**, like the dial's.",
     "target": "editor.chip.control"
    },
    "check": "The slider runs from 0 to 10.",
    "expect": {
     "signal": "editor.change",
     "target": "max",
     "match": {
      "is": 10
     }
    },
    "profile": {
     "chips": [
      "control"
     ],
     "petals": 0,
     "rows": false
    }
   },
   {
    "id": "try",
    "goal": "Try it",
    "do": {
     "app": "Tap **Try**. Drag the slider to the middle and let go.",
     "target": "editor.try"
    },
    "check": "The needle swings to 5. Drag again and it follows.",
    "expect": {
     "signal": "control.valueChanged",
     "target": "@knob",
     "match": {
      "gte": 4,
      "lte": 6
     }
    },
    "profile": {
     "canvas": []
    }
   },
   {
    "id": "keep",
    "goal": "Name it and keep it",
    "do": {
     "app": "Leave Try. Select the dial, tap **Text** and call it **My dial**. Try a **Colour** if you like, then tap **Done**.",
     "target": "editor.save"
    },
    "check": "Your layout is in your library, with a dial titled My dial above a slider.",
    "expect": {
     "signal": "editor.save"
    },
    "profile": "first-look"
   }
  ]
 },
 "live-dashboard": {
  "id": "live-dashboard",
  "kind": "tutorial",
  "level": "beginner",
  "audience": "code",
  "title": "A live dashboard",
  "time": 20,
  "builds": "A gauge, a sparkline and a text readout that the hub moves once a second, with a button that sends a command back.",
  "prerequisites": [
   "first-hub"
  ],
  "since": "2.2",
  "kit": ">=0.19",
  "uses": {
   "controls": [
    "control.gauge",
    "control.sparkline",
    "control.label",
    "control.button"
   ],
   "fields": [],
   "docs": [
    "doc.sync"
   ],
   "carterkit": [
    "kit.layout.load",
    "kit.hub.on",
    "kit.hub.push"
   ]
  },
  "starterKit": "live-dashboard",
  "next": [],
  "steps": [
   {
    "id": "layout",
    "goal": "Lay out the dashboard",
    "do": {
     "code": "load"
    },
    "check": "`carterkit validate layout.json` prints no errors, and `python hub.py` starts and prints a QR code."
   },
   {
    "id": "sensor",
    "goal": "Read a value",
    "do": {
     "code": "sensor"
    },
    "check": "`read_level()` returns a number from 0 to 100 that drifts a little each time you call it.",
    "expect": {
     "calls": [
      {
       "fn": "read_level",
       "between": [
        0,
        100
       ]
      }
     ]
    }
   },
   {
    "id": "publish",
    "goal": "Publish a reading",
    "do": {
     "code": "publish"
    },
    "check": "`publish(hub, 42.0, 40.0)` broadcasts a metrics frame with level 42.0 and a readout frame saying 42.0 % rising.",
    "expect": {
     "calls": [
      {
       "fn": "publish",
       "args": [
        "@hub",
        42.0,
        40.0
       ]
      }
     ],
     "sent": [
      {
       "msg_type": "metrics",
       "level": 42.0
      },
      {
       "msg_type": "readout",
       "text": "42.0 % rising"
      }
     ]
    }
   },
   {
    "id": "reset",
    "goal": "Answer the button",
    "do": {
     "code": "reset"
    },
    "check": "`reset(hub, {})` puts the level back to 50 and publishes it at once.",
    "expect": {
     "calls": [
      {
       "fn": "reset",
       "args": [
        "@hub",
        {}
       ]
      }
     ],
     "sent": [
      {
       "msg_type": "metrics",
       "level": 50.0
      },
      {
       "msg_type": "readout",
       "text": "50.0 %"
      }
     ]
    }
   },
   {
    "id": "loop",
    "goal": "Keep it moving",
    "do": {
     "code": "loop"
    },
    "check": "With INTERVAL shortened, the hub broadcasts at least three readings by itself, and a Reset from the phone sends 50 straight away.",
    "expect": {
     "set": {
      "INTERVAL": 0.005
     },
     "when": [
      {
       "msg_type": "reset"
      }
     ],
     "wait": 0.05,
     "at_least": {
      "metrics": 3,
      "readout": 3
     },
     "sent": [
      {
       "msg_type": "metrics",
       "level": 50.0
      }
     ]
    }
   },
   {
    "id": "run",
    "goal": "Watch it on a phone",
    "do": {
     "code": "launch"
    },
    "check": "The needle and the trend line move every second, the readout says rising or falling, and Reset to 50 swings the needle back."
   }
  ]
 }
}
