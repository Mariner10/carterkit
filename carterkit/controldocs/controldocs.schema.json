{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carter.app/controldocs/controldocs.schema.json",
  "title": "ControlDocs frontmatter (resolved)",
  "description": "The shape of one ControlDocs/*.md frontmatter after the lenient dialect is resolved: `- use:` entries expanded, `[..]` / `{..}` values decoded as flow (JSON or YAML-flow), every scalar a string. The app's ControlDocLoader.resolvedFrontmatter and carterkit's catalog.resolved_frontmatter produce it; ControlDocVersionTests and tests/test_controldocs_versions.py validate every doc against this file. Version pins: control-def.md, 'Version pins'.",
  "$comment": "Keywords used here are the subset the Swift test validator implements: $ref, $defs, type, properties, required, additionalProperties, items, enum, const, pattern, oneOf, anyOf, minItems. Add a keyword only together with its Swift implementation.",
  "oneOf": [
    { "$ref": "#/$defs/patternDoc" },
    { "$ref": "#/$defs/sharedFieldsDoc" },
    { "$ref": "#/$defs/profilesDoc" },
    { "$ref": "#/$defs/controlDoc" }
  ],
  "$defs": {
    "text": { "type": "string" },
    "number": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "flag": { "type": "string", "enum": ["true", "false"] },
    "version": {
      "description": "An app marketing version (\"2.1\", \"2.1.3\") or `next`: the release step stamps `next` with the version it ships.",
      "type": "string",
      "pattern": "^(next|[0-9]+\\.[0-9]+(\\.[0-9]+)?)$"
    },
    "change": {
      "description": "A behaviour change on an existing key: `{in: <version>, note: <what changed>}`.",
      "type": "object",
      "required": ["in", "note"],
      "additionalProperties": false,
      "properties": {
        "in": { "$ref": "#/$defs/version" },
        "note": { "type": "string", "pattern": "\\S" }
      }
    },
    "changes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/change" } },
    "name": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_.$-]*$" },
    "valueObject": {
      "description": "An enum value with pins: `{ value: pill, since: next }`.",
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "since": { "$ref": "#/$defs/version" },
        "changes": { "$ref": "#/$defs/changes" },
        "deprecated": { "$ref": "#/$defs/version" },
        "removed": { "$ref": "#/$defs/version" },
        "alias": { "type": "string" }
      }
    },
    "field": {
      "description": "One resolved `fields:` / `themeFields:` entry.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "type": "string", "pattern": "^[A-Za-z]+(\\[\\])?$" },
        "values": { "type": "array", "items": { "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/valueObject" }] } },
        "default": {},
        "description": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" },
        "does": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "valueHelp": { "type": "object", "additionalProperties": { "type": "string" } },
        "valueTitles": { "type": "object", "additionalProperties": { "type": "string" } },
        "valueSymbols": { "type": "object", "additionalProperties": { "type": "string" } },
        "valueGroups": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rowColumn" } },
        "group": { "$ref": "#/$defs/name" },
        "tab": { "type": "string", "pattern": "^[a-z]+$" },
        "styles": { "type": "array", "items": { "type": "string" } },
        "min": { "$ref": "#/$defs/number" },
        "max": { "$ref": "#/$defs/number" },
        "step": { "$ref": "#/$defs/number" },
        "bounds": { "const": "none" },
        "simple": { "const": "hide" },
        "edit": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "depth": { "enum": ["surface", "hold", "ai"] },
        "effect": { "enum": ["look", "behavior"] },
        "under": { "$ref": "#/$defs/name" },
        "category": { "$ref": "#/$defs/categoryId" },
        "chip": { "type": "string", "pattern": "\\S" },
        "facet": { "$ref": "#/$defs/name" },
        "axis": { "$ref": "#/$defs/name" },
        "unit": { "$ref": "#/$defs/text" },
        "since": { "$ref": "#/$defs/version" },
        "changes": { "$ref": "#/$defs/changes" },
        "deprecated": { "$ref": "#/$defs/version" },
        "removed": { "$ref": "#/$defs/version" },
        "alias": { "$ref": "#/$defs/name" }
      }
    },
    "rowColumn": {
      "description": "One column of an `edit: rows` field's `columns:` (aif-8whty.29): a key of each row, its type, and the kind its cell edits with. An `edit: map` field (aif-8whty.31) names two: the key (its `values` the keys Add offers first), then the value.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "title": { "$ref": "#/$defs/text" },
        "type": { "enum": ["string", "number", "bool", "enum", "color"] },
        "edit": { "enum": ["inline", "scrub", "look", "color", "symbol", "part"] },
        "values": { "type": "array", "items": { "type": "string" } },
        "default": {},
        "min": { "$ref": "#/$defs/number" },
        "max": { "$ref": "#/$defs/number" },
        "step": { "$ref": "#/$defs/number" },
        "required": { "$ref": "#/$defs/flag" },
        "self": { "$ref": "#/$defs/flag" },
        "in": { "$ref": "#/$defs/name" }
      }
    },
    "fieldList": { "type": "array", "items": { "$ref": "#/$defs/field" } },
    "ioWhen": {
      "description": "When an emits: fact fires; the Binding view phrases each one (`release`: when you let go).",
      "enum": ["change", "release", "tap", "hold", "submit", "pick", "detect", "lift", "drop", "settle", "land"]
    },
    "ioId": { "type": "string", "pattern": "^(?!none$)[a-z][A-Za-z0-9]*$" },
    "ioEmit": {
      "description": "An `emits:` fact: one event the control sends, its `{{value}}` type and an example (controls-explain spec, 'emits:').",
      "type": "object",
      "required": ["emits", "when", "type", "says", "example"],
      "additionalProperties": false,
      "properties": {
        "emits": { "$ref": "#/$defs/ioId" },
        "when": { "$ref": "#/$defs/ioWhen" },
        "title": { "$ref": "#/$defs/text" },
        "field": { "$ref": "#/$defs/name" },
        "fallback": { "$ref": "#/$defs/name" },
        "type": { "enum": ["bool", "number", "string", "color", "date", "id", "json"] },
        "tokens": { "type": "object", "additionalProperties": { "type": "string" } },
        "says": { "type": "string", "pattern": "\\S" },
        "example": {},
        "hub": {},
        "also": { "$ref": "#/$defs/text" },
        "whenBy": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/ioWhen" } } },
        "since": { "$ref": "#/$defs/version" },
        "changes": { "$ref": "#/$defs/changes" },
        "deprecated": { "$ref": "#/$defs/version" },
        "removed": { "$ref": "#/$defs/version" }
      }
    },
    "ioEmitsNone": {
      "description": "`- emits: none`: the control sends nothing (a map, a gauge, a divider).",
      "type": "object",
      "required": ["emits"],
      "additionalProperties": false,
      "properties": { "emits": { "const": "none" } }
    },
    "ioReceive": {
      "description": "A `receives:` fact: a data shape the control shows or follows, where it can come from, how it reacts (controls-explain spec, 'receives:').",
      "type": "object",
      "required": ["receives", "type", "from", "says", "reacts", "example"],
      "additionalProperties": false,
      "properties": {
        "receives": { "$ref": "#/$defs/ioId" },
        "role": { "enum": ["show", "follow"] },
        "type": { "enum": ["bool", "number", "string", "color", "date", "json"] },
        "shape": {},
        "from": { "type": "array", "minItems": 1, "items": { "enum": ["hub", "mqtt", "http", "sensor", "store", "derive", "default"] } },
        "says": { "type": "string", "pattern": "\\S" },
        "reacts": { "type": "string", "pattern": "\\S" },
        "example": {},
        "since": { "$ref": "#/$defs/version" },
        "changes": { "$ref": "#/$defs/changes" },
        "deprecated": { "$ref": "#/$defs/version" },
        "removed": { "$ref": "#/$defs/version" }
      }
    },
    "ioReceivesNone": {
      "description": "`- receives: none`: nothing feeds the control (a spacer, a divider).",
      "type": "object",
      "required": ["receives"],
      "additionalProperties": false,
      "properties": { "receives": { "const": "none" } }
    },
    "ioSample": {
      "description": "A `sample:` fact: placeholder preview data the editor draws while the control has no live value; `next` is the Try a change payload.",
      "type": "object",
      "required": ["sample"],
      "additionalProperties": false,
      "properties": {
        "sample": {},
        "next": {},
        "for": { "$ref": "#/$defs/ioId" },
        "into": { "$ref": "#/$defs/name" }
      }
    },
    "ioFact": {
      "oneOf": [
        { "$ref": "#/$defs/ioEmit" },
        { "$ref": "#/$defs/ioEmitsNone" },
        { "$ref": "#/$defs/ioReceive" },
        { "$ref": "#/$defs/ioReceivesNone" },
        { "$ref": "#/$defs/ioSample" }
      ]
    },
    "io": {
      "description": "The control's io: facts (what it sends, what it shows, editor sample data): a list of flat maps, each holding exactly one of emits / receives / sample.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ioFact" }
    },
    "colorSlot": {
      "description": "One `colorSlots:` entry (aif-5g98i.1, theming.md \"Colour roles\"): a colour the control draws, its default (a role, a theme token, a `$name` or a colour; a list makes it a series slot) and `alias`, the existing key that also sets it.",
      "type": "object",
      "required": ["slot", "default"],
      "additionalProperties": false,
      "properties": {
        "slot": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "default": { "anyOf": [{ "$ref": "#/$defs/colorValue" }, { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/colorValue" } }] },
        "alias": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" },
        "does": { "$ref": "#/$defs/text" },
        "since": { "$ref": "#/$defs/version" },
        "changes": { "$ref": "#/$defs/changes" },
        "deprecated": { "$ref": "#/$defs/version" },
        "removed": { "$ref": "#/$defs/version" }
      }
    },
    "colorValue": {
      "description": "A role (`primary`, `secondary`, `tertiary`, `neutral`), a theme colour key (`accentColor`, `trackColor`, ...), a `$name` or a hex colour, optionally `@<opacity 0-1>`.",
      "type": "string",
      "pattern": "^(primary|secondary|tertiary|neutral|accentColor|foregroundColor|secondaryColor|tertiaryColor|surfacePrimary|surfaceSecondary|surfaceTertiary|borderColor|trackColor|statusOK|statusWarn|statusError|statusInfo|scrimColor|\\$[A-Za-z_][A-Za-z0-9_-]*|#?[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?)(@(0(\\.[0-9]+)?|1(\\.0+)?))?$"
    },
    "card": {
      "description": "`card:` (aif-8whty.5): how a control's card differs from the standard one. Absent = one card behind the whole control. Whatever it draws, the Background chip's padding, corners, border and shadow shape it.",
      "type": "object",
      "required": ["draws", "says"],
      "additionalProperties": false,
      "properties": {
        "draws": {
          "description": "card: one card behind the control; face: the control's own face is its card (its fill stays the style's); each: every panel or item is a card, no outer card; when-set: flat until a Background field is set, then the standard card.",
          "enum": ["card", "face", "each", "when-set"]
        },
        "padding": { "$ref": "#/$defs/number" },
        "says": { "type": "string", "pattern": "\\S" },
        "since": { "$ref": "#/$defs/version" },
        "changes": { "$ref": "#/$defs/changes" }
      }
    },
    "controlDoc": {
      "description": "A doc with a `type` and `label`: a control, a system doc (sync, theming), a theme pack, the style rules.",
      "type": "object",
      "required": ["type", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/name" },
        "label": { "type": "string", "pattern": "\\S" },
        "icon": { "type": "string" },
        "category": { "type": "string", "pattern": "^[a-z]+$" },
        "depth": { "const": "complete" },
        "defaultSpan": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+$" } },
        "addIntent": { "enum": ["show", "change", "organize"] },
        "pickerCategory": { "type": "string" },
        "friendlyName": { "type": "string" },
        "oneLiner": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "addRank": { "type": "string", "pattern": "^[0-9]+$" },
        "starterPreset": { "type": "object" },
        "starterVariants": { "type": "array", "items": { "type": "object" } },
        "lookFormats": { "type": "array", "items": { "type": "object", "required": ["id", "name", "set"] } },
        "lookPresets": { "type": "array", "items": { "type": "object", "required": ["id", "name", "set"] } },
        "constraints": { "type": "object" },
        "card": { "$ref": "#/$defs/card" },
        "fields": { "$ref": "#/$defs/fieldList" },
        "themeFields": { "$ref": "#/$defs/fieldList" },
        "io": { "$ref": "#/$defs/io" },
        "colorSlots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/colorSlot" } },
        "baseline": { "$ref": "#/$defs/version" },
        "since": { "$ref": "#/$defs/version" },
        "changes": { "$ref": "#/$defs/changes" },
        "deprecated": { "$ref": "#/$defs/version" },
        "removed": { "$ref": "#/$defs/version" },
        "alias": { "$ref": "#/$defs/name" },
        "vibe": { "type": "string" },
        "accent": { "type": "string" },
        "colorScheme": { "type": "string" },
        "lightDarkNotes": { "type": "string" },
        "whenToUse": { "type": "string" },
        "specimen": { "type": "string" },
        "themeFile": { "type": "string" },
        "tokens": { "type": "object" },
        "appearance": { "type": "object" },
        "variants": {},
        "scope": { "type": "string" },
        "source": { "type": "string" },
        "rules": { "type": "array", "items": { "type": "object" } },
        "keys": { "type": "array", "items": { "type": "object" } },
        "valueTypes": {},
        "units": {}
      }
    },
    "patternDoc": {
      "description": "A `kind: pattern` recipe (ControlDocs/patterns).",
      "type": "object",
      "required": ["kind", "id", "family"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "pattern" },
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "family": { "type": "string" },
        "title": { "type": "string" },
        "intents": { "type": "array", "items": { "type": "string" } },
        "parts": { "type": "array", "items": { "type": "object" } },
        "surfaces": { "type": "array", "items": { "type": "string" } },
        "theme": { "type": "string" },
        "rules": { "type": "array", "items": { "type": "string" } },
        "exampleRef": { "type": "string" }
      }
    },
    "sharedFieldsDoc": {
      "description": "shared-fields.md: the one definition of each field `- use:` names.",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "shared-fields" },
        "title": { "type": "string" },
        "fields": { "$ref": "#/$defs/fieldList" },
        "themeFields": { "$ref": "#/$defs/fieldList" },
        "chips": { "type": "array", "items": { "$ref": "#/$defs/taxonomyChip" } },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/taxonomyCategory" } },
        "internal": { "$ref": "#/$defs/namePatterns" },
        "canvas": { "$ref": "#/$defs/namePatterns" }
      }
    },
    "categoryId": { "description": "A settings category or chip id (the settings taxonomy).", "type": "string", "pattern": "^[a-z]+$" },
    "namePatterns": {
      "description": "Field names; `*` matches any prefix or suffix, `a|b` is the first of them a control has.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z_*][A-Za-z0-9_.*|]*$" }
    },
    "taxonomyChip": {
      "description": "shared-fields.md `chips:`: a chip every control's editor bar draws the same way.",
      "type": "object",
      "required": ["name", "title", "icon", "order", "categories"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/categoryId" },
        "title": { "type": "string", "pattern": "\\S" },
        "icon": { "type": "string" },
        "order": { "type": "string", "pattern": "^[0-9]+$" },
        "categories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/categoryId" } },
        "tap": { "$ref": "#/$defs/namePatterns" },
        "petals": { "$ref": "#/$defs/namePatterns" },
        "petalTitles": { "type": "object", "additionalProperties": { "type": "string" } },
        "aliases": {
          "description": "A doc field path (`theme.cornerRadius`) to the chip field it is another name for: it lives where that field does.",
          "type": "object", "additionalProperties": { "$ref": "#/$defs/name" }
        },
        "always": { "$ref": "#/$defs/flag" },
        "since": { "$ref": "#/$defs/version" },
        "changes": { "$ref": "#/$defs/changes" },
        "deprecated": { "$ref": "#/$defs/version" },
        "removed": { "$ref": "#/$defs/version" },
        "alias": { "$ref": "#/$defs/name" }
      }
    },
    "taxonomyCategory": {
      "description": "shared-fields.md `categories:`: the names that belong to a category, and its home when no shared chip lists it.",
      "type": "object",
      "required": ["name", "title"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/categoryId" },
        "title": { "type": "string", "pattern": "\\S" },
        "home": { "enum": ["control", "binding", "none"] },
        "fields": { "$ref": "#/$defs/namePatterns" },
        "theme": { "$ref": "#/$defs/namePatterns" },
        "groups": { "$ref": "#/$defs/namePatterns" },
        "suffixes": { "$ref": "#/$defs/namePatterns" },
        "prefixes": { "$ref": "#/$defs/namePatterns" },
        "types": { "$ref": "#/$defs/namePatterns" },
        "since": { "$ref": "#/$defs/version" },
        "changes": { "$ref": "#/$defs/changes" },
        "deprecated": { "$ref": "#/$defs/version" },
        "removed": { "$ref": "#/$defs/version" },
        "alias": { "$ref": "#/$defs/name" }
      }
    },
    "profilesDoc": {
      "description": "profiles.md: the named editor profiles, each a filter over a control's editable fields (docs/superpowers/specs/2026-11-06-editor-profiles.md).",
      "type": "object",
      "required": ["kind", "profiles"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "profiles" },
        "title": { "type": "string" },
        "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/editorProfile" } }
      }
    },
    "profileName": { "description": "A named editor profile's id.", "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "fieldIds": {
      "description": "Editor profile field ids: `<control>.<field path>` (`gauge.min`, `chart.theme.accentColor`) or a field's bare name.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_.$-]*$" }
    },
    "editorProfile": {
      "description": "One profiles.md entry. CAR-TERTests/ControlDocProfileTests and carterkit catalog.profile_lint check every id against the taxonomy and the docs.",
      "type": "object",
      "required": ["name", "title", "since"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/profileName" },
        "title": { "type": "string", "pattern": "\\S" },
        "extends": { "$ref": "#/$defs/profileName" },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/categoryId" } },
        "chips": { "type": "array", "items": { "$ref": "#/$defs/categoryId" } },
        "fields": { "$ref": "#/$defs/fieldIds" },
        "hide": { "$ref": "#/$defs/fieldIds" },
        "petals": { "type": "string", "pattern": "^[0-5]$" },
        "rows": { "$ref": "#/$defs/flag" },
        "json": { "$ref": "#/$defs/flag" },
        "binding": { "type": "array", "items": { "enum": ["emits", "receives", "ask", "feel", "wiring"] } },
        "add": { "type": "array", "items": { "$ref": "#/$defs/name" } },
        "canvas": { "type": "array", "items": { "enum": ["place", "move", "resize", "delete", "pages"] } },
        "since": { "$ref": "#/$defs/version" },
        "changes": { "$ref": "#/$defs/changes" },
        "deprecated": { "$ref": "#/$defs/version" },
        "removed": { "$ref": "#/$defs/version" }
      }
    }
  }
}
