{
  "name": "Confirm delete",
  "id": "__ID__",
  "version": 1,
  "accentColor": "#667eea",
  "tabs": [
    {
      "id": "things-tab",
      "title": "Things",
      "icon": "trash",
      "grid": { "columns": 4, "rows": 8 },
      "children": [
        { "type": "list", "id": "things", "position": [0, 0], "span": [6, 4],
          "label": "Things", "emptyText": "Nothing left; tap Restore",
          "itemTemplate": {
            "grid": { "columns": 4, "rows": 1 },
            "children": [
              { "type": "label", "id": "name", "position": [0, 0], "span": [1, 3],
                "label": "{{item.detail}}", "text": "{{item.name}}" },
              { "type": "button", "id": "delete", "position": [0, 3], "label": "Delete",
                "icon": "trash",
                "action": { "method": "meshsocket", "event": "broadcast_request",
                            "payload": { "msg_type": "thing_delete", "id": "{{item.id}}" } } }
            ]
          },
          "sync": [{ "method": "meshsocket", "type": "listen", "event": "broadcast",
                     "valuePath": "items", "filter": { "msg_type": "things" } }] },
        { "type": "button", "id": "delete-all", "position": [6, 0], "span": [1, 2],
          "label": "Delete all", "icon": "trash.fill",
          "action": { "method": "meshsocket", "event": "broadcast_request",
                      "payload": { "msg_type": "things_clear" } } },
        { "type": "button", "id": "restore", "position": [6, 2], "span": [1, 2],
          "label": "Restore", "icon": "arrow.uturn.backward",
          "action": { "method": "meshsocket", "event": "broadcast_request",
                      "payload": { "msg_type": "things_restore" } } },
        { "type": "label", "id": "status", "position": [7, 0], "span": [1, 4],
          "text": "Delete asks on the phone first",
          "sync": [{ "method": "meshsocket", "type": "listen", "event": "broadcast",
                     "valuePath": "text", "filter": { "msg_type": "things_status" } }] }
      ]
    }
  ]
}
