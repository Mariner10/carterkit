{
  "name": "Robot Arm Work Cell",
  "headerTitle": "CELL 3 · UR-10e",
  "version": 1,
  "id": "robot-arm-cell",
  "accentColor": "#FFC400",
  "description": "A teach pendant for a six-axis machine-tending cell: analog jog sticks behind a servo gate, nested joint sliders, a drag-to-reseat path-teach canvas, cycle gantt analytics and a latched e-stop.",
  "difficulty": "expert",
  "keepAwake": true,
  "state": {
    "sync": true,
    "authority": "cell3-controller",
    "acks": true,
    "ackTimeoutMs": 1500
  },
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light",
    "header": {
      "style": "color",
      "dark": [
        "#16181B",
        "#1E2126"
      ],
      "light": "#F3F1EA"
    }
  },
  "theme": {
    "accentColor": "#FFC400",
    "accentGradient": [
      "#FFC400",
      "#FF7A1A"
    ],
    "fontDesign": "monospaced",
    "cornerRadius": 4,
    "controlPadding": 8,
    "cardPadding": 12,
    "borderWidth": 1,
    "labelFontSize": 11,
    "valueFontSize": 14,
    "valueFontWeight": "bold",
    "tabBarTint": "#FFC400",
    "dark": {
      "pageBackgroundGradient": [
        "#0E0F11",
        "#17191C",
        "#1F2226"
      ],
      "surfacePrimary": "#FFFFFF0D",
      "surfaceSecondary": "#FFFFFF08",
      "surfaceTertiary": "#FFFFFF05",
      "borderColor": "#FFC40033",
      "foregroundColor": "#F2EFE6",
      "secondaryColor": "#A9A597",
      "tertiaryColor": "#6D6A61",
      "tabBarBackground": "#121315"
    },
    "light": {
      "pageBackgroundGradient": [
        "#F3F1EA",
        "#E6E2D6"
      ],
      "surfacePrimary": "#FFFFFFE6",
      "borderColor": "#1A1A1A26",
      "foregroundColor": "#16181B",
      "secondaryColor": "#4E4B43"
    },
    "toggle": {
      "trackActiveColor": "#FFC400",
      "knobShadow": true
    },
    "slider": {
      "trackActiveColor": "#FFC400",
      "thumbColor": "#F2EFE6",
      "trackHeight": 4
    },
    "segmented": {
      "selectedColor": "#FFC400",
      "selectedTextColor": "#16181B"
    },
    "stepper": {
      "buttonColor": "#FFC40026",
      "iconColor": "#FFC400"
    }
  },
  "glance": {
    "title": "Cell 3",
    "icon": "gearshape.2.fill",
    "tint": "#FFC400",
    "hero": "rac-batch",
    "slots": [
      "rac-oee",
      "rac-estop-state",
      "rac-cell-state"
    ],
    "liveActivity": true,
    "live": {
      "tier": "fresh"
    },
    "controls": [
      {
        "id": "estop",
        "kind": "button",
        "label": "E-Stop Cell 3",
        "icon": "exclamationmark.octagon.fill",
        "control": "rac-estop"
      },
      {
        "id": "servo",
        "kind": "toggle",
        "label": "Servo Power",
        "control": "rac-servo",
        "on": {
          "label": "Servos On",
          "icon": "bolt.fill",
          "tint": "#FFC400"
        },
        "off": {
          "label": "Servos Off",
          "icon": "bolt.slash"
        }
      }
    ],
    "widgets": [
      {
        "id": "cell",
        "title": "Cell 3",
        "icon": "gearshape.2.fill",
        "families": [
          "systemSmall",
          "systemMedium",
          "accessoryRectangular"
        ],
        "scene": {
          "rows": [
            [
              {
                "tile": "ring",
                "control": "rac-batch"
              },
              {
                "tile": "gauge",
                "control": "rac-oee"
              }
            ],
            [
              {
                "tile": "light",
                "control": "rac-estop-state"
              },
              {
                "tile": "button",
                "control": "rac-estop"
              }
            ]
          ]
        }
      }
    ],
    "island": {
      "compactLeading": {
        "tile": "icon",
        "effect": "bounce"
      },
      "compactTrailing": {
        "tile": "ring",
        "control": "rac-batch"
      },
      "minimal": {
        "tile": "light",
        "control": "rac-estop-state"
      },
      "expanded": {
        "leading": {
          "tile": "icon"
        },
        "trailing": {
          "tile": "freshness"
        },
        "center": {
          "tile": "light",
          "control": "rac-cell-state"
        },
        "bottom": {
          "rows": [
            [
              {
                "tile": "value",
                "control": "rac-batch"
              },
              {
                "tile": "gauge",
                "control": "rac-oee"
              }
            ],
            [
              {
                "tile": "button",
                "control": "rac-estop"
              }
            ]
          ]
        }
      }
    }
  },
  "tabs": [
    {
      "title": "Jog",
      "icon": "dpad.fill",
      "grid": {
        "columns": 4,
        "rows": 12
      },
      "children": [
        {
          "type": "statusLight",
          "id": "rac-cell-state",
          "position": [
            0,
            0
          ],
          "span": [
            1,
            2
          ],
          "label": "Cell",
          "style": "badge",
          "size": "large",
          "pulse": true,
          "statusColors": {
            "running": "#4CD964",
            "idle": "#3DDBD9",
            "teach": "#FFC400",
            "faulted": "#FF2D2D",
            "estop": "#FF2D2D"
          },
          "defaultValue": "teach",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "robot_arm_cell_status"
              },
              "valuePath": "state"
            }
          ]
        },
        {
          "type": "statusLight",
          "id": "rac-estop-state",
          "position": [
            0,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "Safety Chain",
          "style": "badge",
          "size": "large",
          "statusColors": {
            "clear": "#4CD964",
            "muted": "#FFC400",
            "tripped": "#FF2D2D"
          },
          "defaultValue": "clear",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "robot_arm_cell_status"
              },
              "valuePath": "estop"
            }
          ]
        },
        {
          "type": "toggle",
          "id": "rac-servo",
          "position": [
            1,
            0
          ],
          "span": [
            1,
            2
          ],
          "label": "Servo Power",
          "icon": "bolt.fill",
          "haptic": "rigid",
          "animation": "snappy",
          "defaultValue": true,
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "robot_arm_cell_servo",
              "on": "{{value}}"
            }
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "robot_arm_cell_status"
              },
              "valuePath": "servo"
            }
          ]
        },
        {
          "type": "segmentedControl",
          "id": "rac-frame",
          "position": [
            1,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "Frame",
          "options": [
            "world",
            "tool",
            "user"
          ],
          "optionLabels": [
            "World",
            "Tool",
            "User"
          ],
          "defaultValue": "world",
          "haptic": "selection",
          "animation": "snappy",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "robot_arm_cell_frame",
              "frame": "{{value}}"
            }
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "robot_arm_cell_status"
              },
              "valuePath": "frame"
            }
          ]
        },
        {
