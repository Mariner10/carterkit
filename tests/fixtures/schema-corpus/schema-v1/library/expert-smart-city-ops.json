        2
       ],
       "span": [
        1,
        2
       ],
       "label": "Push VMS Msg",
       "icon": "text.bubble.fill",
       "style": "tinted",
       "tint": "#2EE6D6",
       "haptic": "medium",
       "action": {
        "method": "meshsocket",
        "mode": "broadcast",
        "event": "broadcast_request",
        "payload": {
         "msg_type": "smart_city_ops_vms_push",
         "template": "surge_detour"
        }
       }
      }
     ]
    }
   ]
  },
