{
 "name": "Smart City Ops Center",
 "headerTitle": "HARBORVIEW · TOC",
 "version": 1,
 "id": "smart-city-ops",
 "accentColor": "#FF9F1C",
 "description": "A traffic-operations-center wall for the fictional city of Harborview: district traffic heatmap, a force-directed transit network, a live incident queue pushed as dynamic cards, CCTV in a web view and a municipal energy sankey — mirrored to widgets and the Dynamic Island.",
 "difficulty": "expert",
 "keepAwake": true,
 "state": {
  "sync": true,
  "authority": "harborview-toc-hub",
  "acks": true,
  "ackTimeoutMs": 2000
 },
 "sources": {
  "cityapi": {
   "type": "http",
   "baseURL": "https://data.harborview-city.gov/api/v2",
   "interval": 60,
   "headers": {
    "Accept": "application/json"
   }
  }
 },
 "batchPublishers": true,
 "publishers": [
  {
   "sensor": "location",
   "interval": 15
  },
  {
   "sensor": "device",
   "interval": 60
  }
 ],
 "appearance": {
  "colorScheme": "dark",
  "statusBarStyle": "light",
  "header": {
   "style": "color",
   "dark": [
    "#05070D",
    "#0B1220"
   ],
   "light": "#F2EEE4"
  }
 },
 "theme": {
  "accentColor": "#FF9F1C",
  "accentGradient": [
   "#FF9F1C",
   "#FF5E3A",
   "#FF3864"
  ],
  "fontFamily": "Avenir Next Condensed",
  "cornerRadius": 6,
  "cardPadding": 12,
  "controlPadding": 8,
  "borderWidth": 1,
  "labelFontSize": 11,
  "valueFontSize": 15,
  "valueFontWeight": "bold",
  "tabBarTint": "#FF9F1C",
  "dark": {
   "pageBackgroundGradient": [
    "#04060B",
    "#0A1220",
    "#101A2B"
   ],
   "surfacePrimary": "#FF9F1C0F",
   "surfaceSecondary": "#2EE6D60A",
   "surfaceTertiary": "#FFFFFF06",
   "borderColor": "#FF9F1C2E",
   "foregroundColor": "#F4F1E8",
   "secondaryColor": "#A7B0C0",
   "tertiaryColor": "#5F6A7D",
   "tabBarBackground": "#070B14",
   "headerBackground": "#05070D"
  },
  "light": {
   "pageBackgroundGradient": [
    "#F2EEE4",
    "#E4DED0"
   ],
   "surfacePrimary": "#FFFFFFE0",
   "borderColor": "#1B222E26",
   "foregroundColor": "#121824",
   "secondaryColor": "#4A5264"
  },
  "toggle": {
   "trackActiveColor": "#FF9F1C",
   "knobColor": "#F4F1E8",
   "knobShadow": true
  },
  "slider": {
   "trackActiveColor": "#FF9F1C",
   "thumbColor": "#F4F1E8",
   "trackHeight": 4
  },
  "segmented": {
   "trackColor": "#FF9F1C14",
   "selectedColor": "#FF9F1C",
   "textColor": "#A7B0C0",
   "selectedTextColor": "#05070D"
  }
 },
 "glance": {
  "title": "Harborview TOC",
  "icon": "building.2.crop.circle.fill",
  "tint": "#FF9F1C",
  "hero": "sco-congestion",
  "slots": [
   "sco-ontime",
   "sco-grid-load",
   "sco-h-cad"
  ],
  "liveActivity": true,
  "live": {
   "tier": "fresh"
  },
  "controls": [
   {
    "id": "surge",
    "kind": "toggle",
    "label": "Surge Protocol",
    "control": "sco-surge",
    "on": {
     "label": "Surge ON",
     "icon": "exclamationmark.triangle.fill",
     "tint": "#FF3864"
    },
    "off": {
     "label": "Normal",
     "icon": "checkmark.shield"
    }
   },
   {
    "id": "alert",
    "kind": "button",
    "label": "Citywide Alert",
    "icon": "megaphone.fill",
    "control": "sco-alert-all"
   },
   {
    "id": "plan",
    "kind": "cycle",
    "label": "Signal Plan",
    "control": "sco-signal-plan",
    "states": [
     {
      "value": "am",
      "label": "AM Peak",
      "icon": "sunrise.fill",
      "tint": "#FF9F1C"
     },
     {
      "value": "pm",
      "label": "PM Peak",
      "icon": "sunset.fill",
      "tint": "#FF5E3A"
     },
     {
      "value": "event",
      "label": "Event",
      "icon": "sportscourt.fill",
      "tint": "#8C7BFF"
     },
     {
      "value": "night",
      "label": "Night",
      "icon": "moon.stars.fill",
      "tint": "#5AB8FF"
     }
    ]
   }
  ],
  "widgets": [
   {
    "id": "ops",
    "title": "City Pulse",
    "icon": "building.2.fill",
    "families": [
     "systemSmall",
     "systemMedium",
     "accessoryRectangular"
    ],
    "scene": {
     "rows": [
      [
       {
        "tile": "gauge",
        "control": "sco-congestion"
       },
       {
        "tile": "ring",
        "control": "sco-ontime"
       }
      ],
      [
       {
        "tile": "light",
        "control": "sco-h-cad"
       },
       {
        "tile": "button",
        "control": "sco-alert-all"
       }
      ]
     ]
    }
   },
   {
    "id": "energy",
    "title": "Grid Load",
    "icon": "bolt.fill",
    "families": [
     "systemSmall",
     "accessoryCircular"
    ],
    "scene": {
     "rows": [
      [
       {
        "tile": "gauge",
        "control": "sco-grid-load"
       }
      ],
      [
       {
        "tile": "sparkline",
        "control": "sco-demand"
       }
      ]
     ]
    }
   }
  ],
  "island": {
   "compactLeading": {
    "tile": "icon",
    "effect": "bounce"
   },
   "compactTrailing": {
    "tile": "gauge",
    "control": "sco-congestion"
   },
   "minimal": {
    "tile": "light",
    "control": "sco-h-cad"
   },
   "expanded": {
    "leading": {
     "tile": "icon"
    },
    "trailing": {
     "tile": "freshness"
    },
    "center": {
     "tile": "value",
     "control": "sco-inc-count"
    },
    "bottom": {
     "rows": [
      [
       {
        "tile": "gauge",
        "control": "sco-congestion"
       },
       {
        "tile": "ring",
        "control": "sco-ontime"
       },
       {
        "tile": "gauge",
        "control": "sco-grid-load"
       }
      ],
      [
       {
        "tile": "toggle",
        "control": "sco-surge"
       },
       {
        "tile": "button",
        "control": "sco-alert-all"
       }
      ]
     ]
    }
   }
  }
 },
 "tabs": [
  {
   "title": "Pulse",
   "icon": "waveform.path.ecg",
   "grid": {
    "columns": 4,
    "rows": 14
   },
   "children": [
    {
     "type": "group",
     "id": "sco-health",
     "position": [
      0,
      0
     ],
     "span": [
      1,
      4
     ],
     "hideBackground": true,
     "grid": {
      "columns": 4,
      "rows": 1
     },
     "children": [
      {
       "type": "statusLight",
       "id": "sco-h-signals",
       "position": [
        0,
        0
       ],
       "label": "Signals",
       "style": "badge",
       "size": "small",
       "pulse": true,
       "defaultValue": "nominal",
       "statusColors": {
        "nominal": "#B8F35A",
        "degraded": "#FF9F1C",
        "critical": "#FF3864",
        "offline": "#5B6477"
       },
       "theme": {
        "controlPadding": 3,
        "labelFontSize": 10
       },
       "sync": [
        {
         "method": "meshsocket",
         "type": "listen",
         "event": "broadcast",
         "filter": {
          "msg_type": "smart_city_ops_health"
         },
         "valuePath": "signals"
        }
       ]
      },
      {
       "type": "statusLight",
       "id": "sco-h-transit",
       "position": [
        0,
        1
       ],
       "label": "Transit",
       "style": "badge",
       "size": "small",
       "pulse": true,
       "defaultValue": "degraded",
       "statusColors": {
        "nominal": "#B8F35A",
        "degraded": "#FF9F1C",
        "critical": "#FF3864",
        "offline": "#5B6477"
       },
       "theme": {
        "controlPadding": 3,
        "labelFontSize": 10
       },
       "sync": [
        {
         "method": "meshsocket",
         "type": "listen",
         "event": "broadcast",
         "filter": {
          "msg_type": "smart_city_ops_health"
         },
         "valuePath": "transit"
        }
       ]
      },
      {
       "type": "statusLight",
       "id": "sco-h-grid",
       "position": [
        0,
        2
       ],
       "label": "Grid",
       "style": "badge",
       "size": "small",
       "pulse": true,
       "defaultValue": "nominal",
       "statusColors": {
        "nominal": "#B8F35A",
        "degraded": "#FF9F1C",
        "critical": "#FF3864",
        "offline": "#5B6477"
       },
       "theme": {
        "controlPadding": 3,
        "labelFontSize": 10
       },
       "sync": [
        {
         "method": "meshsocket",
         "type": "listen",
         "event": "broadcast",
         "filter": {
          "msg_type": "smart_city_ops_health"
         },
         "valuePath": "grid"
        }
       ]
      },
      {
       "type": "statusLight",
       "id": "sco-h-cad",
       "position": [
        0,
        3
       ],
       "label": "911 CAD",
       "style": "badge",
       "size": "small",
       "pulse": true,
       "defaultValue": "nominal",
       "statusColors": {
        "nominal": "#B8F35A",
        "degraded": "#FF9F1C",
        "critical": "#FF3864",
        "offline": "#5B6477"
       },
       "theme": {
        "controlPadding": 3,
        "labelFontSize": 10
       },
       "sync": [
        {
         "method": "meshsocket",
         "type": "listen",
         "event": "broadcast",
         "filter": {
          "msg_type": "smart_city_ops_health"
         },
         "valuePath": "cad"
        }
       ]
      }
     ]
    },
    {
     "type": "gauge",
     "id": "sco-congestion",
     "position": [
      1,
      0
     ],
     "span": [
      3,
      2
     ],
     "label": "Congestion Index",
     "icon": "car.2.fill",
     "min": 0,
     "max": 100,
     "gaugeStyle": "full",
     "arcAngle": 260,
     "arcRotation": 140,
     "tint": "#FF9F1C",
     "colorBlend": 0.35,
     "animation": "bouncy",
     "segments": [
      {
       "limit": 40,
       "color": "#2EE6D6"
      },
      {
       "limit": 70,
       "color": "#FF9F1C"
      },
      {
       "limit": 100,
       "color": "#FF3864"
      }
     ],
     "defaultValue": 67,
     "sync": [
      {
       "method": "meshsocket",
       "type": "listen",
       "event": "broadcast",
       "filter": {
        "msg_type": "smart_city_ops_pulse"
       },
       "valuePath": "congestion_index"
      }
     ]
    },
    {
     "type": "progressRing",
     "id": "sco-ontime",
     "position": [
      1,
      2
     ],
     "span": [
      3,
      2
     ],
     "label": "Transit On-Time",
     "icon": "tram.fill",
     "min": 0,
     "max": 100,
     "tint": "#2EE6D6",
     "animation": "smooth",
     "defaultValue": 88,
     "sync": [
      {
       "method": "meshsocket",
       "type": "listen",
       "event": "broadcast",
       "filter": {
        "msg_type": "smart_city_ops_pulse"
       },
       "valuePath": "ontime_pct"
      }
     ]
    },
    {
     "type": "sparkline",
     "id": "sco-aqi",
     "position": [
      4,
      0
     ],
     "span": [
      2,
      2
     ],
     "label": "AQI · PM2.5",
     "tint": "#B8F35A",
     "sparklineFill": true,
     "sparklinePoints": 48,
     "sync": [
      {
       "method": "http",
       "source": "cityapi",
       "path": "/environment/aqi/latest",
       "interval": 60,
       "valuePath": "pm25"
      }
     ]
    },
    {
     "type": "sparkline",
     "id": "sco-speed",
     "position": [
      4,
      2
     ],
     "span": [
      2,
      2
     ],
     "label": "Arterial mph",
     "tint": "#5AB8FF",
     "sparklineFill": true,
     "sparklinePoints": 60,
     "sync": [
      {
       "method": "meshsocket",
       "type": "listen",
       "event": "broadcast",
       "filter": {
        "msg_type": "smart_city_ops_pulse"
       },
       "valuePath": "arterial_mph"
      }
     ]
    },
    {
     "type": "heatmap",
     "id": "sco-traffic-heat",
     "position": [
      6,
      0
     ],
     "span": [
      4,
      4
     ],
     "label": "Traffic density · district × hour",
     "formatValue": "suffix:%",
     "heatmapConfig": {
      "colors": [
       "#0F1B2D",
       "#1F6F78",
       "#2EE6D6",
       "#FF9F1C",
       "#FF3864"
      ],
      "vMin": 0,
      "vMax": 100,
      "showScale": true,
      "cellCorner": 4,
      "cellGap": 3,
      "cellAction": {
       "method": "meshsocket",
       "mode": "broadcast",
       "event": "broadcast_request",
       "payload": {
        "msg_type": "smart_city_ops_inspect_cell",
        "cell": "{{value}}"
       }
      }
     },
     "defaultValue": "{\"rows\":[\"Harbor\",\"Old Town\",\"Midtown\",\"Uptown\",\"Ironworks\",\"Airport\"],\"cols\":[\"06\",\"09\",\"12\",\"15\",\"18\",\"21\"],\"values\":[[22,71,48,55,88,34],[18,64,72,69,91,52],[25,83,77,74,96,61],[14,58,41,47,79,38],[31,76,52,60,84,27],[40,62,55,58,73,66]]}",
     "sync": [
      {
       "method": "meshsocket",
       "type": "listen",
       "event": "broadcast",
       "filter": {
        "msg_type": "smart_city_ops_traffic"
       },
       "valuePath": "heatmap"
      }
     ]
    },
    {
     "type": "toggle",
     "id": "sco-surge",
     "position": [
      10,
      0
     ],
     "span": [
      1,
      2
     ],
     "label": "Surge Protocol",
     "icon": "exclamationmark.triangle.fill",
     "tint": "#FF3864",
     "haptic": "warning",
     "defaultValue": false,
     "sync": [
      {
       "method": "meshsocket",
       "type": "listen",
       "event": "broadcast",
       "filter": {
        "msg_type": "smart_city_ops_pulse"
       },
       "valuePath": "surge"
      }
     ],
     "action": {
      "method": "meshsocket",
      "mode": "broadcast",
      "event": "broadcast_request",
      "payload": {
       "msg_type": "smart_city_ops_set_surge",
       "on": "{{value}}"
      }
     }
    },
    {
     "type": "segmentedControl",
     "id": "sco-signal-plan",
     "position": [
      10,
      2
     ],
     "span": [
      1,
      2
     ],
     "style": "pills",
     "options": [
      "am",
      "pm",
      "event",
      "night"
     ],
     "optionLabels": [
      "AM",
      "PM",
      "Evt",
      "Nite"
     ],
     "defaultValue": "pm",
     "haptic": "selection",
     "sync": [
      {
       "method": "meshsocket",
       "type": "listen",
       "event": "broadcast",
       "filter": {
        "msg_type": "smart_city_ops_pulse"
       },
       "valuePath": "signal_plan"
      }
     ],
     "action": {
      "method": "meshsocket",
      "mode": "broadcast",
      "event": "broadcast_request",
      "payload": {
       "msg_type": "smart_city_ops_set_signal_plan",
       "plan": "{{value}}"
      }
     }
    },
    {
     "type": "group",
     "id": "sco-surge-panel",
     "label": "Surge Protocol · Arterial Override",
     "position": [
      11,
      0
     ],
     "span": [
      3,
      4
     ],
     "visible": {
      "when": "sco-surge",
      "operator": "eq",
      "value": true
     },
     "pulse": {
      "event": "broadcast",
      "color": "#FF3864",
      "direction": "outward",
      "filter": {
       "msg_type": "smart_city_ops_surge_ack"
      }
     },
     "grid": {
      "columns": 4,
      "rows": 2
     },
     "children": [
      {
       "type": "slider",
       "id": "sco-green-bias",
       "position": [
        0,
        0
       ],
       "span": [
        1,
        4
       ],
       "label": "Outbound green bias · s",
       "min": 0,
       "max": 40,
       "step": 5,
       "defaultValue": 15,
       "formatValue": "decimal",
       "tint": "#FF9F1C",
       "sync": [
        {
         "method": "meshsocket",
         "type": "listen",
         "event": "broadcast",
         "filter": {
          "msg_type": "smart_city_ops_pulse"
         },
         "valuePath": "green_bias_s"
        }
       ],
       "action": {
        "method": "meshsocket",
        "mode": "broadcast",
        "event": "broadcast_request",
        "payload": {
         "msg_type": "smart_city_ops_set_green_bias",
         "seconds": "{{value}}"
        }
       }
      },
      {
       "type": "button",
       "id": "sco-contraflow",
       "position": [
        1,
        0
       ],
       "span": [
        1,
        2
       ],
       "label": "Contraflow I-705",
       "icon": "arrow.left.arrow.right",
       "style": "tinted",
       "tint": "#FF9F1C",
       "haptic": "heavy",
       "action": {
        "method": "meshsocket",
        "mode": "broadcast",
        "event": "broadcast_request",
        "payload": {
         "msg_type": "smart_city_ops_contraflow",
         "corridor": "I-705",
         "enable": true
        }
       }
      },
      {
       "type": "button",
       "id": "sco-vms",
       "position": [
