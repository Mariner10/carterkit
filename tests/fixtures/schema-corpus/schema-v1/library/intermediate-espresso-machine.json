{
  "name": "Espresso Machine",
  "headerTitle": "Linea Mini",
  "id": "espresso-machine",
  "version": 1,
  "accentColor": "#C8813A",
  "description": "A dual-tab espresso bar: live boiler temperature, brew-pressure trace and shot timer beside a recipe card of dose/yield steppers, plus a shot-history chart and brew log. Readouts listen for espresso_machine_* broadcasts; every input sends one carrying {{value}}.",
  "difficulty": "intermediate",
  "theme": {
    "accentColor": "#C8813A",
    "cornerRadius": 14,
    "fontDesign": "rounded",
    "dark": {
      "pageBackgroundGradient": ["#140D09", "#24170F"],
      "surfacePrimary": "#FFF3E614",
      "surfaceSecondary": "#FFF3E60A",
      "foregroundColor": "#FBEFE3",
      "borderColor": "#FFE2C21F"
    },
    "light": {
      "pageBackgroundGradient": ["#F7EFE6", "#EBDCCB"],
      "surfacePrimary": "#FFFFFFE6",
      "surfaceSecondary": "#FFF8F0",
      "foregroundColor": "#2B1A10",
      "borderColor": "#2B1A1018"
    },
    "stepper": { "buttonColor": "#C8813A", "iconColor": "#FFFFFF" }
  },
  "tabs": [
    {
      "title": "Brew",
      "icon": "cup.and.saucer.fill",
      "grid": { "columns": 4, "rows": 11 },
      "children": [
        {
          "type": "statusLight",
          "id": "espresso-machine-state",
          "position": [0, 0],
          "span": [1, 2],
          "label": "Machine",
          "style": "badge",
          "defaultValue": "ready",
          "statusColors": { "heating": "#FF9F0A", "ready": "#34C759", "brewing": "#0A84FF", "fault": "#FF3B30" },
          "sync": [{ "method": "meshsocket", "type": "listen", "event": "broadcast", "filter": { "msg_type": "espresso_machine_status" }, "valuePath": "state" }]
        },
        {
          "type": "statusLight",
          "id": "espresso-machine-water",
          "position": [0, 2],
          "span": [1, 2],
          "label": "Reservoir",
          "style": "badge",
          "defaultValue": "ok",
          "statusColors": { "ok": "#34C759", "low": "#FF9F0A", "empty": "#FF3B30" },
          "sync": [{ "method": "meshsocket", "type": "listen", "event": "broadcast", "filter": { "msg_type": "espresso_machine_status" }, "valuePath": "water" }]
        },
        {
          "type": "gauge",
          "id": "espresso-machine-boiler",
          "position": [1, 0],
          "span": [3, 2],
          "label": "Brew Boiler °C",
          "icon": "thermometer.high",
          "min": 80,
          "max": 100,
          "step": 0.1,
          "gaugeStyle": "half",
          "defaultValue": 93.4,
          "segments": [
            { "limit": 90, "color": "#0A84FF" },
            { "limit": 95, "color": "#34C759" },
            { "limit": 100, "color": "#FF453A" }
          ],
          "colorBlend": 0.3,
          "sync": [{ "method": "meshsocket", "type": "listen", "event": "broadcast", "filter": { "msg_type": "espresso_machine_telemetry" }, "valuePath": "boiler_c" }]
        },
        {
          "type": "label",
          "id": "espresso-machine-timer",
          "position": [1, 2],
          "span": [2, 2],
          "label": "Shot Timer (s)",
          "icon": "stopwatch",
          "style": "large-mono",
          "align": "center",
          "formatValue": "decimal:1",
          "defaultValue": 27.6,
          "sync": [{ "method": "meshsocket", "type": "listen", "event": "broadcast", "filter": { "msg_type": "espresso_machine_shot" }, "valuePath": "elapsed_s" }]
        },
        {
          "type": "label",
          "id": "espresso-machine-ratio",
          "position": [3, 2],
          "span": [1, 2],
          "label": "Ratio",
          "icon": "scalemass",
          "style": "mono",
          "align": "center",
          "defaultValue": "1 : 2.1",
          "sync": [{ "method": "meshsocket", "type": "listen", "event": "broadcast", "filter": { "msg_type": "espresso_machine_shot" }, "valuePath": "ratio" }]
        },
        {
          "type": "sparkline",
          "id": "espresso-machine-pressure",
          "position": [4, 0],
          "span": [2, 4],
          "label": "Brew Pressure (bar)",
          "tint": "#C8813A",
          "sparklineFill": true,
          "sparklinePoints": 120,
          "sync": [{ "method": "meshsocket", "type": "listen", "event": "broadcast", "filter": { "msg_type": "espresso_machine_telemetry" }, "valuePath": "pressure_bar" }]
        },
        {
          "type": "group",
          "id": "espresso-machine-recipe",
          "label": "Recipe",
          "position": [6, 0],
          "span": [4, 4],
          "grid": { "columns": 4, "rows": 3 },
          "children": [
            {
              "type": "picker",
              "id": "espresso-machine-recipe-pick",
              "position": [0, 0],
              "span": [1, 4],
              "label": "Profile",
              "options": ["classic", "ristretto", "lungo", "turbo", "decaf"],
              "optionLabels": ["Classic 1:2", "Ristretto 1:1.5", "Lungo 1:3", "Turbo Shot", "Swiss Water Decaf"],
              "defaultValue": "classic",
              "action": { "method": "meshsocket", "mode": "broadcast", "event": "broadcast_request", "payload": { "msg_type": "espresso_machine_set_recipe", "recipe": "{{value}}" } }
            },
            {
              "type": "stepper",
              "id": "espresso-machine-dose",
              "position": [1, 0],
              "span": [1, 2],
              "label": "Dose g",
              "icon": "circle.grid.cross",
              "min": 14,
              "max": 22,
              "step": 0.5,
              "defaultValue": 18,
              "repeatOnHold": true,
              "action": { "method": "meshsocket", "mode": "broadcast", "event": "broadcast_request", "payload": { "msg_type": "espresso_machine_set_dose", "dose_g": "{{value}}" } }
            },
            {
              "type": "stepper",
              "id": "espresso-machine-yield",
              "position": [1, 2],
              "span": [1, 2],
              "label": "Yield g",
              "icon": "drop.fill",
              "min": 20,
              "max": 60,
              "step": 1,
              "defaultValue": 38,
              "repeatOnHold": true,
              "action": { "method": "meshsocket", "mode": "broadcast", "event": "broadcast_request", "payload": { "msg_type": "espresso_machine_set_yield", "yield_g": "{{value}}" } }
            },
            {
              "type": "stepper",
              "id": "espresso-machine-target-temp",
              "position": [2, 0],
              "span": [1, 4],
              "label": "Target Temp °C",
              "icon": "flame",
              "min": 88,
              "max": 96,
              "step": 0.5,
              "defaultValue": 93.5,
              "action": { "method": "meshsocket", "mode": "broadcast", "event": "broadcast_request", "payload": { "msg_type": "espresso_machine_set_temp", "target_c": "{{value}}" } }
            }
          ]
        },
        {
          "type": "button",
          "id": "espresso-machine-brew",
          "position": [10, 0],
          "span": [1, 3],
          "label": "Pull Shot",
          "icon": "play.fill",
          "size": "large",
          "tint": "#C8813A",
          "haptic": "heavy",
          "action": { "method": "meshsocket", "mode": "broadcast", "event": "broadcast_request", "payload": { "msg_type": "espresso_machine_brew", "command": "start" } }
        },
        {
          "type": "button",
          "id": "espresso-machine-flush",
          "position": [10, 3],
          "span": [1, 1],
          "label": "Flush",
          "icon": "drop.triangle",
          "style": "tinted",
          "hideLabel": true,
          "action": { "method": "meshsocket", "mode": "broadcast", "event": "broadcast_request", "payload": { "msg_type": "espresso_machine_flush", "seconds": 3 } }
        }
      ]
    },
    {
      "title": "Shots",
      "icon": "chart.bar.xaxis",
      "grid": { "columns": 4, "rows": 9 },
      "children": [
        {
          "type": "segmentedControl",
          "id": "espresso-machine-history-range",
          "position": [0, 0],
          "span": [1, 4],
          "options": ["today", "week", "month"],
          "optionLabels": ["Today", "Week", "Month"],
          "defaultValue": "today",
          "action": { "method": "meshsocket", "mode": "broadcast", "event": "broadcast_request", "payload": { "msg_type": "espresso_machine_history_range", "range": "{{value}}" } }
        },
        {
          "type": "chart",
          "id": "espresso-machine-history",
          "position": [1, 0],
          "span": [4, 4],
          "label": "Shot Time vs Yield",
          "tint": "#C8813A",
          "chartConfig": { "showLegend": true, "smooth": true, "barCornerRadius": 4 },
          "defaultValue": {
            "categories": ["7:02", "7:31", "9:15", "11:48", "13:20", "15:05"],
            "series": [
              { "name": "Time s", "type": "bar", "color": "#C8813A", "values": [27.6, 29.1, 24.8, 31.2, 28.0, 26.4] },
              { "name": "Yield g", "type": "line", "color": "#5AC8FA", "values": [38, 37, 36, 40, 38, 37] }
            ]
          },
          "sync": [{ "method": "meshsocket", "type": "listen", "event": "broadcast", "filter": { "msg_type": "espresso_machine_history" }, "valuePath": "chart" }]
        },
        {
          "type": "logConsole",
          "id": "espresso-machine-log",
          "position": [5, 0],
          "span": [4, 4],
          "label": "Brew Log",
          "controlHeight": 170,
          "maxLines": 300,
          "logColors": { "error": "#FF453A", "warn": "#FF9F0A", "info": "#C8813A" },
          "sync": [{ "method": "meshsocket", "type": "listen", "event": "broadcast", "filter": { "msg_type": "espresso_machine_log" }, "valuePath": "entry" }]
        }
      ]
    }
  ]
}
