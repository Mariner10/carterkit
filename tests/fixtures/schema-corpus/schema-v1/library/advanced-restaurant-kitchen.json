{
  "name": "Restaurant Kitchen Display",
  "headerTitle": "LINE · KDS",
  "version": 1,
  "accentColor": "#FF8A3D",
  "description": "An expo-and-line kitchen display: a live ticket rail with a bell that jumps on every new order, per-station timers, oven and HACCP temperatures, and a one-tap 86 list that pushes to front of house.",
  "difficulty": "advanced",
  "keepAwake": true,
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light"
  },
  "state": {
    "sync": true,
    "authority": "restaurant_kitchen_hub"
  },
  "theme": {
    "accentColor": "#FF8A3D",
    "accentGradient": [
      "#FF6B2C",
      "#FFB020"
    ],
    "fontDesign": "rounded",
    "labelFontSize": 12,
    "valueFontSize": 15,
    "valueFontWeight": "bold",
    "cornerRadius": 14,
    "cardPadding": 12,
    "borderWidth": 0.5,
    "tabBarTint": "#FF8A3D",
    "pageBackgroundGradient": [
      "#140C08",
      "#1E120B",
      "#2A170D"
    ],
    "surfacePrimary": "#FFE3CC14",
    "surfaceSecondary": "#FFE3CC0B",
    "surfaceTertiary": "#FFE3CC06",
    "borderColor": "#FFB0702E",
    "foregroundColor": "#FFF4EA",
    "secondaryColor": "#D2B49C",
    "tertiaryColor": "#8A6E5A",
    "toggle": {
      "trackActiveColor": "#FF6B2C"
    },
    "slider": {
      "trackActiveColor": "#FF8A3D",
      "thumbColor": "#FFF4EA"
    },
    "segmented": {
      "selectedColor": "#FF8A3D",
      "selectedTextColor": "#140C08"
    }
  },
  "tabs": [
    {
      "title": "Pass",
      "icon": "bell.and.waves.left.and.right.fill",
      "grid": {
        "columns": 4,
        "rows": 10
      },
      "children": [
        {
          "type": "symbol",
          "id": "order-bell",
          "position": [
            0,
            0
          ],
          "span": [
            3,
            2
          ],
          "systemName": "bell.fill",
          "label": "Order bell",
          "tint": "#FF8A3D",
          "defaultValue": true,
          "haptic": "heavy",
          "symbolConfig": {
            "renderingMode": "palette",
            "palette": [
              "#FF8A3D",
              "#FFD9A8"
            ],
            "weight": "semibold",
            "variant": "none",
            "effect": "wiggle",
            "effectOptions": [
              "byLayer"
            ],
            "loop": "periodic",
            "loopDelay": 4,
            "activeWhen": "truthy",
            "tapEffect": "bounce",
            "triggers": [
              {
                "event": "broadcast",
                "filter": {
                  "msg_type": "restaurant_kitchen_new_ticket"
                },
                "effect": "bounce",
                "effectOptions": [
                  "up",
                  "byLayer"
                ]
              },
              {
                "event": "broadcast",
                "filter": {
                  "msg_type": "restaurant_kitchen_rush"
                },
                "effect": "variableColor"
              }
            ]
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "restaurant_kitchen_pass"
              },
              "valuePath": "tickets_waiting"
            }
          ],
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "restaurant_kitchen_bell_ack",
              "by": "expo",
              "bell": "{{value}}"
            }
          }
        },
        {
          "type": "label",
          "id": "open-tickets",
