          "span": [
            6,
            4
          ],
          "label": "Ticket rail",
          "defaultValue": "{\"nodes\": [{\"id\": \"t412\", \"label\": \"#412 · T12 · 2× Ribeye MR, Halibut, Caesar · 11:42\", \"group\": \"firing\", \"icon\": \"flame.fill\"}, {\"id\": \"t413\", \"label\": \"#413 · T4 · Duck confit, Risotto (no shallot) · 09:10\", \"group\": \"firing\", \"icon\": \"flame.fill\"}, {\"id\": \"t414\", \"label\": \"#414 · Bar 3 · Fries, Wings hot · 06:05\", \"group\": \"firing\", \"icon\": \"flame.fill\"}, {\"id\": \"t415\", \"label\": \"#415 · T9 · 4-top · Burrata ×2, Tartare ×2 · 03:30\", \"group\": \"apps\", \"icon\": \"leaf.fill\"}, {\"id\": \"t416\", \"label\": \"#416 · T21 · Oysters dz, Crudo · ALLERGY shellfish-sep · 01:12\", \"group\": \"apps\", \"icon\": \"exclamationmark.triangle.fill\"}, {\"id\": \"t410\", \"label\": \"#410 · T7 · Short rib, Hanger MR · on the pass\", \"group\": \"pass\", \"icon\": \"bell.fill\"}, {\"id\": \"t409\", \"label\": \"#409 · T2 · Key lime ×2, Affogato · on the pass\", \"group\": \"pass\", \"icon\": \"birthday.cake.fill\"}, {\"id\": \"t417\", \"label\": \"#417 · T15 · Hold for mains · fire on call\", \"group\": \"on hold\", \"icon\": \"pause.circle.fill\"}]}",
