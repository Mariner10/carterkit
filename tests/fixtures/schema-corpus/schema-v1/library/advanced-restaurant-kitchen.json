          "span": [
            1,
            2
          ],
          "label": "Fire next course",
          "icon": "flame.fill",
          "style": "filled",
          "tint": "#FF6B2C",
          "haptic": "heavy",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "restaurant_kitchen_fire",
              "ticket": "next",
              "by": "expo"
            }
          }
        },
        {
          "type": "button",
          "id": "call-runner",
