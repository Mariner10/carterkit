      ]
    },
    {
      "title": "Log",
      "icon": "terminal.fill",
      "grid": {
        "columns": 4,
        "rows": 2,
        "mode": "flow"
      },
      "children": [
        {
          "type": "label",
          "id": "dgs-log-hdr",
          "position": [
            0,
            0
          ],
          "span": [
            1,
            4
          ],
          "label": "MAVLink",
          "text": "HX-4 \u00b7 sysid 1 \u00b7 57600 baud",
          "icon": "terminal",
          "style": "mono",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "drone_ground_station_status"
              },
              "valuePath": "link_text"
