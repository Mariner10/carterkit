              }
            },
            {
              "type": "button",
              "id": "dgs-start",
              "position": [
                1,
                2
              ],
              "span": [
                1,
                2
              ],
              "label": "Start",
              "icon": "play.fill",
              "tint": "#30D158",
              "haptic": "success",
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "drone_ground_station_mission_start",
                  "plan": "survey_b"
                }
              },
              "visible": {
                "when": "dgs-arm",
                "operator": "eq",
                "value": true
              }
            }
          ],
          "label": "Mission \u00b7 Survey grid B"
