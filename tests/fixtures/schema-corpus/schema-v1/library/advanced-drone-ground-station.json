              "defaultValue": "weak",
              "pulse": true,
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "drone_ground_station_link"
                  },
                  "valuePath": "video"
                }
              ]
            },
            {
              "type": "statusLight",
              "id": "dgs-geofence",
              "position": [
                0,
                2
              ],
              "span": [
                1,
                1
