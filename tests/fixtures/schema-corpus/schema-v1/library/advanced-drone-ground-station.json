          "tint": "#30D158",
          "align": "center",
          "visible": {
            "when": "dgs-arm",
            "operator": "eq",
            "value": false
          }
        },
        {
          "type": "group",
          "id": "dgs-mission",
          "position": [
            7,
            0
          ],
          "span": [
            3,
            4
          ],
          "grid": {
            "columns": 4,
            "rows": 2
          },
          "children": [
            {
              "type": "slider",
              "id": "dgs-cruise",
