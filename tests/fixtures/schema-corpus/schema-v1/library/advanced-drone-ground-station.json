{
  "name": "Drone Ground Station",
  "headerTitle": "HX-4 \u00b7 GROUND",
  "version": 1,
  "accentColor": "#00E5FF",
  "description": "A field ground station for a survey quadcopter: live flight path over satellite, heading ring, altitude/battery dials, telemetry trends, and arm-gated flight commands.",
  "difficulty": "advanced",
  "keepAwake": true,
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light"
  },
  "theme": {
    "accentColor": "#00E5FF",
    "accentGradient": [
      "#00E5FF",
      "#0A84FF"
    ],
    "fontDesign": "monospaced",
    "cornerRadius": 10,
    "cardPadding": 12,
    "borderWidth": 0.5,
    "labelFontSize": 11,
    "valueFontSize": 14,
    "valueFontWeight": "semibold",
    "tabBarTint": "#00E5FF",
    "pageBackgroundGradient": [
      "#03070C",
      "#081421",
      "#0C1E2E"
    ],
    "surfacePrimary": "#7FDBFF12",
    "surfaceSecondary": "#7FDBFF0A",
    "surfaceTertiary": "#7FDBFF06",
    "borderColor": "#7FDBFF2E",
    "foregroundColor": "#E6F7FF",
    "secondaryColor": "#8FB8CC",
    "tertiaryColor": "#557A8C",
    "toggle": {
      "trackActiveColor": "#FF453A"
    },
    "slider": {
      "trackActiveColor": "#00E5FF",
      "thumbColor": "#E6F7FF"
    }
  },
  "publishers": [
    {
      "sensor": "location",
      "interval": 3
    }
  ],
  "tabs": [
    {
      "title": "Flight",
      "icon": "map.fill",
      "grid": {
        "columns": 4,
        "rows": 12
      },
      "children": [
        {
          "type": "map",
          "id": "dgs-map",
          "position": [
            0,
            0
          ],
          "span": [
            6,
            4
          ],
          "label": "Flight path \u00b7 Marymoor Field",
          "mapStyle": "hybrid",
          "mapZoom": 0.008,
          "tint": "#00E5FF",
          "mapConfig": {
            "recenter": "auto"
          },
          "defaultValue": "{\"markers\": [{\"coordinate\": [47.6421, -122.1376], \"color\": \"#34C759\", \"size\": 14, \"label\": \"Home\"}, {\"coordinate\": [47.6433, -122.1359], \"color\": \"#FFD60A\", \"size\": 10, \"label\": \"WP1\"}, {\"coordinate\": [47.6447, -122.1362], \"color\": \"#FFD60A\", \"size\": 10, \"label\": \"WP2\"}, {\"coordinate\": [47.6452, -122.1384], \"color\": \"#FFD60A\", \"size\": 10, \"label\": \"WP3\"}, {\"coordinate\": [47.6444, -122.1373], \"color\": \"#00E5FF\", \"size\": 18, \"label\": \"HX-4 \\u00b7 62 m\", \"ripple\": {\"color\": \"#00E5FF\", \"period\": 1.6, \"radius\": 40}}], \"paths\": [{\"points\": [[47.6421, -122.1376], [47.6433, -122.1359], [47.6447, -122.1362], [47.6452, -122.1384], [47.644, -122.1401], [47.6426, -122.1395]], \"color\": \"#FFD60A80\"}, {\"points\": [[47.6421, -122.1376], [47.6433, -122.1359], [47.6447, -122.1362], [47.6444, -122.1373]], \"color\": \"#00E5FF\"}]}",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "drone_ground_station_position"
              },
              "valuePath": "map"
            }
          ]
        },
        {
          "type": "compass",
          "id": "dgs-compass",
          "position": [
            6,
            0
          ],
          "span": [
            4,
            2
          ],
          "label": "Heading \u00b7 point to yaw",
          "defaultValue": 38,
          "compassConfig": {
            "tolerance": 12,
            "dwell": 1.5,
            "editable": false,
            "pucks": [
              {
                "id": "wp1",
                "label": "WP1",
                "icon": "1.circle.fill",
                "tint": "#FFD60A",
                "bearing": 45,
                "locked": true,
                "action": {
                  "method": "meshsocket",
                  "mode": "broadcast",
                  "event": "broadcast_request",
                  "payload": {
                    "msg_type": "drone_ground_station_yaw_to",
                    "target": "{{value}}"
                  }
                }
              },
              {
                "id": "wp3",
                "label": "WP3",
                "icon": "3.circle.fill",
                "tint": "#FFD60A",
                "bearing": 320,
                "locked": true,
                "action": {
                  "method": "meshsocket",
                  "mode": "broadcast",
                  "event": "broadcast_request",
                  "payload": {
                    "msg_type": "drone_ground_station_yaw_to",
                    "target": "{{value}}"
                  }
                }
              },
              {
                "id": "home",
                "label": "Home",
                "icon": "house.fill",
                "tint": "#34C759",
                "bearing": 200,
                "locked": true,
                "action": {
                  "method": "meshsocket",
                  "mode": "broadcast",
                  "event": "broadcast_request",
                  "payload": {
                    "msg_type": "drone_ground_station_yaw_to",
                    "target": "{{value}}"
                  }
                }
              }
            ]
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "drone_ground_station_attitude"
              },
              "valuePath": "heading_deg"
            }
          ]
        },
        {
          "type": "gauge",
          "id": "dgs-alt",
          "position": [
            6,
            2
          ],
          "span": [
            2,
            2
          ],
          "label": "Altitude AGL",
          "icon": "arrow.up.to.line",
          "min": 0,
          "max": 120,
          "step": 0.1,
          "formatValue": "suffix: m",
          "segments": [
            {
              "limit": 100,
              "color": "#00E5FF"
            },
            {
              "limit": 120,
              "color": "#FF9F0A"
            }
          ],
          "colorBlend": 0.3,
          "defaultValue": 62.4,
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "drone_ground_station_telemetry"
              },
              "valuePath": "alt_agl"
            }
          ]
        },
        {
          "type": "gauge",
          "id": "dgs-batt",
          "position": [
            8,
            2
          ],
          "span": [
            2,
            2
          ],
          "label": "Battery",
          "icon": "battery.75percent",
          "min": 0,
          "max": 100,
          "formatValue": "suffix:%",
          "segments": [
            {
              "limit": 20,
              "color": "#FF453A"
            },
            {
              "limit": 35,
              "color": "#FF9F0A"
            },
            {
              "limit": 100,
              "color": "#30D158"
            }
          ],
          "defaultValue": 71,
