                  "msg_type": "drone_ground_station_set_speed",
                  "mps": "{{value}}"
                }
              }
            },
            {
              "type": "button",
              "id": "dgs-upload",
              "position": [
                1,
                0
              ],
              "span": [
                1,
                2
              ],
              "label": "Upload",
