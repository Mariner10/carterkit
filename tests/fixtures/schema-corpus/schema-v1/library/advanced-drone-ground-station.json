            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "drone_ground_station_telemetry"
              },
              "valuePath": "battery_pct"
            }
          ]
        },
        {
          "type": "group",
          "id": "dgs-link",
          "position": [
            10,
            0
          ],
          "span": [
            2,
            4
          ],
          "grid": {
            "columns": 3,
            "rows": 1
          },
          "children": [
            {
              "type": "statusLight",
              "id": "dgs-rc",
              "position": [
                0,
                0
