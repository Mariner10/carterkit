          ]
        },
        {
          "type": "logConsole",
          "id": "dgs-log",
          "position": [
            1,
            0
          ],
          "span": [
            1,
            4
          ],
          "label": "Flight log",
          "maxLines": 400,
          "fontSize": 11,
          "controlHeight": 520,
          "logColors": {
            "error": "#FF453A",
            "warn": "#FF9F0A",
            "info": "#30D158",
            "debug": "#8E8E93"
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "drone_ground_station_log"
              },
              "valuePath": "line"
            }
          ]
        }
      ]
    }
  ]
