{
  "name": "Pomodoro Lite",
  "headerTitle": "Pomodoro Lite",
  "id": "pomodoro-lite",
  "version": 1,
  "accentColor": "#FF6B5A",
  "description": "A one-screen focus timer: pick Focus or Break, then start, pause, or reset the session while a ring fills with progress.",
  "difficulty": "beginner",
  "tabs": [
    {
      "title": "Timer",
      "icon": "timer",
      "grid": {
        "columns": 3,
        "rows": 8
      },
      "children": [
        {
          "type": "segmentedControl",
          "id": "session-mode",
          "position": [
            0,
            0
          ],
          "span": [
            1,
            3
          ],
          "options": [
            "focus",
            "break"
          ],
          "optionLabels": [
            "Focus 25m",
            "Break 5m"
          ],
          "optionIcons": [
            "brain.head.profile",
            "cup.and.saucer.fill"
          ],
          "defaultValue": "focus",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "pomodoro_lite_mode",
              "mode": "{{value}}"
            }
          }
        },
        {
          "type": "progressRing",
          "id": "session-progress",
          "position": [
            1,
            0
          ],
          "span": [
            3,
            3
          ],
          "min": 0,
          "max": 100,
          "progressStyle": "ring",
          "tint": "#FF6B5A",
          "label": "Session 2 of 4",
          "icon": "flame.fill",
          "defaultValue": 62,
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "pomodoro_lite_tick"
              },
              "valuePath": "percent"
            }
          ]
        },
        {
          "type": "button",
          "id": "btn-start",
          "position": [
            4,
            0
          ],
          "label": "Start",
          "icon": "play.fill",
          "style": "filled",
          "tint": "#34C759",
          "haptic": "success",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "pomodoro_lite_cmd",
              "cmd": "start"
            }
          }
        },
        {
          "type": "button",
          "id": "btn-pause",
          "position": [
            4,
            1
          ],
          "label": "Pause",
          "icon": "pause.fill",
          "style": "tinted",
          "tint": "#FF9F0A",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "pomodoro_lite_cmd",
              "cmd": "pause"
            }
          }
        },
        {
          "type": "button",
          "id": "btn-reset",
          "position": [
            4,
            2
          ],
          "label": "Reset",
          "icon": "arrow.counterclockwise",
          "style": "outlined",
          "tint": "#8E8E93",
          "haptic": "warning",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "pomodoro_lite_cmd",
              "cmd": "reset"
            }
          }
        },
        {
          "type": "divider",
          "id": "about-divider",
          "position": [
            5,
            0
          ],
          "span": [
            1,
            3
          ]
        },
        {
          "type": "label",
          "id": "about",
          "position": [
            6,
            0
          ],
          "span": [
            2,
            3
          ],
          "icon": "lightbulb",
          "style": "caption",
          "text": "How it works: Focus/Break and the three buttons each send one message (pomodoro_lite_mode / pomodoro_lite_cmd). A single sync fills the ring from the percent field of pomodoro_lite_tick."
        }
      ]
    }
  ]
}