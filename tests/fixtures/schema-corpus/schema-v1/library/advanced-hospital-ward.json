{
  "name": "Hospital Ward Board",
  "headerTitle": "4 WEST · WARD BOARD",
  "version": 1,
  "accentColor": "#2EC4B6",
  "description": "A charge-nurse board for a 12-bed telemetry ward: live bed status lights, vitals trends and NEWS2 heatmap, an alarm log, and nurse-call acknowledgements.",
  "difficulty": "advanced",
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light"
  },
  "keepAwake": true,
  "state": {
    "sync": true,
    "authority": "hospital_ward_hub"
  },
  "theme": {
    "accentColor": "#2EC4B6",
    "accentGradient": [
      "#2EC4B6",
      "#7AE7C7"
    ],
    "fontDesign": "rounded",
    "labelFontSize": 12,
    "valueFontSize": 15,
    "valueFontWeight": "semibold",
    "cornerRadius": 16,
    "cardPadding": 12,
    "borderWidth": 0.5,
    "tabBarTint": "#2EC4B6",
    "pageBackgroundGradient": [
      "#061417",
      "#0A2126",
      "#0E2B30"
    ],
    "surfacePrimary": "#BFF5EC12",
    "surfaceSecondary": "#BFF5EC0A",
    "surfaceTertiary": "#BFF5EC06",
    "borderColor": "#7AE7C72E",
    "foregroundColor": "#EAFBF8",
    "secondaryColor": "#9CC7C0",
    "tertiaryColor": "#5E8580",
    "toggle": {
      "trackActiveColor": "#2EC4B6"
    }
  },
