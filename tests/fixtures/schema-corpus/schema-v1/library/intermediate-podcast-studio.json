{
  "name": "Podcast Studio",
  "headerTitle": "ON AIR · EP 112",
  "description": "Four-mic podcast booth: per-mic live toggles with level sparklines, record and chapter markers, plus a run-of-show rundown and producer log.",
  "difficulty": "intermediate",
  "version": 1,
  "accentColor": "#E8453C",
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light"
  },
  "theme": {
    "accentColor": "#E8453C",
    "cornerRadius": 14,
    "tabBarTint": "#E8453C",
    "pageBackgroundGradient": [
      "#0C0A0B",
      "#1A1012"
    ],
    "surfacePrimary": "#FFFFFF10",
    "surfaceSecondary": "#FFFFFF08",
    "borderColor": "#E8453C33",
    "foregroundColor": "#FBEFEF",
    "secondaryColor": "#C9A9A9",
    "toggle": {
      "trackActiveColor": "#E8453C"
    }
  },
  "tabs": [
    {
      "title": "Booth",
      "icon": "mic.circle.fill",
      "grid": {
        "columns": 4,
        "rows": 14
      },
      "children": [
        {
          "type": "button",
          "id": "ps-record",
          "position": [
            0,
            0
          ],
          "span": [
            1,
            2
          ],
          "label": "Record",
          "icon": "record.circle",
          "style": "filled",
          "tint": "#E8453C",
          "haptic": "heavy",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "podcast_studio_transport",
              "cmd": "toggle_record"
            }
          }
        },
        {
          "type": "button",
          "id": "ps-chapter",
          "position": [
            0,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "Drop Chapter",
          "icon": "bookmark.fill",
          "style": "tinted",
          "tint": "#FFB347",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "podcast_studio_chapter",
              "cmd": "mark"
            }
          }
        },
        {
          "type": "textInput",
          "id": "ps-chapter-title",
          "position": [
            1,
            0
          ],
          "span": [
            1,
            4
          ],
          "label": "Chapter title",
          "placeholder": "e.g. Listener mailbag",
          "icon": "text.badge.plus",
          "clearOnSubmit": true,
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "podcast_studio_chapter",
              "cmd": "rename_last",
              "title": "{{value}}"
            }
          }
        },
        {
          "type": "group",
          "id": "ps-grp-host",
          "label": "Host · Maya Okafor",
          "position": [
            2,
            0
          ],
          "span": [
            4,
            2
          ],
          "grid": {
            "columns": 2,
            "rows": 3
          },
          "children": [
            {
              "type": "toggle",
              "id": "ps-mic-host",
              "position": [
                0,
                0
              ],
              "span": [
                1,
                2
              ],
              "label": "Live",
              "style": "switch",
              "icon": "mic.fill",
              "tint": "#FF5A4E",
              "defaultValue": true,
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "podcast_studio_mic_live",
                  "mic": "host",
                  "live": "{{value}}"
                }
              }
            },
            {
              "type": "sparkline",
              "id": "ps-lvl-host",
              "position": [
                1,
                0
              ],
              "span": [
                2,
                2
              ],
              "label": "Level · dBFS",
              "tint": "#FF5A4E",
              "sparklineFill": true,
              "sparklinePoints": 60,
              "defaultValue": [
                -22,
                -19,
                -17,
                -21,
                -18,
                -16,
                -20,
                -18,
                -15,
                -19,
                -21,
                -17
              ],
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "podcast_studio_levels"
                  },
                  "valuePath": "host"
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "id": "ps-grp-cohost",
          "label": "Co-host · Dev Ramos",
          "position": [
            2,
            2
          ],
          "span": [
            4,
            2
          ],
          "grid": {
            "columns": 2,
            "rows": 3
          },
          "children": [
            {
              "type": "toggle",
              "id": "ps-mic-cohost",
              "position": [
                0,
                0
              ],
              "span": [
                1,
                2
              ],
              "label": "Live",
              "style": "switch",
              "icon": "mic.fill",
              "tint": "#FFB347",
              "defaultValue": true,
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "podcast_studio_mic_live",
                  "mic": "cohost",
                  "live": "{{value}}"
                }
              }
            },
            {
              "type": "sparkline",
              "id": "ps-lvl-cohost",
              "position": [
                1,
                0
              ],
              "span": [
                2,
                2
              ],
              "label": "Level · dBFS",
              "tint": "#FFB347",
              "sparklineFill": true,
              "sparklinePoints": 60,
              "defaultValue": [
                -24,
                -22,
                -25,
                -20,
                -23,
                -21,
                -19,
                -22,
                -24,
                -20,
                -22,
                -23
              ],
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "podcast_studio_levels"
                  },
                  "valuePath": "cohost"
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "id": "ps-grp-guest",
          "label": "Guest · Dr. Lena Ruiz",
          "position": [
            6,
            0
          ],
          "span": [
            4,
            2
          ],
          "grid": {
            "columns": 2,
            "rows": 3
          },
          "children": [
            {
              "type": "toggle",
              "id": "ps-mic-guest",
              "position": [
                0,
                0
              ],
              "span": [
                1,
                2
              ],
              "label": "Live",
              "style": "switch",
              "icon": "mic.fill",
              "tint": "#5AC8FA",
              "defaultValue": true,
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "podcast_studio_mic_live",
                  "mic": "guest",
                  "live": "{{value}}"
                }
              }
            },
            {
              "type": "sparkline",
              "id": "ps-lvl-guest",
              "position": [
                1,
                0
              ],
              "span": [
                2,
                2
              ],
              "label": "Level · dBFS",
              "tint": "#5AC8FA",
              "sparklineFill": true,
              "sparklinePoints": 60,
              "defaultValue": [
                -30,
                -26,
                -18,
                -17,
                -19,
                -16,
                -18,
                -21,
                -17,
                -20,
                -18,
                -19
              ],
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "podcast_studio_levels"
                  },
                  "valuePath": "guest"
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "id": "ps-grp-remote",
          "label": "Remote · Sam (Zoom)",
          "position": [
            6,
            2
          ],
          "span": [
            4,
            2
          ],
          "grid": {
            "columns": 2,
            "rows": 3
          },
          "children": [
            {
              "type": "toggle",
              "id": "ps-mic-remote",
              "position": [
                0,
                0
              ],
              "span": [
                1,
                2
              ],
              "label": "Live",
              "style": "switch",
              "icon": "mic.fill",
              "tint": "#B18CFF",
              "defaultValue": false,
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "podcast_studio_mic_live",
                  "mic": "remote",
                  "live": "{{value}}"
                }
              }
            },
            {
              "type": "sparkline",
              "id": "ps-lvl-remote",
              "position": [
                1,
                0
              ],
              "span": [
                2,
                2
              ],
              "label": "Level · dBFS",
              "tint": "#B18CFF",
              "sparklineFill": true,
              "sparklinePoints": 60,
              "defaultValue": [
                -40,
                -38,
                -41,
                -39,
                -37,
                -40,
                -42,
                -39,
                -38,
                -41,
                -40,
                -39
              ],
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "podcast_studio_levels"
                  },
                  "valuePath": "remote"
                }
              ]
            }
          ]
        },
        {
          "type": "gauge",
          "id": "ps-loudness",
          "position": [
            10,
            0
          ],
          "span": [
            3,
            2
          ],
          "label": "Program · LUFS",
          "min": -36,
          "max": 0,
          "step": 0.1,
          "gaugeStyle": "half",
          "icon": "waveform",
          "segments": [
            {
              "limit": -20,
              "color": "#5AC8FA"
            },
            {
              "limit": -14,
              "color": "#34C759"
            },
            {
              "limit": 0,
              "color": "#E8453C"
            }
          ],
          "defaultValue": -16.2,
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "podcast_studio_program"
              },
              "valuePath": "lufs"
            }
          ]
        },
        {
          "type": "pieChart",
          "id": "ps-talktime",
          "position": [
            10,
            2
          ],
          "span": [
            3,
            2
          ],
          "label": "Talk time",
          "pieStyle": "donut",
          "pieConfig": {
            "centerText": "{{total}} min",
            "showLabels": false,
            "showLegend": false
          },
          "defaultValue": "{\"slices\": [{\"label\": \"Maya\", \"value\": 18, \"color\": \"#FF5A4E\"}, {\"label\": \"Dev\", \"value\": 11, \"color\": \"#FFB347\"}, {\"label\": \"Lena\", \"value\": 14, \"color\": \"#5AC8FA\"}, {\"label\": \"Sam\", \"value\": 3, \"color\": \"#B18CFF\"}]}",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "podcast_studio_talktime"
              },
              "valuePath": "slices"
            }
          ]
        }
      ]
    },
    {
      "title": "Rundown",
      "icon": "list.bullet.rectangle",
      "grid": {
        "columns": 4,
        "rows": 12
      },
      "children": [
        {
          "type": "list",
          "id": "ps-runofshow",
          "position": [
            0,
            0
          ],
          "span": [
            5,
            4
          ],
          "label": "Run of show · Ep. 112",
          "listColumns": [
            {
              "key": "seg",
              "label": "Segment"
            },
            {
              "key": "owner",
              "label": "Lead"
            },
            {
              "key": "len",
              "label": "Len"
            },
            {
              "key": "status",
              "label": "State"
            }
          ],
          "defaultValue": "[{\"seg\": \"Cold open\", \"owner\": \"Maya\", \"len\": \"1:30\", \"status\": \"done\"}, {\"seg\": \"Intro + sponsor\", \"owner\": \"Dev\", \"len\": \"2:00\", \"status\": \"done\"}, {\"seg\": \"Guest: sleep science\", \"owner\": \"Lena\", \"len\": \"18:00\", \"status\": \"live\"}, {\"seg\": \"Remote call-in\", \"owner\": \"Sam\", \"len\": \"6:00\", \"status\": \"next\"}, {\"seg\": \"Listener mailbag\", \"owner\": \"Dev\", \"len\": \"8:00\", \"status\": \"queued\"}, {\"seg\": \"Outro + teaser\", \"owner\": \"Maya\", \"len\": \"1:45\", \"status\": \"queued\"}]",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "podcast_studio_rundown"
              },
              "valuePath": "segments"
            }
          ]
        },
        {
          "type": "picker",
          "id": "ps-segment",
          "position": [
            5,
            0
          ],
          "span": [
            1,
            4
          ],
          "label": "On-air segment",
          "pickerStyle": "menu",
          "tint": "#E8453C",
          "options": [
            "Cold open",
            "Intro + sponsor",
            "Guest: sleep science",
            "Remote call-in",
            "Listener mailbag",
            "Outro + teaser"
          ],
          "defaultValue": "Guest: sleep science",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "podcast_studio_segment",
              "name": "{{value}}"
            }
          }
        },
        {
          "type": "datePicker",
          "id": "ps-airdate",
          "position": [
            6,
            0
          ],
          "span": [
            1,
            4
          ],
          "label": "Publish at",
          "datePickerMode": "dateAndTime",
          "datePickerStyle": "compact",
          "tint": "#FFB347",
          "defaultValue": "2026-09-29T06:00:00Z",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "podcast_studio_schedule",
              "publish_at": "{{value}}"
            }
          }
        },
        {
          "type": "logConsole",
          "id": "ps-prodlog",
          "position": [
            7,
            0
          ],
          "span": [
            4,
            4
          ],
          "label": "Producer log",
          "maxLines": 300,
          "showTimestamps": true,
          "fontSize": 11,
          "autoScroll": true,
          "controlHeight": 232,
          "logColors": {
            "error": "#FF3B30",
            "warn": "#FFB347",
            "info": "#34C759",
            "debug": "#8E8E93"
          },
          "defaultValue": "[{\"level\": \"info\", \"message\": \"Session armed \\u00b7 48 kHz / 24-bit \\u00b7 4 tracks\"}, {\"level\": \"info\", \"message\": \"Chapter 1 'Cold open' @ 00:00:00\"}, {\"level\": \"info\", \"message\": \"Chapter 2 'Intro + sponsor' @ 00:01:34\"}, {\"level\": \"warn\", \"message\": \"Remote feed jitter 42 ms \\u2014 Sam on Zoom\"}, {\"level\": \"info\", \"message\": \"Chapter 3 'Guest: sleep science' @ 00:03:51\"}]",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "podcast_studio_log"
              },
              "valuePath": "line"
            }
          ]
        }
      ]
    }
  ]
}