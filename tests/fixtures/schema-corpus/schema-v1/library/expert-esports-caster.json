{
 "name": "Esports Caster Desk",
 "headerTitle": "CASTER DESK · LIVE",
 "version": 1,
 "id": "esports-caster-desk",
 "accentColor": "#FFE14D",
 "description": "A broadcast caster's second screen for a tactical-shooter final: team radar, credit-flow sankey, a telestrator map canvas, a highlight reel pinboard, a live kill-feed and a sponsor carousel, all driven by one esports_caster_* hub.",
 "difficulty": "expert",
 "keepAwake": true,
 "appearance": {
  "colorScheme": "dark",
  "showHeader": true,
  "statusBarStyle": "light",
  "header": {
   "style": "color",
   "dark": [
    "#1A0B2E",
    "#07040F"
   ],
   "light": [
    "#1A0B2E",
    "#07040F"
   ]
  }
 },
 "theme": {
  "fontFamily": "Futura",
  "labelFontSize": 11,
  "valueFontSize": 15,
  "valueFontWeight": "bold",
  "accentColor": "#FFE14D",
  "accentGradient": [
   "#FF3D7F",
   "#FFE14D",
   "#2DE2E6"
  ],
  "cornerRadius": 6,
  "cardPadding": 12,
  "controlPadding": 8,
  "borderWidth": 1,
  "pageBackgroundGradient": [
   "#07040F",
   "#120A24",
   "#1A0B2E"
  ],
  "surfacePrimary": "#FFFFFF0D",
  "surfaceSecondary": "#FFFFFF08",
  "surfaceTertiary": "#FFFFFF05",
  "borderColor": "#FF3D7F38",
  "foregroundColor": "#F6F2FF",
  "secondaryColor": "#B7A8D6",
  "tertiaryColor": "#6E5F8F",
  "tabBarBackground": "#07040FE6",
  "tabBarTint": "#FFE14D",
  "segmented": {
   "trackColor": "#FFFFFF10",
   "selectedColor": "#FFE14D",
   "textColor": "#B7A8D6",
   "selectedTextColor": "#07040F"
  },
  "toggle": {
   "trackActiveColor": "#FF3D7F",
   "knobShadow": true
  },
  "progressBar": {
   "trackColor": "#FFFFFF14",
   "trackActiveColor": "#FF3D7F",
   "trackHeight": 6
  }
 },
 "connection": {
  "url": "wss://connect.carterbeaudoin.net/ws",
  "identity": {
   "name": "caster-desk",
   "channel": "esports-caster",
   "role": "client"
  }
 },
 "state": {
  "sync": true,
  "authority": "EsportsCasterHub"
 },
 "sources": {
  "league": {
   "type": "http",
   "baseURL": "https://api.cascadeleague.gg",
   "interval": 30
  }
 },
 "publishers": [
  {
   "sensor": "audio",
   "interval": 1
  },
  {
   "sensor": "device",
   "interval": 30
  }
 ],
 "glance": {
  "title": "Caster Desk",
  "icon": "gamecontroller.fill",
  "tint": "#FFE14D",
  "hero": "ec-winprob",
  "slots": [
   "ec-score-a",
   "ec-score-b",
   "ec-phase"
  ],
  "liveActivity": true,
  "live": {
   "tier": "realtime",
   "activity": {
    "stale": 60
   }
  },
  "controls": [
   {
    "id": "cc-onair",
    "kind": "toggle",
    "label": "On air",
    "control": "ec-onair",
    "on": {
     "label": "LIVE",
     "icon": "record.circle.fill",
     "tint": "#FF4D4D"
    },
    "off": {
     "label": "Off air",
     "icon": "record.circle"
    }
   },
   {
    "id": "cc-replay",
    "kind": "button",
    "label": "Cue replay",
    "icon": "backward.end.alt.fill",
    "control": "ec-cue-replay"
   },
   {
    "id": "cc-focus",
    "kind": "cycle",
    "label": "Observer",
    "control": "ec-focus",
    "states": [
     {
      "value": "auto",
      "label": "Auto",
      "icon": "sparkles"
     },
     {
      "value": "nj",
      "label": "Nightjar",
      "icon": "person.fill",
      "tint": "#FF3D7F"
     },
     {
      "value": "sol",
      "label": "Solstice",
      "icon": "person.fill",
      "tint": "#2DE2E6"
     },
     {
      "value": "spike",
      "label": "Spike",
      "icon": "bolt.fill",
      "tint": "#FFE14D"
     }
    ]
   }
  ],
  "widgets": [
   {
    "id": "scoreline",
    "title": "Scoreline",
    "icon": "trophy.fill",
    "families": [
     "systemSmall",
     "systemMedium",
     "accessoryRectangular"
    ],
    "scene": {
     "rows": [
      [
       {
        "tile": "value",
        "control": "ec-score-a",
        "tint": "#FF3D7F"
       },
       {
        "tile": "light",
        "control": "ec-phase"
       },
       {
        "tile": "value",
        "control": "ec-score-b",
        "tint": "#2DE2E6"
       }
      ],
      [
       {
        "tile": "sparkline",
        "control": "ec-winprob-trend",
        "span": 2
       },
       {
        "tile": "gauge",
        "control": "ec-winprob"
       }
      ],
      [
       {
        "tile": "toggle",
        "control": "ec-onair"
       },
       {
        "tile": "button",
        "control": "ec-cue-replay"
       },
       {
        "tile": "open",
        "tab": "Replay",
        "label": "Reel"
       }
      ]
     ]
    }
   }
  ],
  "island": {
   "compactLeading": {
    "tile": "icon",
    "effect": "bounce"
   },
   "compactTrailing": {
    "tile": "value",
    "control": "ec-score-a",
    "tint": "#FF3D7F"
   },
   "minimal": {
    "tile": "light",
    "control": "ec-phase"
   },
   "expanded": {
    "leading": {
     "tile": "value",
     "control": "ec-score-a",
     "tint": "#FF3D7F"
    },
    "trailing": {
     "tile": "value",
     "control": "ec-score-b",
     "tint": "#2DE2E6"
    },
    "center": {
     "tile": "light",
     "control": "ec-phase"
    },
    "bottom": {
     "rows": [
      [
       {
        "tile": "gauge",
        "control": "ec-winprob"
       },
       {
        "tile": "sparkline",
        "control": "ec-winprob-trend"
       }
      ],
      [
       {
        "tile": "toggle",
        "control": "ec-onair"
       },
       {
        "tile": "button",
        "control": "ec-cue-replay"
       }
      ]
     ]
    }
   }
  }
 },
