{
  "name": "Film Set Coordinator",
  "headerTitle": "STARLITE · DAY 18",
  "version": 1,
  "accentColor": "#FFB347",
  "description": "A 2nd-AD / script-supervisor companion for a feature shoot: live slate and take counter, a searchable shot list, a swipeable call sheet with storyboard frames, and the crew radio log.",
  "difficulty": "advanced",
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light"
  },
  "keepAwake": true,
  "theme": {
    "accentColor": "#FFB347",
    "accentGradient": [
      "#FF8A3D",
      "#FFD27A"
    ],
    "fontDesign": "monospaced",
    "labelFontSize": 12,
    "valueFontSize": 15,
    "valueFontWeight": "semibold",
    "cornerRadius": 14,
    "cardPadding": 12,
    "borderWidth": 0.5,
    "tabBarTint": "#FFB347",
    "pageBackgroundGradient": [
      "#0B0907",
      "#16110C",
      "#1F1710"
    ],
    "surfacePrimary": "#FFE9C814",
    "surfaceSecondary": "#FFE9C80C",
    "surfaceTertiary": "#FFE9C806",
    "borderColor": "#FFB34733",
    "foregroundColor": "#F5EFE6",
    "secondaryColor": "#C9B79C",
    "tertiaryColor": "#7D6F5C",
    "toggle": {
      "trackActiveColor": "#FFB347"
    },
    "segmented": {
      "selectedColor": "#FFB347",
      "selectedTextColor": "#1A1208"
    }
  },
  "tabs": [
    {
      "title": "Slate",
      "icon": "movieclapper",
      "grid": {
        "columns": 4,
        "rows": 10
      },
      "children": [
        {
          "type": "symbol",
          "id": "slate-clapper",
          "position": [
            0,
            0
          ],
          "span": [
            3,
            2
          ],
          "systemName": "movieclapper.fill",
          "label": "Stage 4 · Unit A",
          "tint": "#FFB347",
          "symbolConfig": {
            "renderingMode": "palette",
            "palette": [
              "#FFB347",
              "#F5EFE6"
            ],
            "weight": "semibold",
            "effect": "pulse",
            "effectOptions": [
              "byLayer"
            ],
            "loop": "periodic",
            "loopDelay": 2.0,
            "tapEffect": "bounce",
            "triggers": [
              {
                "event": "broadcast",
                "filter": {
                  "msg_type": "film_set_marker"
                },
                "effect": "bounce"
              },
              {
                "event": "broadcast",
                "filter": {
                  "msg_type": "film_set_cut"
                },
                "effect": "wiggle"
              }
            ]
          },
          "haptic": "medium",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "film_set_marker",
              "scene": "42A",
              "take": "{{value}}"
            }
          }
        },
        {
          "type": "label",
          "id": "slate-scene-take",
          "position": [
            0,
            2
          ],
          "span": [
            1,
            2
          ],
          "icon": "film",
          "style": "headline",
          "text": "SC 42A · TK 7",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_set_slate"
              },
              "valuePath": "slate_text"
            }
          ]
        },
        {
          "type": "label",
          "id": "slate-roll",
          "position": [
            1,
            2
          ],
          "span": [
            1,
            2
          ],
          "icon": "camera.aperture",
          "style": "mono",
          "text": "A017 · B009 · SR 112",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_set_slate"
              },
              "valuePath": "rolls_text"
            }
          ]
        },
        {
          "type": "statusLight",
          "id": "slate-camera-state",
          "position": [
            2,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "Camera",
          "style": "badge",
          "statusColors": {
            "rolling": "#FF3B30",
            "speed": "#FF9F0A",
            "cut": "#8E8E93",
            "reset": "#5AC8FA",
            "lighting": "#FFD60A"
          },
          "defaultValue": "reset",
          "pulse": true,
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_set_camera"
              },
              "valuePath": "state"
            }
          ]
        },
        {
          "type": "stepper",
          "id": "slate-take",
          "position": [
            3,
            0
          ],
          "span": [
            1,
            2
          ],
          "label": "Take",
          "icon": "number",
          "min": 1,
          "max": 60,
          "step": 1,
          "defaultValue": 7,
          "haptic": "light",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_set_slate"
              },
              "valuePath": "take"
            }
          ],
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "film_set_take_set",
              "scene": "42A",
              "take": "{{value}}"
            }
          }
        },
        {
          "type": "segmentedControl",
          "id": "slate-camera-unit",
          "position": [
            3,
            2
          ],
          "span": [
            1,
            2
          ],
          "options": [
            "A",
            "B",
            "C",
            "ALL"
          ],
          "defaultValue": "A",
          "style": "pills",
          "haptic": "selection",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_set_slate"
              },
              "valuePath": "camera"
            }
          ],
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "film_set_camera_select",
              "camera": "{{value}}"
            }
          }
        },
        {
          "type": "group",
          "id": "slate-marks",
          "label": "Take marks · SC 42A",
          "position": [
            4,
            0
          ],
          "span": [
            4,
            4
          ],
          "grid": {
            "columns": 3,
            "rows": 3
          },
          "children": [
            {
              "type": "button",
              "id": "mark-circle",
              "position": [
                0,
                0
              ],
              "label": "Circle",
              "icon": "checkmark.circle.fill",
              "style": "tinted",
              "tint": "#34C759",
              "haptic": "success",
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "film_set_take_mark",
                  "scene": "42A",
                  "mark": "circle"
                }
              }
            },
            {
              "type": "button",
              "id": "mark-ng",
              "position": [
                0,
                1
              ],
              "label": "NG",
              "icon": "xmark.octagon.fill",
              "style": "tinted",
              "tint": "#FF453A",
              "haptic": "error",
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "film_set_take_mark",
                  "scene": "42A",
                  "mark": "no_good"
                }
              }
            },
            {
              "type": "button",
              "id": "mark-hold",
              "position": [
                0,
                2
              ],
              "label": "Hold",
              "icon": "pause.circle.fill",
              "style": "tinted",
              "tint": "#FF9F0A",
              "haptic": "warning",
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "film_set_take_mark",
                  "scene": "42A",
                  "mark": "hold"
                }
              }
            },
            {
              "type": "toggle",
              "id": "slate-mos",
              "position": [
                1,
                0
              ],
              "span": [
                1,
                2
              ],
              "label": "MOS (no sound)",
              "icon": "speaker.slash.fill",
              "defaultValue": false,
              "haptic": "light",
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "film_set_slate"
                  },
                  "valuePath": "mos"
                }
              ],
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "film_set_mos",
                  "on": "{{value}}"
                }
              }
            },
            {
              "type": "toggle",
              "id": "slate-vfx",
              "position": [
                1,
                2
              ],
              "label": "VFX plate",
              "icon": "sparkles",
              "defaultValue": true,
              "haptic": "light",
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "film_set_vfx_plate",
                  "on": "{{value}}"
                }
              }
            },
            {
              "type": "textInput",
              "id": "slate-note",
              "position": [
                2,
                0
              ],
              "span": [
                1,
                3
              ],
              "placeholder": "Script note for TK 7…",
              "icon": "pencil.line",
              "sendButton": true,
              "clearOnSubmit": true,
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "film_set_take_note",
                  "scene": "42A",
                  "note": "{{value}}"
                }
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "slate-roll-btn",
          "position": [
            8,
            0
          ],
          "span": [
            1,
            2
          ],
          "label": "Roll sound + camera",
          "icon": "record.circle",
          "style": "filled",
          "tint": "#FF3B30",
          "haptic": "heavy",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "film_set_roll",
              "camera": "all"
            }
          }
        },
        {
          "type": "button",
          "id": "slate-cut-btn",
          "position": [
            8,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "Cut",
          "icon": "scissors",
          "style": "outlined",
          "haptic": "heavy",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "film_set_cut",
              "scene": "42A"
            }
          }
        },
        {
          "type": "label",
          "id": "slate-mos-banner",
          "position": [
            9,
            0
          ],
          "span": [
            1,
            4
          ],
          "icon": "exclamationmark.triangle.fill",
          "style": "caption",
          "align": "center",
          "tint": "#FF9F0A",
          "text": "MOS take — no sync sound, sticks optional. Tail-slate with fingers.",
          "visible": {
            "when": "slate-mos",
            "operator": "eq",
            "value": true
          }
        }
      ]
    },
    {
      "title": "Shots",
      "icon": "list.bullet.rectangle",
      "grid": {
        "columns": 4,
        "rows": 11
      },
      "children": [
        {
          "type": "cardList",
          "id": "shot-list",
          "position": [
            0,
            0
          ],
          "span": [
            6,
            4
          ],
          "label": "Shot list · Day 18",
          "defaultValue": "{\"nodes\": [{\"id\": \"sh-42a-a\", \"label\": \"42A \\u00b7 WIDE \\u00b7 Mara enters diner, 24mm dolly\", \"group\": \"shooting\", \"icon\": \"video.fill\"}, {\"id\": \"sh-42a-b\", \"label\": \"42A \\u00b7 MCU Mara \\u00b7 50mm, rain on glass\", \"group\": \"shooting\", \"icon\": \"camera.fill\"}, {\"id\": \"sh-42b-a\", \"label\": \"42B \\u00b7 OTS Dex \\u2192 Mara \\u00b7 75mm\", \"group\": \"up next\", \"icon\": \"person.2.fill\"}, {\"id\": \"sh-42b-b\", \"label\": \"42B \\u00b7 CU Dex reaction \\u00b7 100mm macro\", \"group\": \"up next\", \"icon\": \"eye.fill\"}, {\"id\": \"sh-42c\", \"label\": \"42C \\u00b7 INSERT coffee cup, overcrank 48fps\", \"group\": \"up next\", \"icon\": \"cup.and.saucer.fill\"}, {\"id\": \"sh-43-a\", \"label\": \"43 \\u00b7 EXT diner lot \\u00b7 crane down, night rain\", \"group\": \"up next\", \"icon\": \"cloud.rain.fill\"}, {\"id\": \"sh-44-a\", \"label\": \"44 \\u00b7 Steadicam walk & talk, 18mm\", \"group\": \"up next\", \"icon\": \"figure.walk\"}, {\"id\": \"sh-41-a\", \"label\": \"41 \\u00b7 Booth two-shot \\u00b7 circled TK 4\", \"group\": \"wrapped\", \"icon\": \"checkmark.seal.fill\"}, {\"id\": \"sh-41-b\", \"label\": \"41 \\u00b7 CU waitress \\u00b7 circled TK 2, 6\", \"group\": \"wrapped\", \"icon\": \"checkmark.seal.fill\"}, {\"id\": \"sh-40-a\", \"label\": \"40 \\u00b7 Neon sign plate \\u00b7 VFX\", \"group\": \"wrapped\", \"icon\": \"sparkles\"}, {\"id\": \"sh-45\", \"label\": \"45 \\u00b7 Car interior process \\u00b7 moved to Day 19\", \"group\": \"dropped\", \"icon\": \"calendar.badge.minus\"}]}",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_set_shots"
              },
              "valuePath": "graph"
