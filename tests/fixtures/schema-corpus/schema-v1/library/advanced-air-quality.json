{
  "name": "Air Quality",
  "version": 1,
  "headerTitle": "SLC AIR WATCH · WASATCH FRONT",
  "accentColor": "#FF9F43",
  "description": "A city air-quality desk for the Salt Lake Valley: per-district AQI gauges and a 24-hour forecast pulled straight from the Open-Meteo air-quality API, a pollutant radar, district heatmap, monitor map, and personal alert thresholds.",
  "difficulty": "advanced",
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light"
  },
  "theme": {
    "accentColor": "#FF9F43",
    "accentGradient": [
      "#3DDC84",
      "#F5D547",
      "#FF9F43",
      "#FF5A5F"
    ],
    "fontDesign": "rounded",
    "labelFontSize": 12,
    "valueFontSize": 15,
    "valueFontWeight": "semibold",
    "cornerRadius": 18,
    "cardPadding": 12,
    "controlPadding": 8,
    "borderWidth": 0.5,
    "pageBackgroundGradient": [
      "#0B0F1A",
      "#141A2B",
      "#231C2A",
      "#2B1E1A"
    ],
    "surfacePrimary": "#E6ECFF14",
    "surfaceSecondary": "#E6ECFF0C",
    "surfaceTertiary": "#E6ECFF07",
    "foregroundColor": "#F2F4FA",
    "secondaryColor": "#B9C3D6",
    "tertiaryColor": "#7B869C",
    "borderColor": "#E6ECFF2A",
    "tabBarTint": "#FF9F43",
    "toggle": {
      "trackActiveColor": "#FF9F43",
      "knobColor": "#F2F4FA"
    },
    "slider": {
      "trackActiveColor": "#FF9F43",
      "thumbColor": "#F2F4FA"
    },
    "segmented": {
      "trackColor": "#E6ECFF14",
      "selectedColor": "#FF9F43",
      "textColor": "#B9C3D6",
      "selectedTextColor": "#0B0F1A"
    }
  },
  "sources": {
    "openmeteo": {
      "type": "http",
      "baseURL": "https://air-quality-api.open-meteo.com",
      "interval": 600
    }
  },
  "tabs": [
    {
      "title": "City",
      "icon": "aqi.medium",
