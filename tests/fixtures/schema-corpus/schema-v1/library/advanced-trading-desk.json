{
  "name": "Trading Desk",
  "headerTitle": "DESK · EQUITIES",
  "version": 1,
  "accentColor": "#4CC9F0",
  "description": "An equity trading desk: portfolio treemap, sector exposure radar, live price chart and watchlist, a full order ticket, and a risk tab with P&L distributions and a circuit breaker.",
  "difficulty": "advanced",
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light"
  },
  "theme": {
    "accentColor": "#4CC9F0",
    "accentGradient": [
      "#4CC9F0",
      "#7B8CFF"
    ],
    "fontDesign": "monospaced",
    "labelFontSize": 11,
    "valueFontSize": 15,
    "valueFontWeight": "semibold",
    "cornerRadius": 10,
    "cardPadding": 12,
    "borderWidth": 0.5,
    "tabBarTint": "#4CC9F0",
    "pageBackgroundGradient": [
      "#05070D",
      "#0A1020",
      "#0E1630"
    ],
    "surfacePrimary": "#8FB8FF12",
    "surfaceSecondary": "#8FB8FF0A",
    "surfaceTertiary": "#8FB8FF06",
    "borderColor": "#8FB8FF2E",
    "foregroundColor": "#E8F0FF",
    "secondaryColor": "#9AA8C7",
    "tertiaryColor": "#5C6B8A",
    "segmented": {
      "selectedColor": "#4CC9F0",
      "selectedTextColor": "#05070D"
    },
    "toggle": {
      "trackActiveColor": "#2EE59D",
      "knobShadow": true
    }
  },
  "state": {
    "sync": true,
    "authority": "TradingDeskHub"
  },
