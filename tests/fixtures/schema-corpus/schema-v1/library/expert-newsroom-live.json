{
  "name": "Newsroom Live",
  "headerTitle": "LEDGER \u00b7 LIVE DESK",
  "version": 1,
  "accentColor": "#D7263D",
  "description": "A breaking-news command desk for a metro daily: drag-to-assign story budget, editable publishing gantt, a live wire feed injected as cards, a source map and desk hand-off chord, an editors' chat, and a breaking-news Live Activity.",
  "difficulty": "expert",
  "keepAwake": true,
  "state": {
    "sync": true,
    "authority": "newsroom-live-hub"
  },
  "sources": {
    "cms": {
      "type": "http",
      "baseURL": "https://cms.example.com/api",
      "interval": 30
    }
  },
  "batchPublishers": true,
  "publishers": [
    {
      "sensor": "location",
      "interval": 10
    },
    {
      "sensor": "device",
      "interval": 60
    }
  ],
  "appearance": {
    "colorScheme": "system",
    "statusBarStyle": "auto",
    "header": {
      "style": "color",
      "dark": [
        "#0E0D0B",
        "#1A1714"
      ],
      "light": "#F3EEE3F2"
    }
  },
  "theme": {
    "accentColor": "#D7263D",
    "accentGradient": [
      "#D7263D",
      "#A61B2E"
    ],
    "fontDesign": "serif",
    "labelFontSize": 11,
    "valueFontSize": 15,
    "valueFontWeight": "bold",
    "cornerRadius": 3,
    "cardPadding": 12,
    "borderWidth": 1,
    "tabBarTint": "#D7263D",
    "toggle": {
      "trackActiveColor": "#D7263D",
      "knobColor": "#F3EEE3"
    },
    "segmented": {
      "selectedColor": "#D7263D",
      "selectedTextColor": "#F3EEE3"
    },
    "slider": {
      "trackActiveColor": "#D7263D",
      "thumbColor": "#F3EEE3"
    },
    "dark": {
      "pageBackgroundGradient": [
        "#0E0D0B",
        "#15130F",
        "#1C1812"
      ],
      "surfacePrimary": "#F3EEE30D",
      "surfaceSecondary": "#FFFFFF08",
      "surfaceTertiary": "#00000033",
      "borderColor": "#F3EEE326",
      "foregroundColor": "#F3EEE3",
      "secondaryColor": "#B5AC9C",
      "tertiaryColor": "#7D7567",
      "tabBarBackground": "#0E0D0BF2"
    },
    "light": {
      "pageBackgroundGradient": [
        "#F6F2E9",
        "#ECE5D6"
      ],
      "surfacePrimary": "#FFFFFFCC",
      "borderColor": "#1A171426",
      "foregroundColor": "#16130F",
      "secondaryColor": "#5C5448",
      "tabBarBackground": "#F6F2E9F2"
    }
  },
  "glance": {
    "title": "Ledger Live",
    "icon": "newspaper.fill",
    "tint": "#D7263D",
    "hero": "nl-breaking-state",
    "slots": [
      "nl-readers",
      "nl-filed-ring",
      "nl-deadline"
    ],
    "liveActivity": true,
    "live": {
      "tier": "fresh",
      "activity": {
        "stale": 180
      }
    },
    "controls": [
      {
        "id": "breaking",
        "kind": "toggle",
        "label": "Breaking mode",
        "control": "nl-breaking-mode",
        "on": {
          "label": "Armed",
          "icon": "bolt.fill",
          "tint": "#D7263D"
        },
        "off": {
          "label": "Standby",
          "icon": "bolt.slash"
        }
      },
      {
        "id": "edition",
        "kind": "cycle",
        "label": "Edition",
        "control": "nl-edition",
        "states": [
          {
            "value": "web",
            "label": "Web",
            "icon": "globe"
          },
          {
            "value": "app",
            "label": "App",
            "icon": "iphone"
          },
          {
            "value": "print",
            "label": "Print",
            "icon": "printer.fill"
          },
          {
            "value": "news",
            "label": "Letter",
            "icon": "envelope.fill"
          }
        ]
      },
      {
        "id": "push",
        "kind": "button",
        "label": "Push alert",
        "icon": "bell.badge.fill",
        "control": "nl-push-alert"
      }
    ],
    "widgets": [
      {
        "id": "desk-pulse",
        "title": "Desk pulse",
        "icon": "newspaper",
        "families": [
          "systemSmall",
          "systemMedium",
          "accessoryRectangular"
        ],
        "scene": {
          "rows": [
            [
              {
                "tile": "light",
                "control": "nl-breaking-state"
              },
              {
                "tile": "ring",
                "control": "nl-filed-ring"
              }
            ],
            [
              {
                "tile": "sparkline",
                "control": "nl-pv-trend",
                "span": 2
              }
            ],
            [
              {
                "tile": "value",
                "control": "nl-readers"
              },
              {
                "tile": "toggle",
                "control": "nl-breaking-mode"
              }
            ]
          ]
        }
      }
    ],
    "island": {
      "compactLeading": {
        "tile": "icon",
        "effect": "pulse"
      },
      "compactTrailing": {
        "tile": "light",
        "control": "nl-breaking-state"
      },
      "minimal": {
        "tile": "light",
        "control": "nl-breaking-state"
      },
      "expanded": {
        "leading": {
          "tile": "icon"
        },
        "trailing": {
          "tile": "freshness"
        },
        "center": {
          "tile": "value",
          "control": "nl-readers",
          "label": "Readers"
        },
        "bottom": {
          "rows": [
            [
              {
                "tile": "ring",
                "control": "nl-filed-ring"
              },
              {
                "tile": "sparkline",
                "control": "nl-pv-trend"
              }
            ],
            [
              {
                "tile": "button",
                "control": "nl-push-alert"
              },
              {
                "tile": "open",
                "tab": "Wire",
                "label": "Wire"
              }
            ]
          ]
        }
      }
    },
    "lockScreen": {
      "rows": [
        [
          {
            "tile": "light",
            "control": "nl-breaking-state"
          },
          {
            "tile": "value",
            "control": "nl-readers"
          },
          {
            "tile": "value",
            "control": "nl-deadline"
          }
        ],
        [
          {
            "tile": "sparkline",
            "control": "nl-pv-trend",
            "span": 3
          }
        ]
      ]
    }
  },
  "tabs": [
    {
      "title": "Front",
      "icon": "newspaper.fill",
      "grid": {
        "columns": 4,
        "rows": 14
      },
      "children": [
        {
          "type": "label",
          "id": "nl-masthead",
          "position": [
            0,
            0
          ],
          "span": [
            1,
            4
          ],
          "text": "THE HARBOR LEDGER \u00b7 Live Desk",
          "style": "headline",
          "icon": "newspaper",
          "tint": "#D7263D",
          "align": "center",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "newsroom_live_state"
              },
              "valuePath": "masthead"
            }
          ]
        },
        {
          "type": "progressRing",
          "id": "nl-filed-ring",
          "position": [
            1,
            0
          ],
          "span": [
            3,
            2
          ],
          "label": "Stories filed",
          "icon": "doc.text.fill",
          "tint": "#D7263D",
          "min": 0,
          "max": 64,
          "defaultValue": 41,
          "animation": "smooth",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "newsroom_live_state"
              },
              "valuePath": "stories_filed"
            }
          ]
        },
        {
          "type": "statusLight",
          "id": "nl-breaking-state",
          "position": [
            1,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "Breaking",
          "style": "badge",
          "pulse": true,
          "defaultValue": "developing",
          "statusColors": {
            "quiet": "#5E6B7D",
            "developing": "#E0B64A",
            "breaking": "#D7263D",
            "all-clear": "#3FB6A8"
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "newsroom_live_state"
              },
              "valuePath": "breaking"
            }
          ]
        },
        {
          "type": "label",
          "id": "nl-deadline",
          "position": [
            2,
            2
          ],
          "span": [
            2,
            2
          ],
          "label": "Print close in",
          "icon": "clock.badge.exclamationmark",
          "style": "large-mono",
          "tint": "#E0B64A",
          "formatValue": "time",
          "defaultValue": 5220,
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "newsroom_live_state"
              },
              "valuePath": "deadline_s"
            }
          ]
        },
        {
          "type": "segmentedControl",
          "id": "nl-edition",
          "position": [
            4,
            0
          ],
          "span": [
            1,
            4
          ],
          "options": [
            "web",
            "app",
            "print",
            "news"
          ],
          "optionLabels": [
            "Web",
            "App",
            "Print",
            "Letter"
          ],
          "defaultValue": "web",
          "haptic": "selection",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "newsroom_live_set_edition",
              "edition": "{{value}}"
            }
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "newsroom_live_state"
              },
              "valuePath": "edition"
            }
          ]
        },
        {
          "type": "sparkline",
          "id": "nl-pv-trend",
          "position": [
            5,
            0
          ],
          "span": [
            2,
            2
          ],
          "label": "Pageviews / min",
          "tint": "#D7263D",
          "sparklinePoints": 24,
          "sparklineFill": true,
          "defaultValue": [
            3100,
            3240,
            3180,
            3420,
            3600,
            3550,
            3890,
            4210,
            4480,
            4390,
            4720,
            5100,
            5630,
            6020,
            5880,
            6410,
            7050,
            7420,
            7310,
            7960,
            8480,
            8820,
            9150,
            9460
          ],
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "newsroom_live_state"
              },
              "valuePath": "pageviews_per_min"
            }
          ]
        },
        {
          "type": "gauge",
          "id": "nl-readers",
          "position": [
            5,
            2
          ],
          "span": [
            3,
            2
          ],
          "label": "Concurrent readers",
          "icon": "person.3.fill",
          "min": 0,
          "max": 120000,
          "gaugeStyle": "full",
          "tint": "#D7263D",
          "defaultValue": 68400,
          "animation": "smooth",
          "segments": [
            {
              "limit": 60000,
              "color": "#3FB6A8"
            },
            {
              "limit": 90000,
              "color": "#E0B64A"
            },
            {
              "limit": 120000,
              "color": "#D7263D"
            }
          ],
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "newsroom_live_state"
              },
              "valuePath": "readers"
            }
          ]
        },
        {
          "type": "statusLight",
          "id": "nl-cms-health",
          "position": [
            7,
            0
          ],
          "span": [
            1,
            2
          ],
          "label": "CMS",
          "defaultValue": "ok",
          "statusColors": {
            "ok": "#3FB6A8",
            "degraded": "#E0B64A",
            "down": "#D7263D"
          },
          "sync": [
            {
              "method": "http",
              "source": "cms",
              "path": "/v2/health",
              "interval": 30,
              "valuePath": "status"
            }
          ]
        },
        {
          "type": "sankey",
          "id": "nl-traffic",
          "position": [
            8,
            0
          ],
          "span": [
            4,
            4
          ],
          "label": "Referrers \u2192 sections",
          "tint": "#D7263D",
          "formatValue": "decimal:0",
          "animation": "smooth",
          "sankeyConfig": {
            "showValues": true,
            "linkOpacity": 0.36,
            "nodeWidth": 8,
            "scrub": true,
            "nodeAction": {
              "method": "meshsocket",
              "mode": "broadcast",
              "event": "broadcast_request",
              "payload": {
                "msg_type": "newsroom_live_inspect_referrer",
                "node": "{{value}}"
              }
            }
          },
          "defaultValue": "{\"nodes\":[{\"name\":\"Search\",\"color\":\"#E0B64A\"},{\"name\":\"Social\",\"color\":\"#3FB6A8\"},{\"name\":\"Direct\",\"color\":\"#8A93A6\"},{\"name\":\"Newsletter\",\"color\":\"#B38BD9\"},{\"name\":\"Metro\"},{\"name\":\"Politics\",\"color\":\"#D7263D\"},{\"name\":\"Business\"},{\"name\":\"Sports\"}],\"links\":[{\"source\":\"Search\",\"target\":\"Politics\",\"value\":2400},{\"source\":\"Search\",\"target\":\"Metro\",\"value\":1300},{\"source\":\"Social\",\"target\":\"Politics\",\"value\":1900},{\"source\":\"Social\",\"target\":\"Sports\",\"value\":820},{\"source\":\"Direct\",\"target\":\"Metro\",\"value\":1100},{\"source\":\"Direct\",\"target\":\"Business\",\"value\":640},{\"source\":\"Newsletter\",\"target\":\"Business\",\"value\":710},{\"source\":\"Newsletter\",\"target\":\"Politics\",\"value\":560}]}",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "newsroom_live_traffic"
              },
              "valuePath": "sankey"
            }
          ]
        },
        {
          "type": "toggle",
          "id": "nl-breaking-mode",
          "position": [
            12,
            0
          ],
          "span": [
            1,
            2
          ],
          "label": "Breaking mode",
          "icon": "bolt.fill",
          "defaultValue": false,
          "haptic": "warning",
          "tint": "#D7263D",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "newsroom_live_breaking_mode",
              "armed": "{{value}}"
            }
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "newsroom_live_state"
              },
              "valuePath": "breaking_mode"
            }
          ]
        },
        {
          "type": "button",
          "id": "nl-push-alert",
          "position": [
            12,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "Push alert",
          "icon": "bell.badge.fill",
          "style": "filled",
          "tint": "#D7263D",
          "haptic": "heavy",
          "visible": {
            "when": "nl-breaking-mode",
            "operator": "eq",
            "value": true
          },
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "newsroom_live_push_alert",
              "edition": "web",
              "slug": "harbor-bridge-closure"
            }
          }
        },
        {
          "type": "label",
          "id": "nl-surge-banner",
          "position": [
            13,
            0
          ],
          "span": [
            1,
            4
          ],
          "text": "Traffic surge \u2014 CDN autoscale engaged, paywall meter relaxed",
          "style": "caption",
          "icon": "exclamationmark.triangle.fill",
          "tint": "#D7263D",
          "align": "center",
          "visible": {
            "when": "nl-readers",
            "operator": "gt",
            "value": 90000
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "newsroom_live_state"
              },
              "valuePath": "surge_banner"
            }
          ]
        }
      ]
    },
    {
      "title": "Budget",
      "icon": "rectangle.3.group.fill",
      "grid": {
        "columns": 4,
        "rows": 5,
        "mode": "flow"
      },
      "children": [
        {
          "type": "label",
          "id": "nl-budget-hint",
          "position": [
            0,
            0
          ],
          "span": [
            1,
            4
          ],
          "text": "Drag slugs through the desk \u00b7 Copy desk holds 3 \u00b7 Published is locked",
          "style": "caption",
          "icon": "hand.draw.fill",
          "tint": "#8A93A6"
        },
        {
          "type": "sortboard",
          "id": "nl-story-board",
          "position": [
            1,
            0
          ],
          "span": [
            10,
            4
          ],
          "controlHeight": 600,
          "label": "Story budget \u00b7 Thu 24 Sep",
          "sortboardConfig": {
            "searchable": true,
            "paletteLabel": "Unassigned pitches",
            "columns": 2,
            "items": [
              {
                "id": "BRIDGE",
                "label": "Harbor Bridge closure",
                "icon": "car.fill",
                "tint": "#D7263D",
                "zone": "editing"
              },
              {
                "id": "COUNCIL",
                "label": "Council budget vote",
                "icon": "building.columns.fill",
                "tint": "#E0B64A",
                "zone": "reporting"
              },
              {
                "id": "PORT",
                "label": "Port strike day 3",
                "icon": "shippingbox.fill",
                "tint": "#3FB6A8",
                "zone": "reporting"
              },
              {
                "id": "SCHOOLS",
                "label": "School bond audit",
                "icon": "graduationcap.fill",
                "tint": "#8A93A6",
                "zone": "pitched"
              },
              {
                "id": "STORM",
                "label": "Nor'easter track",
                "icon": "cloud.bolt.rain.fill",
                "tint": "#5DA9E9",
                "zone": "copy"
              },
              {
                "id": "MAYOR",
                "label": "Mayor interview",
                "icon": "mic.fill",
                "tint": "#E0B64A",
                "zone": "editing"
              },
              {
                "id": "FERRY",
                "label": "Ferry fare hike",
                "icon": "ferry.fill",
                "tint": "#3FB6A8"
              },
              {
                "id": "CANNERY",
                "label": "Cannery reopening",
                "icon": "fish.fill",
                "tint": "#8A93A6"
              },
              {
                "id": "OBIT",
                "label": "Obit: R. Aldana",
                "icon": "text.book.closed.fill",
                "tint": "#9A8F7E",
                "zone": "published",
                "locked": true
              },
              {
                "id": "SPORTS",
                "label": "Gulls clinch playoff",
                "icon": "sportscourt.fill",
                "tint": "#3FB6A8",
                "zone": "published",
                "locked": true
              },
              {
                "id": "OPED",
                "label": "Op-ed: housing",
                "icon": "quote.opening",
                "tint": "#B38BD9"
              }
            ],
            "zones": [
              {
                "id": "pitched",
                "label": "Pitched",
                "tint": "#8A93A6"
              },
              {
                "id": "reporting",
                "label": "Reporting",
                "tint": "#3FB6A8",
                "capacity": 5
              },
              {
                "id": "editing",
                "label": "Editing",
                "tint": "#E0B64A",
                "capacity": 4
              },
              {
                "id": "copy",
                "label": "Copy desk",
                "tint": "#5DA9E9",
                "capacity": 3
              },
              {
                "id": "published",
                "label": "Published",
                "tint": "#D7263D",
                "locked": true
              }
            ],
            "events": {
              "place": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "newsroom_live_story_move",
                  "slug": "{{item}}",
                  "from_stage": "{{from}}",
                  "to_stage": "{{to}}",
                  "index": "{{index}}"
                }
              },
              "layout": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "newsroom_live_budget_layout"
                }
              }
            }
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "newsroom_live_budget"
              },
              "valuePath": "arrangement"
            }
          ]
        },
        {
          "type": "gantt",
          "id": "nl-publish-gantt",
          "position": [
            2,
            0
          ],
          "span": [
            6,
            4
          ],
          "label": "Publishing plan",
          "tint": "#D7263D",
          "ganttConfig": {
            "editable": true,
            "step": 0.05,
            "rowHeight": 28,
            "barCornerRadius": 3,
            "colors": [
              "#D7263D",
              "#E0B64A",
              "#3FB6A8",
              "#8A93A6"
            ],
            "taskAction": {
              "method": "meshsocket",
              "mode": "broadcast",
              "event": "broadcast_request",
              "payload": {
                "msg_type": "newsroom_live_slot_progress",
                "task": "{{value}}"
              }
