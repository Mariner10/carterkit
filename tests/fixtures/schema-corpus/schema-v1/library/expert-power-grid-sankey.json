          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "power_grid_sankey_conservative_ops",
              "on": "{{value}}"
            }
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "power_grid_sankey_balance"
              },
              "valuePath": "conservative_ops"
            }
          ]
        },
        {
          "type": "button",
          "id": "bal-eea",
          "position": [
            16,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "Declare EEA-1",
          "icon": "megaphone.fill",
          "style": "filled",
          "tint": "#FF4D6D",
          "haptic": "warning",
          "visible": {
            "when": "bal-mode",
            "operator": "eq",
            "value": "emergency"
          },
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "power_grid_sankey_declare_eea",
              "level": 1
            }
          }
        }
      ]
    },
    {
