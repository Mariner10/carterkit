{
  "name": "Regional Power Grid",
  "headerTitle": "NORTHSTAR BA · GRID OPS",
  "version": 1,
  "accentColor": "#FFB020",
  "id": "power-grid-sankey",
  "description": "Balancing-authority console for a regional grid: generation-to-load sankey, interchange chord, substation topology, outage map, demand forecast and a frequency glance.",
  "difficulty": "expert",
  "keepAwake": true,
  "batchPublishers": true,
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light",
    "header": {
      "style": "color",
      "dark": [
        "#05070B",
        "#0B1119"
      ],
      "light": "#F4F0E6F2"
    }
  },
  "theme": {
    "accentColor": "#FFB020",
    "accentGradient": [
      "#FFB020",
      "#FF6A3D",
      "#35E0FF"
    ],
    "fontDesign": "monospaced",
    "cornerRadius": 6,
    "cardPadding": 12,
    "controlPadding": 8,
    "borderWidth": 1,
    "labelFontSize": 11,
    "valueFontSize": 15,
    "valueFontWeight": "bold",
    "tabBarTint": "#FFB020",
    "dark": {
      "pageBackgroundGradient": [
        "#05070B",
        "#0B1119",
        "#101A22"
      ],
      "surfacePrimary": "#FFB0200D",
      "surfaceSecondary": "#35E0FF0A",
      "surfaceTertiary": "#FFFFFF06",
      "foregroundColor": "#F2EEE3",
      "secondaryColor": "#B9B2A0",
      "tertiaryColor": "#6E6A5E",
      "borderColor": "#FFB02033",
      "tabBarBackground": "#070A0FEE"
    },
    "light": {
      "pageBackgroundGradient": [
        "#F4F0E6",
        "#E8E2D2"
      ],
      "surfacePrimary": "#FFFFFFD9",
      "surfaceSecondary": "#FFFFFFB3",
      "surfaceTertiary": "#00000008",
      "foregroundColor": "#1A1712",
      "secondaryColor": "#5C5546",
      "tertiaryColor": "#8F8775",
      "borderColor": "#1A171226",
      "tabBarBackground": "#F4F0E6EE"
    },
    "toggle": {
      "trackActiveColor": "#FFB020",
      "knobColor": "#F2EEE3",
      "knobShadow": true
    },
    "slider": {
      "trackActiveColor": "#35E0FF",
      "thumbColor": "#F2EEE3"
    },
    "segmented": {
      "trackColor": "#FFB02014",
      "selectedColor": "#FFB020",
      "textColor": "#B9B2A0",
      "selectedTextColor": "#05070B"
    },
    "stepper": {
      "buttonColor": "#FFB02026",
      "iconColor": "#FFB020"
    }
  },
  "connection": {
    "mode": "pair",
    "identity": {
      "name": "grid-ops-console",
      "channel": "power-grid",
      "role": "controller",
      "can_broadcast": true,
      "can_route": true
    }
  },
  "state": {
    "sync": true,
    "authority": "power-grid-sankey-hub",
    "acks": true,
    "ackTimeoutMs": 2500
  },
  "sources": {
    "iso": {
      "type": "http",
      "baseURL": "https://api.northstar-iso.example",
      "interval": 60
    }
  },
  "publishers": [
    {
      "sensor": "location",
      "interval": 10
    },
    {
      "sensor": "device",
      "interval": 60
    }
  ],
  "tabs": [
    {
      "title": "Balance",
      "icon": "bolt.horizontal.fill",
      "grid": {
        "columns": 4,
        "rows": 17
      },
      "children": [
        {
          "type": "group",
          "id": "bal-status",
          "position": [
            0,
            0
          ],
          "span": [
            1,
            4
          ],
          "grid": {
            "columns": 4,
            "rows": 1
          },
          "children": [
            {
              "type": "statusLight",
              "id": "bal-st-freq",
              "position": [
                0,
                0
              ],
              "span": [
                1,
                1
              ],
              "label": "Freq",
              "style": "badge",
              "size": "small",
              "pulse": true,
              "defaultValue": "nominal",
              "statusColors": {
                "nominal": "#3DF5B0",
                "alert": "#FFC247",
                "emergency": "#FF4D6D",
                "offline": "#5A6378"
              },
              "theme": {
                "controlPadding": 3,
                "labelFontSize": 10
              },
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "power_grid_sankey_balance"
                  },
                  "valuePath": "status.freq"
                }
              ]
            },
            {
              "type": "statusLight",
              "id": "bal-st-agc",
              "position": [
                0,
                1
              ],
              "span": [
                1,
                1
              ],
              "label": "AGC",
              "style": "badge",
              "size": "small",
              "pulse": true,
              "defaultValue": "nominal",
              "statusColors": {
                "nominal": "#3DF5B0",
                "alert": "#FFC247",
                "emergency": "#FF4D6D",
                "offline": "#5A6378"
              },
              "theme": {
                "controlPadding": 3,
                "labelFontSize": 10
              },
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "power_grid_sankey_balance"
                  },
                  "valuePath": "status.agc"
                }
              ]
            },
            {
              "type": "statusLight",
              "id": "bal-st-res",
              "position": [
                0,
                2
              ],
              "span": [
                1,
                1
              ],
              "label": "Reserve",
              "style": "badge",
              "size": "small",
              "pulse": true,
              "defaultValue": "alert",
              "statusColors": {
                "nominal": "#3DF5B0",
                "alert": "#FFC247",
                "emergency": "#FF4D6D",
                "offline": "#5A6378"
              },
              "theme": {
                "controlPadding": 3,
                "labelFontSize": 10
              },
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "power_grid_sankey_balance"
                  },
                  "valuePath": "status.reserve"
                }
              ]
            },
            {
              "type": "statusLight",
              "id": "bal-st-ems",
              "position": [
                0,
                3
              ],
              "span": [
                1,
                1
              ],
              "label": "EMS",
              "style": "badge",
              "size": "small",
              "pulse": true,
              "defaultValue": "nominal",
              "statusColors": {
                "nominal": "#3DF5B0",
                "alert": "#FFC247",
                "emergency": "#FF4D6D",
                "offline": "#5A6378"
              },
              "theme": {
                "controlPadding": 3,
                "labelFontSize": 10
              },
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "power_grid_sankey_balance"
                  },
                  "valuePath": "status.ems"
                }
              ]
            }
          ],
          "hideBackground": true
        },
        {
          "type": "sankey",
          "id": "bal-flow",
          "position": [
            1,
            0
          ],
          "span": [
            4,
            4
          ],
          "label": "Generation → Load · MW",
          "tint": "#FFB020",
          "formatValue": "decimal:0",
          "sankeyConfig": {
            "showValues": true,
            "scrub": true,
            "linkOpacity": 0.34,
            "nodeWidth": 8,
            "nodeSpacing": 8,
            "nodeAction": {
              "method": "meshsocket",
              "mode": "broadcast",
              "event": "broadcast_request",
              "payload": {
                "msg_type": "power_grid_sankey_inspect_node",
                "node": "{{value}}"
              }
            }
          },
          "animation": "smooth",
          "defaultValue": "{\"nodes\":[{\"name\":\"Nuclear\",\"color\":\"#9D7BFF\"},{\"name\":\"Gas CC\",\"color\":\"#FF6A3D\"},{\"name\":\"Wind\",\"color\":\"#35E0FF\"},{\"name\":\"Solar\",\"color\":\"#FFD23F\"},{\"name\":\"Hydro\",\"color\":\"#4C9BFF\"},{\"name\":\"Imports\",\"color\":\"#B9B2A0\"},{\"name\":\"North Zone\",\"color\":\"#3DF5B0\"},{\"name\":\"Metro Zone\",\"color\":\"#FFB020\"},{\"name\":\"South Zone\",\"color\":\"#FF8FA3\"},{\"name\":\"Losses\",\"color\":\"#6E6A5E\"}],\"links\":[{\"source\":\"Nuclear\",\"target\":\"Metro Zone\",\"value\":2240},{\"source\":\"Nuclear\",\"target\":\"North Zone\",\"value\":610},{\"source\":\"Gas CC\",\"target\":\"Metro Zone\",\"value\":1880},{\"source\":\"Gas CC\",\"target\":\"South Zone\",\"value\":1120},{\"source\":\"Wind\",\"target\":\"North Zone\",\"value\":1460},{\"source\":\"Wind\",\"target\":\"South Zone\",\"value\":390},{\"source\":\"Solar\",\"target\":\"South Zone\",\"value\":940},{\"source\":\"Solar\",\"target\":\"Metro Zone\",\"value\":520},{\"source\":\"Hydro\",\"target\":\"North Zone\",\"value\":480},{\"source\":\"Imports\",\"target\":\"Metro Zone\",\"value\":730},{\"source\":\"Gas CC\",\"target\":\"Losses\",\"value\":140},{\"source\":\"Nuclear\",\"target\":\"Losses\",\"value\":110},{\"source\":\"Wind\",\"target\":\"Losses\",\"value\":60}]}",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "power_grid_sankey_balance"
              },
              "valuePath": "sankey"
            }
          ]
        },
        {
          "type": "gauge",
          "id": "bal-freq",
          "position": [
            5,
            0
          ],
          "span": [
            3,
            2
          ],
          "label": "System Hz",
          "icon": "waveform.path",
          "min": 59.8,
          "max": 60.2,
          "step": 0.001,
          "formatValue": "decimal:3",
          "arcAngle": 240,
          "arcRotation": 150,
          "tint": "#3DF5B0",
          "colorBlend": 0.3,
          "animation": "snappy",
          "segments": [
            {
              "limit": 59.95,
              "color": "#FF4D6D"
            },
            {
              "limit": 59.98,
              "color": "#FFC247"
            },
            {
              "limit": 60.02,
              "color": "#3DF5B0"
            },
            {
              "limit": 60.05,
              "color": "#FFC247"
            },
            {
              "limit": 60.2,
              "color": "#FF4D6D"
            }
          ],
          "defaultValue": 59.987,
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "power_grid_sankey_balance"
              },
              "valuePath": "freq_hz"
            }
          ]
        },
        {
          "type": "progressRing",
          "id": "bal-reserve",
          "position": [
            5,
            2
          ],
          "span": [
            3,
            2
          ],
          "label": "Spinning reserve",
          "icon": "gauge.with.needle.fill",
          "min": 0,
          "max": 100,
          "formatValue": "percent",
          "tint": "#35E0FF",
          "defaultValue": 64,
          "animation": "smooth",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "power_grid_sankey_balance"
              },
              "valuePath": "reserve_pct"
            }
          ]
        },
        {
          "type": "sparkline",
          "id": "bal-ace",
          "position": [
            8,
            0
          ],
          "span": [
            2,
            2
          ],
          "label": "ACE · MW",
          "tint": "#FFB020",
          "sparklineFill": true,
          "sparklinePoints": 90,
          "defaultValue": -18,
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "power_grid_sankey_balance"
              },
              "valuePath": "ace_mw"
            }
          ]
        },
        {
          "type": "sparkline",
          "id": "bal-load",
          "position": [
            8,
            2
          ],
          "span": [
            2,
            2
          ],
          "label": "System load · MW",
          "tint": "#35E0FF",
          "sparklineFill": true,
          "sparklinePoints": 90,
          "defaultValue": 12260,
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "power_grid_sankey_balance"
              },
              "valuePath": "load_mw"
            }
          ]
        },
        {
          "type": "chart",
          "id": "bal-forecast",
          "position": [
            10,
            0
          ],
          "span": [
            4,
            4
          ],
          "label": "Demand forecast · MW",
          "tint": "#FFB020",
          "formatValue": "decimal:0",
          "chartConfig": {
            "smooth": true,
            "showLegend": true,
            "showGrid": true,
            "lineWidth": 2,
            "scrub": true,
            "maxPoints": 48,
            "datumAction": {
              "method": "meshsocket",
              "mode": "broadcast",
              "event": "broadcast_request",
              "payload": {
                "msg_type": "power_grid_sankey_forecast_pick",
                "datum": "{{value}}"
              }
            }
          },
          "defaultValue": "{\"categories\":[\"06\",\"08\",\"10\",\"12\",\"14\",\"16\",\"18\",\"20\",\"22\"],\"series\":[{\"name\":\"Forecast\",\"type\":\"area\",\"color\":\"#FFB020\",\"values\":[7900,9100,10200,11300,12100,12800,13200,12300,10400]},{\"name\":\"Actual\",\"type\":\"line\",\"color\":\"#35E0FF\",\"values\":[8020,9240,10110,11480,12260]},{\"name\":\"Net of VER\",\"type\":\"line\",\"color\":\"#9D7BFF\",\"values\":[6400,6900,6800,6700,7300,8600,10700,11200,9500]}]}",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "power_grid_sankey_forecast"
              },
              "valuePath": "chart"
            }
          ]
        },
        {
          "type": "label",
          "id": "bal-lmp",
          "position": [
            14,
            0
          ],
          "span": [
            1,
            2
          ],
          "label": "Hub LMP",
          "icon": "dollarsign.circle",
          "formatValue": "suffix: $/MWh",
          "defaultValue": 47.18,
          "sync": [
            {
              "method": "http",
              "source": "iso",
              "path": "/v1/lmp/hub/NORTHSTAR",
              "interval": 60,
              "valuePath": "lmp"
            }
          ]
        },
        {
          "type": "label",
          "id": "bal-peak",
          "position": [
            14,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "Peak ETA",
          "icon": "clock.badge.exclamationmark",
          "defaultValue": "18:00 · 13.2 GW",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "power_grid_sankey_forecast"
              },
              "valuePath": "peak_text"
            }
          ]
        },
        {
          "type": "segmentedControl",
          "id": "bal-mode",
          "position": [
            15,
            0
          ],
          "span": [
            1,
            4
          ],
          "label": "Dispatch posture",
          "style": "pills",
          "tint": "#FFB020",
          "options": [
            "normal",
            "alert",
            "emergency"
          ],
          "optionLabels": [
            "Normal",
            "Alert",
            "EEA"
          ],
          "optionIcons": [
            "checkmark.seal.fill",
            "exclamationmark.triangle.fill",
            "bolt.trianglebadge.exclamationmark.fill"
          ],
          "defaultValue": "normal",
          "haptic": "selection",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "power_grid_sankey_set_posture",
              "posture": "{{value}}"
            }
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "power_grid_sankey_balance"
              },
              "valuePath": "posture"
            }
          ]
        },
        {
          "type": "toggle",
          "id": "bal-conservative",
          "position": [
            16,
            0
          ],
          "span": [
            1,
            2
          ],
          "label": "Conservative ops",
