{
  "name": "Film Post Pipeline",
  "headerTitle": "EMBERFALL \u00b7 POST",
  "version": 1,
  "accentColor": "#FFB000",
  "description": "A VFX post-production command desk for a feature film: an editable shot gantt, a department kanban, a dailies review chat, a lookbook pinboard and a live render-farm view with frame-flow sankey, node heatmap and Deadline log.",
  "difficulty": "expert",
  "keepAwake": true,
  "state": {
    "sync": true,
    "authority": "film-post-hub"
  },
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light",
    "header": {
      "style": "color",
      "dark": [
        "#0B0907",
        "#1A1209"
      ],
      "light": "#F3EBDD"
    }
  },
  "theme": {
    "accentColor": "#FFB000",
    "accentGradient": [
      "#FFB000",
      "#E8893A",
      "#C9653B"
    ],
    "fontDesign": "monospaced",
    "labelFontSize": 11,
    "valueFontSize": 15,
    "valueFontWeight": "bold",
    "cornerRadius": 6,
    "cardPadding": 12,
    "borderWidth": 1,
    "tabBarTint": "#FFB000",
    "toggle": {
      "trackActiveColor": "#FFB000",
      "knobColor": "#0B0907"
    },
    "slider": {
      "trackActiveColor": "#FFB000",
      "thumbColor": "#FFF1C9"
    },
    "segmented": {
      "selectedColor": "#FFB000",
      "selectedTextColor": "#0B0907"
    },
    "dark": {
      "pageBackgroundGradient": [
        "#0B0907",
        "#140E08",
        "#1E140A"
      ],
      "surfacePrimary": "#FFB0000D",
      "surfaceSecondary": "#FFFFFF08",
      "surfaceTertiary": "#00000033",
      "borderColor": "#FFB00033",
      "foregroundColor": "#F6EBD6",
      "secondaryColor": "#B8A68A",
      "tertiaryColor": "#7A6C58",
      "tabBarBackground": "#0B0907F2"
    },
    "light": {
      "pageBackgroundGradient": [
        "#F6EFE3",
        "#EADCC4"
      ],
      "surfacePrimary": "#FFFFFFD9",
      "borderColor": "#6B3A1E26",
      "foregroundColor": "#1E140A",
      "secondaryColor": "#6B5A44",
      "tabBarBackground": "#F6EFE3F2"
    }
  },
  "tabs": [
    {
      "title": "Shots",
      "icon": "film.stack.fill",
      "grid": {
        "columns": 4,
        "rows": 15
      },
      "children": [
        {
          "type": "label",
          "id": "fpp-title",
          "position": [
            0,
            0
          ],
          "span": [
            1,
            4
          ],
          "text": "EMBERFALL \u00b7 Reel 3 \u00b7 VFX Turnover v14",
          "style": "headline",
          "icon": "film",
          "tint": "#FFB000",
          "align": "center",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_post_pipeline_state"
              },
              "valuePath": "title"
            }
          ]
        },
        {
          "type": "progressRing",
          "id": "fpp-final-ring",
          "position": [
            1,
            0
          ],
          "span": [
            3,
            2
          ],
          "label": "Shots finaled",
          "icon": "checkmark.seal.fill",
          "tint": "#FFB000",
          "min": 0,
          "max": 148,
          "defaultValue": 97,
          "animation": "smooth",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_post_pipeline_state"
              },
              "valuePath": "shots_final"
            }
          ]
        },
        {
          "type": "label",
