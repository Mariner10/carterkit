          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_post_pipeline_state"
              },
              "valuePath": "late_banner"
            }
          ]
        }
      ]
    },
