          "tint": "#FFB000",
          "text": "15",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_post_pipeline_state"
              },
              "valuePath": "days_to_lock"
            }
          ]
        },
        {
          "type": "statusLight",
