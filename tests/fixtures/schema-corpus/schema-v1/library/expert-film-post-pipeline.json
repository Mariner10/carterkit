          "pulse": true,
          "defaultValue": "notes",
          "statusColors": {
            "approved": "#46E08C",
            "notes": "#FFB000",
            "hold": "#FF4F3A"
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_post_pipeline_state"
              },
              "valuePath": "client_status"
            }
          ]
        },
        {
          "type": "segmentedControl",
          "id": "fpp-vendor",
          "position": [
            4,
            0
          ],
          "span": [
            1,
            4
          ],
          "options": [
            "all",
            "ilm",
            "dneg",
            "inhouse"
          ],
          "optionLabels": [
            "All",
            "ILM",
            "DNEG",
            "House"
          ],
          "defaultValue": "all",
          "haptic": "selection",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "film_post_pipeline_vendor_filter",
              "vendor": "{{value}}"
            }
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_post_pipeline_state"
              },
              "valuePath": "vendor_filter"
            }
          ]
        },
        {
          "type": "gantt",
          "id": "fpp-shot-gantt",
          "position": [
            5,
            0
          ],
          "span": [
            6,
            4
          ],
          "label": "VFX shot schedule",
          "tint": "#FFB000",
          "ganttConfig": {
            "editable": true,
            "step": 0.05,
            "rowHeight": 28,
            "barCornerRadius": 3,
            "colors": [
              "#FFB000",
              "#E8893A",
              "#C9653B",
              "#9C8F7A"
            ],
            "taskAction": {
              "method": "meshsocket",
              "mode": "broadcast",
              "event": "broadcast_request",
              "payload": {
                "msg_type": "film_post_pipeline_shot_progress",
                "shot": "{{value}}"
              }
            }
          },
          "defaultValue": "[{\"name\":\"EMB_010 fire\",\"start\":\"2026-09-14\",\"end\":\"2026-09-22\",\"progress\":1.0,\"color\":\"#FFB000\"},{\"name\":\"EMB_020 smoke\",\"start\":\"2026-09-16\",\"end\":\"2026-09-26\",\"progress\":0.82},{\"name\":\"EMB_045 matte\",\"start\":\"2026-09-18\",\"end\":\"2026-10-01\",\"progress\":0.55},{\"name\":\"EMB_060 sky rep\",\"start\":\"2026-09-20\",\"end\":\"2026-09-29\",\"progress\":0.7},{\"name\":\"EMB_075 crowd\",\"start\":\"2026-09-22\",\"end\":\"2026-10-06\",\"progress\":0.28,\"color\":\"#FF4F3A\"},{\"name\":\"EMB_090 wire rm\",\"start\":\"2026-09-23\",\"end\":\"2026-09-27\",\"progress\":0.9},{\"name\":\"EMB_110 CG car\",\"start\":\"2026-09-19\",\"end\":\"2026-10-08\",\"progress\":0.36},{\"name\":\"EMB_130 dehaze\",\"start\":\"2026-09-25\",\"end\":\"2026-10-02\",\"progress\":0.1},{\"name\":\"Client review\",\"start\":\"2026-09-30\",\"milestone\":true},{\"name\":\"Picture lock\",\"start\":\"2026-10-09\",\"milestone\":true}]",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_post_pipeline_shots"
              },
              "valuePath": "tasks"
            }
          ]
        },
        {
          "type": "gauge",
          "id": "fpp-overage",
          "position": [
            11,
            0
          ],
          "span": [
            3,
            2
          ],
          "label": "Overtime hrs",
          "icon": "clock.badge.exclamationmark",
          "min": 0,
          "max": 400,
          "arcAngle": 270,
          "arcRotation": 135,
          "tint": "#FFB000",
          "defaultValue": 212,
          "segments": [
            {
              "limit": 200,
              "color": "#46E08C"
            },
            {
              "limit": 320,
              "color": "#FFB000"
            },
            {
              "limit": 400,
              "color": "#FF4F3A"
            }
          ],
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_post_pipeline_state"
              },
              "valuePath": "overtime_hours"
            }
          ]
        },
        {
          "type": "sparkline",
          "id": "fpp-finals-trend",
          "position": [
            11,
            2
          ],
          "span": [
            2,
            2
          ],
          "label": "Finals / day",
          "tint": "#FFB000",
          "sparklinePoints": 14,
          "sparklineFill": true,
          "defaultValue": [
            3,
            5,
            4,
            6,
            8,
            7,
            9,
            6,
            11,
            10,
            12,
            9,
            13,
            14
          ],
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_post_pipeline_state"
              },
              "valuePath": "finals_today"
            }
          ]
        },
        {
          "type": "statusLight",
          "id": "fpp-dcp",
          "position": [
            13,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "DCP QC",
          "defaultValue": "pending",
          "statusColors": {
            "passed": "#46E08C",
            "pending": "#9C8F7A",
            "failed": "#FF4F3A"
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "film_post_pipeline_state"
              },
              "valuePath": "dcp_qc"
            }
          ]
        },
        {
          "type": "label",
          "id": "fpp-late-banner",
          "position": [
            14,
            0
          ],
          "span": [
            1,
            4
          ],
          "text": "3 shots past vendor due date \u2014 escalate",
          "style": "caption",
          "icon": "exclamationmark.triangle.fill",
          "tint": "#FF4F3A",
          "align": "center",
          "visible": {
            "when": "fpp-overage",
            "operator": "gt",
            "value": 300
