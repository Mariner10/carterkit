{
  "name": "Data Center Racks",
  "headerTitle": "ASH-1 · HALL 2",
  "version": 1,
  "accentColor": "#5CC8FF",
  "description": "Hall-level DCIM console for a colocation data center: rack inlet heatmap, dual-feed PDU gauges, per-rack flip cards and a live alert board, fed by an MQTT BMS broker plus a MeshSocket hub.",
