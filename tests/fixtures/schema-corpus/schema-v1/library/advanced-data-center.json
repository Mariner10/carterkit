  "keepAwake": true,
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light"
  },
  "sources": {
    "dcim": {
      "type": "mqtt",
      "url": "mqtt://10.40.0.12:1883",
      "username": "carter-ro",
      "clientId": "carter-hall2-panel"
    }
  },
