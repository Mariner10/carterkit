    "accentGradient": [
      "#5CC8FF",
      "#B48CFF",
      "#3EE08F"
    ],
    "fontDesign": "monospaced",
    "cornerRadius": 14,
    "cardPadding": 12,
    "controlPadding": 8,
    "borderWidth": 0.5,
    "labelFontSize": 11,
    "valueFontSize": 15,
    "valueFontWeight": "semibold",
