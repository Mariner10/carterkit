{
  "name": "Amperline Charge Network",
  "headerTitle": "AMPERLINE · BAY",
  "version": 1,
  "accentColor": "#3CF0A0",
  "description": "Operator console for a 7-site Bay Area DC fast-charging network: live charger map, hourly occupancy heatmap, flip-to-manage station cards, session revenue distribution and tariff controls.",
  "difficulty": "advanced",
  "keepAwake": true,
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light"
  },
  "theme": {
    "accentColor": "#3CF0A0",
    "accentGradient": [
      "#3CF0A0",
      "#19C3FF"
    ],
    "fontDesign": "rounded",
    "cornerRadius": 16,
    "cardPadding": 12,
    "controlPadding": 8,
    "borderWidth": 0.5,
    "labelFontSize": 12,
    "valueFontSize": 15,
    "valueFontWeight": "semibold",
    "tabBarTint": "#3CF0A0",
    "pageBackgroundGradient": [
      "#050D14",
      "#0A1C2A",
      "#0D2A2E"
    ],
    "surfacePrimary": "#3CF0A012",
    "surfaceSecondary": "#19C3FF0C",
    "surfaceTertiary": "#19C3FF06",
    "foregroundColor": "#EAF7F2",
    "secondaryColor": "#9DB8C4",
    "tertiaryColor": "#5F7A86",
    "borderColor": "#3CF0A02E",
    "toggle": {
      "trackActiveColor": "#FF5470",
      "knobColor": "#EAF7F2",
      "knobShadow": true
    },
    "slider": {
      "trackActiveColor": "#3CF0A0",
      "thumbColor": "#EAF7F2"
    },
    "segmented": {
      "trackColor": "#3CF0A014",
      "selectedColor": "#3CF0A0",
      "textColor": "#9DB8C4",
      "selectedTextColor": "#050D14"
    }
