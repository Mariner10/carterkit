{
  "name": "Concert Lighting Rig",
  "headerTitle": "AURORA · LX",
  "version": 1,
  "accentColor": "#FF3DAE",
  "description": "A touring lighting desk: blackout and grand master with a BPM-synced strobe on Stage, color and intensity per fixture group, a GO-driven cue stack, and an audio-reactive 16-step chase.",
  "difficulty": "advanced",
  "keepAwake": true,
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light"
  },
  "theme": {
    "accentColor": "#FF3DAE",
    "accentGradient": [
      "#FF3DAE",
      "#7A3DFF",
      "#3DD9FF"
    ],
    "fontDesign": "rounded",
    "labelFontSize": 12,
    "valueFontSize": 15,
    "valueFontWeight": "bold",
    "cornerRadius": 18,
    "cardPadding": 12,
    "borderWidth": 0.5,
    "tabBarTint": "#FF3DAE",
    "pageBackgroundGradient": [
      "#05030A",
      "#120622",
      "#1B0830"
    ],
    "surfacePrimary": "#FF3DAE12",
    "surfaceSecondary": "#7A3DFF0E",
    "surfaceTertiary": "#3DD9FF0A",
    "borderColor": "#FF3DAE33",
    "foregroundColor": "#F7F2FF",
    "secondaryColor": "#B7A6D6",
    "tertiaryColor": "#7D6E9A",
    "toggle": {
      "trackActiveColor": "#FF3DAE",
      "knobColor": "#FFFFFF"
    },
    "slider": {
      "trackActiveColor": "#FF3DAE",
      "thumbColor": "#FFFFFF"
    },
    "segmented": {
      "selectedColor": "#FF3DAE",
      "selectedTextColor": "#FFFFFF"
    }
  },
  "tabs": [
    {
      "title": "Stage",
      "icon": "light.beacon.max.fill",
      "grid": {
        "columns": 4,
        "rows": 10
      },
      "children": [
        {
          "type": "label",
          "id": "cl-show",
          "position": [
            0,
            0
          ],
          "span": [
            1,
            4
          ],
          "text": "Aurora Tour · Night 14 — Red Rocks",
          "style": "headline",
          "icon": "music.mic",
          "tint": "#FF3DAE",
          "align": "center",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "concert_lighting_state"
              },
              "valuePath": "show"
            }
          ]
        },
        {
          "type": "symbol",
          "id": "cl-strobe-glyph",
          "position": [
            1,
            0
          ],
          "span": [
            3,
            2
          ],
          "systemName": "light.beacon.max.fill",
          "label": "Strobe",
          "tint": "#F5F7FF",
          "defaultValue": true,
          "haptic": "rigid",
          "symbolConfig": {
            "renderingMode": "hierarchical",
            "weight": "semibold",
            "effect": "variableColor",
            "effectOptions": [
              "iterative",
              "dimInactiveLayers"
            ],
            "speed": 2.6,
            "activeWhen": "truthy",
            "tapEffect": "bounce",
            "triggers": [
              {
                "event": "broadcast",
                "filter": {
                  "msg_type": "concert_lighting_beat",
                  "downbeat": true
                },
                "effect": "bounce"
              }
            ]
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "concert_lighting_state"
              },
              "valuePath": "strobe_on"
            }
          ],
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "concert_lighting_strobe_hit",
              "fixture": "{{value}}"
            }
          }
        },
        {
          "type": "label",
          "id": "cl-bpm",
          "position": [
            1,
            2
          ],
          "span": [
            2,
            2
          ],
          "label": "Clock BPM",
          "icon": "metronome.fill",
          "style": "large-mono",
          "tint": "#FF3DAE",
          "text": "128.0",
          "formatValue": "decimal:1",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "concert_lighting_state"
              },
              "valuePath": "bpm"
            }
          ]
        },
        {
          "type": "statusLight",
          "id": "cl-dmx",
          "position": [
            3,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "DMX · 4 universes",
          "style": "badge",
          "pulse": true,
          "defaultValue": "live",
          "statusColors": {
            "live": "#34E0A1",
            "degraded": "#FFB020",
            "lost": "#FF3B5C"
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "concert_lighting_state"
              },
              "valuePath": "dmx"
            }
          ]
        },
        {
          "type": "toggle",
          "id": "cl-blackout",
          "position": [
            4,
            0
          ],
          "span": [
            1,
            2
          ],
          "label": "Blackout",
          "style": "button",
          "onIcon": "lightbulb.slash.fill",
          "offIcon": "lightbulb.fill",
          "tint": "#FF3B5C",
          "defaultValue": false,
          "haptic": "heavy",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "concert_lighting_blackout",
              "on": "{{value}}"
            }
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "concert_lighting_state"
              },
              "valuePath": "blackout"
            }
          ]
        },
        {
          "type": "slider",
          "id": "cl-grandmaster",
          "position": [
            4,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "Grand master",
          "min": 0,
          "max": 100,
          "step": 1,
          "defaultValue": 86,
          "formatValue": "percent",
          "minIcon": "sun.min",
          "maxIcon": "sun.max.fill",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "concert_lighting_grandmaster",
              "level": "{{value}}"
            }
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "concert_lighting_state"
              },
              "valuePath": "grandmaster"
            }
          ]
        },
        {
          "type": "label",
          "id": "cl-blackout-banner",
          "position": [
            5,
            0
          ],
          "span": [
            1,
            4
          ],
          "text": "BLACKOUT ENGAGED — all fixtures at 0%",
          "style": "headline",
          "icon": "exclamationmark.octagon.fill",
          "tint": "#FF3B5C",
          "align": "center",
          "visible": {
            "when": "cl-blackout",
            "operator": "eq",
            "value": true
          }
        },
        {
          "type": "group",
          "id": "cl-strobe-grp",
          "label": "Strobe & FX",
          "position": [
            6,
            0
          ],
          "span": [
            3,
            4
          ],
          "grid": {
            "columns": 4,
            "rows": 2
          },
          "children": [
            {
              "type": "slider",
              "id": "cl-strobe-rate",
              "position": [
                0,
                0
              ],
              "span": [
                1,
                4
              ],
              "label": "Strobe rate (Hz)",
              "min": 1,
              "max": 25,
              "step": 0.5,
              "defaultValue": 12,
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "concert_lighting_strobe_rate",
                  "hz": "{{value}}"
                }
              },
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "concert_lighting_state"
                  },
                  "valuePath": "strobe_hz"
                }
              ]
            },
            {
              "type": "toggle",
              "id": "cl-strobe-arm",
              "position": [
                1,
                0
              ],
              "span": [
                1,
                2
              ],
              "label": "Arm strobe",
              "icon": "bolt.fill",
              "defaultValue": true,
              "haptic": "warning",
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "concert_lighting_strobe_arm",
                  "armed": "{{value}}"
                }
              },
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "concert_lighting_state"
                  },
                  "valuePath": "strobe_on"
                }
              ]
            },
            {
              "type": "segmentedControl",
              "id": "cl-strobe-pattern",
              "position": [
                1,
                2
              ],
              "span": [
                1,
                2
              ],
              "options": [
                "sync",
                "rand",
                "ramp"
              ],
              "optionLabels": [
                "Sync",
                "Rand",
                "Ramp"
              ],
              "defaultValue": "sync",
              "action": {
                "method": "meshsocket",
                "mode": "broadcast",
                "event": "broadcast_request",
                "payload": {
                  "msg_type": "concert_lighting_strobe_pattern",
                  "pattern": "{{value}}"
                }
              }
            }
          ],
          "visible": {
            "when": "cl-blackout",
            "operator": "eq",
            "value": false
          }
        },
        {
          "type": "button",
          "id": "cl-tap",
          "position": [
            9,
            0
          ],
          "span": [
            1,
            2
          ],
          "label": "Tap tempo",
          "icon": "hand.tap.fill",
          "style": "tinted",
          "haptic": "medium",
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "concert_lighting_tap_tempo"
            }
          }
        },
        {
          "type": "toggle",
          "id": "cl-bpm-sync",
          "position": [
            9,
            2
          ],
          "span": [
            1,
            2
          ],
          "label": "BPM sync",
          "icon": "waveform.path",
          "defaultValue": true,
          "action": {
            "method": "meshsocket",
            "mode": "broadcast",
            "event": "broadcast_request",
            "payload": {
              "msg_type": "concert_lighting_bpm_sync",
              "enabled": "{{value}}"
            }
          },
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "concert_lighting_state"
              },
              "valuePath": "bpm_sync"
            }
          ]
        }
      ]
    },
