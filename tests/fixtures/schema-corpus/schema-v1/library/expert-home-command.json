{
 "name": "Home Command",
 "id": "home-command-expert",
 "headerTitle": "JUNIPER LN · HOME",
 "version": 1,
 "accentColor": "#FF8A4C",
 "description": "A wall-panel command center for a whole house: a live floorplan of working device cards, room groups the hub rewrites on the fly, an energy sankey, porch camera and PTZ, and a family chat — with presence streamed from the panel itself.",
 "difficulty": "expert",
 "keepAwake": true,
 "batchPublishers": true,
 "state": {
  "sync": true,
  "authority": "home-command-hub",
  "acks": true,
  "ackTimeoutMs": 2500
 },
 "publishers": [
  {
   "sensor": "device",
   "interval": 60
  },
  {
   "sensor": "audio",
   "interval": 5
  },
  {
   "sensor": "location",
   "interval": 120
  }
 ],
 "sources": {
  "weather": {
   "type": "http",
   "baseURL": "https://api.open-meteo.com/v1",
   "interval": 600
  }
 },
 "appearance": {
  "colorScheme": "dark",
  "statusBarStyle": "light",
  "showHeader": true,
  "header": {
   "style": "color",
   "dark": [
    "#0A1633",
    "#0F1F45"
   ],
   "light": [
    "#0A1633",
    "#0F1F45"
   ]
  }
 },
 "theme": {
  "accentColor": "#FF8A4C",
  "accentGradient": [
   "#FF8A4C",
   "#FFD166"
  ],
  "fontDesign": "rounded",
  "cornerRadius": 14,
  "borderWidth": 1,
  "cardPadding": 12,
  "controlPadding": 8,
  "labelFontSize": 11,
  "valueFontSize": 16,
  "valueFontWeight": "semibold",
  "blurEnabled": true,
  "tabBarTint": "#FF8A4C",
  "tabBarBackground": "#0A1633F0",
  "pageBackgroundGradient": [
   "#081230",
   "#0E1D44",
   "#132652"
  ],
  "surfacePrimary": "#E8EEFF12",
  "surfaceSecondary": "#E8EEFF0A",
  "surfaceTertiary": "#E8EEFF06",
  "foregroundColor": "#EEF3FF",
  "secondaryColor": "#A9B8DC",
  "tertiaryColor": "#6F80A8",
  "borderColor": "#9FB6FF2E",
  "toggle": {
   "trackActiveColor": "#FF8A4C",
   "knobColor": "#EEF3FF",
   "knobShadow": true
  },
  "slider": {
   "trackActiveColor": "#FF8A4C",
   "thumbColor": "#EEF3FF"
  },
  "segmented": {
   "trackColor": "#9FB6FF14",
   "selectedColor": "#FF8A4C",
   "textColor": "#A9B8DC",
   "selectedTextColor": "#081230"
  },
  "progressBar": {
   "trackColor": "#9FB6FF1A",
   "trackActiveColor": "#FF8A4C"
  }
 },
 "glance": {
  "title": "Juniper Ln",
  "icon": "house.lodge.fill",
  "tint": "#FF8A4C",
  "hero": "hc-battery",
  "slots": [
   "hc-grid-kw",
   "hc-alarm",
   "hc-p-maya"
  ],
  "liveActivity": true,
  "live": {
   "tier": "fresh",
   "activity": {
    "stale": 120
   }
  },
  "controls": [
   {
    "id": "arm",
    "kind": "toggle",
    "label": "Arm system",
    "icon": "shield.checkered",
    "control": "hc-arm"
   },
   {
    "id": "mode",
    "kind": "cycle",
    "label": "Home mode",
    "control": "hc-mode",
    "states": [
     {
      "value": "home",
      "label": "Home",
      "icon": "house.fill",
      "tint": "#7BE0A6"
     },
     {
      "value": "away",
      "label": "Away",
      "icon": "figure.walk.departure",
      "tint": "#8FA9FF"
     },
     {
      "value": "night",
      "label": "Night",
      "icon": "moon.stars.fill",
      "tint": "#C9B8FF"
     }
    ]
   },
   {
    "id": "alloff",
    "kind": "button",
    "label": "Everything off",
    "icon": "power",
    "control": "hc-sc-alloff"
   }
  ],
  "widgets": [
   {
    "id": "energy",
    "title": "Energy",
    "icon": "bolt.house.fill",
    "families": [
     "systemSmall",
     "systemMedium",
     "accessoryRectangular"
    ],
    "scene": {
     "rows": [
      [
       {
        "tile": "ring",
        "control": "hc-battery"
       },
       {
        "tile": "gauge",
        "control": "hc-grid-kw"
       }
      ],
      [
       {
        "tile": "sparkline",
        "control": "hc-solar",
        "span": 2
       }
      ],
      [
       {
        "tile": "light",
        "control": "hc-alarm"
       },
       {
        "tile": "toggle",
        "control": "hc-arm"
       }
      ]
     ]
    }
   }
  ],
  "island": {
   "compactLeading": {
    "tile": "icon",
    "effect": "pulse"
   },
   "compactTrailing": {
    "tile": "ring",
    "control": "hc-battery"
   },
   "minimal": {
    "tile": "light",
    "control": "hc-alarm"
   },
   "expanded": {
    "leading": {
     "tile": "icon"
    },
    "trailing": {
     "tile": "freshness"
    },
    "center": {
     "tile": "value",
     "control": "hc-grid-kw",
     "label": "Grid"
    },
    "bottom": {
     "rows": [
      [
       {
        "tile": "light",
        "control": "hc-p-maya"
       },
       {
        "tile": "light",
        "control": "hc-d-patio"
       },
       {
        "tile": "ring",
        "control": "hc-battery"
       }
      ],
      [
       {
        "tile": "toggle",
        "control": "hc-arm"
       },
       {
        "tile": "button",
        "control": "hc-sc-alloff"
       }
      ]
     ]
    }
   }
  }
 },
