              "#2EE6C5"
            ],
            "effect": "bounce",
            "effectOptions": [
              "up",
              "byLayer"
            ],
            "loop": "periodic",
            "loopDelay": 2.5,
            "activeWhen": "truthy",
            "tapEffect": "wiggle",
            "triggers": [
              {
                "event": "broadcast",
                "filter": {
                  "msg_type": "fleet_dispatch_alert"
                },
                "effect": "wiggle"
