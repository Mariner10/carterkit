                "ok": "#2EE6C5",
                "busy": "#FFC145",
                "degraded": "#FFC145",
                "down": "#FF5A5F",
                "idle": "#6FA8FF"
              },
              "theme": {
                "controlPadding": 3,
                "labelFontSize": 11
              },
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "fleet_dispatch_health"
                  },
                  "valuePath": "routing"
