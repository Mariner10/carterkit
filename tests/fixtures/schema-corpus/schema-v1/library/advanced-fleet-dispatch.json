{
  "name": "Fleet Dispatch",
  "headerTitle": "DISPATCH \u00b7 SEA",
  "version": 1,
  "accentColor": "#FF8A3D",
  "description": "Live dispatch board for a 28-van last-mile delivery fleet: map, driver roster, on-time KPIs, hourly demand heatmap and one-tap dispatch actions.",
  "difficulty": "advanced",
  "keepAwake": true,
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light"
  },
  "theme": {
    "accentColor": "#FF8A3D",
    "accentGradient": [
      "#FF8A3D",
      "#FF5A5F",
      "#2EE6C5"
    ],
    "fontDesign": "rounded",
    "cornerRadius": 18,
    "cardPadding": 12,
    "controlPadding": 8,
    "borderWidth": 0.5,
    "labelFontSize": 12,
    "valueFontSize": 15,
    "valueFontWeight": "semibold",
    "tabBarTint": "#FF8A3D",
    "pageBackgroundGradient": [
      "#0B0F1A",
      "#141B2D",
      "#1D1A24"
    ],
    "surfacePrimary": "#FFB38A14",
    "surfaceSecondary": "#FFB38A0C",
    "surfaceTertiary": "#FFB38A06",
    "foregroundColor": "#F4F1EC",
    "secondaryColor": "#B9B3AA",
    "tertiaryColor": "#7A746C",
    "borderColor": "#FFB38A30",
    "toggle": {
      "trackActiveColor": "#2EE6C5",
      "knobColor": "#F4F1EC",
      "knobShadow": true
    },
    "segmented": {
      "trackColor": "#FFB38A14",
      "selectedColor": "#FF8A3D",
      "textColor": "#B9B3AA",
      "selectedTextColor": "#0B0F1A"
    }
  },
  "tabs": [
    {
      "title": "Live",
      "icon": "map.fill",
      "grid": {
        "columns": 4,
        "rows": 13
      },
      "children": [
        {
          "type": "group",
          "id": "hq-health",
          "position": [
            0,
            0
          ],
          "span": [
            1,
            4
          ],
          "hideBackground": true,
          "grid": {
            "columns": 4,
            "rows": 1
          },
          "children": [
            {
              "type": "statusLight",
              "id": "hq-depot",
              "position": [
                0,
                0
              ],
              "label": "Depot",
              "style": "badge",
              "size": "small",
              "pulse": true,
              "defaultValue": "ok",
              "statusColors": {
                "ok": "#2EE6C5",
                "busy": "#FFC145",
                "degraded": "#FFC145",
                "down": "#FF5A5F",
                "idle": "#6FA8FF"
              },
              "theme": {
                "controlPadding": 3,
                "labelFontSize": 11
              },
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "fleet_dispatch_health"
                  },
                  "valuePath": "depot"
                }
              ]
            },
            {
              "type": "statusLight",
              "id": "hq-telematics",
              "position": [
                0,
                1
              ],
              "label": "GPS",
              "style": "badge",
              "size": "small",
              "pulse": true,
              "defaultValue": "ok",
              "statusColors": {
                "ok": "#2EE6C5",
                "busy": "#FFC145",
                "degraded": "#FFC145",
                "down": "#FF5A5F",
                "idle": "#6FA8FF"
              },
              "theme": {
                "controlPadding": 3,
                "labelFontSize": 11
              },
              "sync": [
                {
                  "method": "meshsocket",
                  "type": "listen",
                  "event": "broadcast",
                  "filter": {
                    "msg_type": "fleet_dispatch_health"
