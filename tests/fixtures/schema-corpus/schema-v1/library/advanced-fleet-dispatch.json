          "mapStyle": "standard",
          "mapZoom": 0.2,
          "tint": "#2EE6C5",
          "defaultValue": "{\"markers\":[{\"coordinate\":[47.5801,-122.3352],\"color\":\"#FF8A3D\",\"size\":18,\"label\":\"SODO Depot\"},{\"coordinate\":[47.6205,-122.3493],\"color\":\"#2EE6C5\",\"size\":13,\"label\":\"Van 07 \\u00b7 Priya\"},{\"coordinate\":[47.6615,-122.313],\"color\":\"#2EE6C5\",\"size\":13,\"label\":\"Van 12 \\u00b7 Marcus\"},{\"coordinate\":[47.6097,-122.2015],\"color\":\"#2EE6C5\",\"size\":13,\"label\":\"Van 03 \\u00b7 Lena\"},{\"coordinate\":[47.548,-122.386],\"color\":\"#FFC145\",\"size\":14,\"label\":\"Van 19 \\u00b7 Diego (+14m)\"},{\"coordinate\":[47.687,-122.377],\"color\":\"#2EE6C5\",\"size\":13,\"label\":\"Van 22 \\u00b7 Hana\"},{\"coordinate\":[47.521,-122.275],\"color\":\"#FF5A5F\",\"size\":18,\"label\":\"Van 15 \\u00b7 stalled\",\"ripple\":{\"color\":\"#FF5A5F\",\"period\":1.4,\"radius\":56}}],\"paths\":[{\"points\":[[47.5801,-122.3352],[47.599,-122.332],[47.6205,-122.3493]],\"color\":\"#2EE6C5\"},{\"points\":[[47.5801,-122.3352],[47.565,-122.37],[47.548,-122.386]],\"color\":\"#FFC145\"}]}",
          "sync": [
            {
              "method": "meshsocket",
              "type": "listen",
              "event": "broadcast",
              "filter": {
                "msg_type": "fleet_dispatch_positions"
              },
              "valuePath": "map"
