{
 "name": "Mission Control",
 "id": "mission-control-expert",
 "headerTitle": "ARGO-3 · FLIGHT",
 "version": 1,
 "accentColor": "#FFB000",
 "description": "A flight-director console for the ARGO-3 orbital mission: live ground track, a phosphor telemetry wall, subsystem and power topology, an editable flight plan, and the flight loop — with a T-minus Live Activity when you leave the app.",
 "difficulty": "expert",
 "keepAwake": true,
 "batchPublishers": true,
 "state": {
  "sync": true,
  "authority": "mission-control-hub",
  "acks": true,
  "ackTimeoutMs": 2500
 },
 "publishers": [
  {
   "sensor": "device",
   "interval": 30
  },
  {
   "sensor": "location",
   "interval": 60
  }
 ],
 "sources": {
  "iss": {
   "type": "http",
   "baseURL": "https://api.wheretheiss.at/v1",
   "interval": 10
  }
 },
 "appearance": {
  "colorScheme": "dark",
  "statusBarStyle": "light",
  "showHeader": true,
  "header": {
   "style": "color",
   "dark": [
    "#0B0906",
    "#15110A"
   ],
   "light": [
    "#0B0906",
    "#15110A"
   ]
  }
 },
 "theme": {
  "accentColor": "#FFB000",
  "accentGradient": [
   "#FFB000",
   "#FF7A1A"
  ],
  "fontDesign": "monospaced",
  "cornerRadius": 6,
  "borderWidth": 1,
  "cardPadding": 12,
  "controlPadding": 8,
  "labelFontSize": 11,
  "valueFontSize": 15,
  "valueFontWeight": "medium",
  "blurEnabled": false,
  "tabBarTint": "#FFB000",
  "pageBackgroundGradient": [
   "#070604",
   "#0E0B07",
   "#161008"
  ],
  "surfacePrimary": "#FFB0000D",
  "surfaceSecondary": "#FFB00008",
  "surfaceTertiary": "#FFB00005",
  "foregroundColor": "#FFE7B8",
  "secondaryColor": "#C9A86A",
  "tertiaryColor": "#8A7A55",
  "borderColor": "#FFB00033",
  "tabBarBackground": "#0B0906F2",
  "toggle": {
   "trackActiveColor": "#FF4A3D",
   "knobColor": "#FFE7B8",
   "knobShadow": false
  },
  "slider": {
   "trackActiveColor": "#FFB000",
   "thumbColor": "#FFE7B8"
  },
  "segmented": {
   "trackColor": "#FFB00014",
   "selectedColor": "#FFB000",
   "textColor": "#C9A86A",
   "selectedTextColor": "#0B0906"
  },
  "progressBar": {
   "trackColor": "#FFB0001A",
   "trackActiveColor": "#FFB000"
  }
 },
 "glance": {
  "title": "ARGO-3",
  "icon": "globe.americas.fill",
  "tint": "#FFB000",
  "hero": "mc-alt",
  "slots": [
   "mc-vel",
   "mc-prop",
   "mc-comm"
  ],
  "liveActivity": true,
  "live": {
   "tier": "fresh",
   "activity": {
    "stale": 90
   }
  },
  "controls": [
   {
    "id": "hold",
    "kind": "button",
    "label": "Call hold",
    "icon": "pause.circle.fill",
    "control": "mc-hold"
   },
   {
    "id": "rcs",
    "kind": "cycle",
    "label": "RCS mode",
    "control": "mc-rcs-mode",
    "states": [
     {
      "value": "auto",
      "label": "Auto",
      "icon": "gyroscope",
      "tint": "#4FE0D2"
     },
     {
      "value": "manual",
      "label": "Manual",
      "icon": "hand.raised.fill",
      "tint": "#FFB000"
     }
    ]
   }
  ],
  "widgets": [
   {
    "id": "orbit",
    "title": "Orbit",
    "icon": "globe.americas.fill",
    "families": [
     "systemSmall",
     "systemMedium",
     "accessoryRectangular"
    ],
    "scene": {
     "rows": [
      [
       {
        "tile": "gauge",
        "control": "mc-alt"
       },
       {
        "tile": "ring",
        "control": "mc-prop"
       }
      ],
      [
       {
        "tile": "sparkline",
        "control": "mc-alt",
        "span": 2
       }
      ],
      [
       {
        "tile": "light",
        "control": "mc-comm"
       },
       {
        "tile": "timer",
        "control": "mc-burn-epoch",
        "label": "TIG"
       }
      ]
     ]
    }
   }
  ],
  "island": {
   "compactLeading": {
    "tile": "icon",
    "effect": "pulse"
   },
   "compactTrailing": {
    "tile": "timer",
    "control": "mc-burn-epoch"
   },
   "minimal": {
    "tile": "light",
    "control": "mc-gnc"
   },
   "expanded": {
    "leading": {
     "tile": "icon"
    },
    "trailing": {
     "tile": "freshness"
    },
    "center": {
     "tile": "timer",
     "control": "mc-burn-epoch",
     "label": "T-minus OMS-2"
    },
    "bottom": {
     "rows": [
      [
       {
        "tile": "value",
        "control": "mc-alt"
       },
       {
        "tile": "value",
        "control": "mc-vel"
       },
       {
        "tile": "ring",
        "control": "mc-prop"
       }
      ],
      [
       {
        "tile": "button",
        "control": "mc-go-poll"
       },
       {
        "tile": "button",
        "control": "mc-hold"
       }
      ]
     ]
    }
   }
  }
 },
