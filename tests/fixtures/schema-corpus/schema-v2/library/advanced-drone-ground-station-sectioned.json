        "event": "broadcast_request",
        "method": "meshsocket",
        "mode": "broadcast",
        "payload": {
          "msg_type": "drone_ground_station_mission_start",
          "plan": "survey_b"
        }
      }
    },
    "dgs-takeoff": {
      "action": {
        "event": "broadcast_request",
        "method": "meshsocket",
        "mode": "broadcast",
        "payload": {
