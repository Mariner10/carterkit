{
  "accentColor": "#00E5FF",
  "appearance": {
    "colorScheme": "dark",
    "statusBarStyle": "light"
  },
  "connectivity": {
    "dgs-alt": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "drone_ground_station_telemetry"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "alt_agl"
        }
      ]
    },
    "dgs-arm": {
      "action": {
        "event": "broadcast_request",
        "method": "meshsocket",
        "mode": "broadcast",
        "payload": {
          "armed": "{{value}}",
          "msg_type": "drone_ground_station_arm"
        }
      },
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "drone_ground_station_state"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "armed"
        }
      ]
    },
    "dgs-armstate": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "drone_ground_station_state"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "vehicle"
        }
      ]
    },
    "dgs-batt": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "drone_ground_station_telemetry"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "battery_pct"
        }
      ]
    },
    "dgs-compass": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "drone_ground_station_attitude"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "heading_deg"
        }
      ]
    },
    "dgs-cruise": {
      "action": {
        "event": "broadcast_request",
        "method": "meshsocket",
        "mode": "broadcast",
        "payload": {
          "mps": "{{value}}",
          "msg_type": "drone_ground_station_set_speed"
        }
      }
    },
    "dgs-fix": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "drone_ground_station_gps"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "fix"
        }
      ]
    },
    "dgs-geofence": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "drone_ground_station_link"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "geofence"
        }
      ]
    },
    "dgs-hdop": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "drone_ground_station_gps"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "hdop"
        }
      ]
    },
    "dgs-kill": {
      "action": {
        "event": "broadcast_request",
        "method": "meshsocket",
        "mode": "broadcast",
        "payload": {
          "confirm": true,
          "msg_type": "drone_ground_station_kill"
        }
      }
    },
    "dgs-land": {
      "action": {
        "event": "broadcast_request",
        "method": "meshsocket",
        "mode": "broadcast",
        "payload": {
          "msg_type": "drone_ground_station_land"
        }
      }
    },
    "dgs-log": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "drone_ground_station_log"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "line"
