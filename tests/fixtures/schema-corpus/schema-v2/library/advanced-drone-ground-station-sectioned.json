          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "current_a"
        }
      ]
    },
    "dgs-sp-rssi": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "drone_ground_station_link"
          },
          "method": "meshsocket",
