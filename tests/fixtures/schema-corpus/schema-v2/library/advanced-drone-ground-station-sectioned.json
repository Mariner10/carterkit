    "dgs-m1": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "drone_ground_station_motors"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "m1_temp_pct"
