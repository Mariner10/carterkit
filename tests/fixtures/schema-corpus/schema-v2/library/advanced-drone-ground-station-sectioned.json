      "action": {
        "event": "broadcast_request",
        "method": "meshsocket",
        "mode": "broadcast",
        "payload": {
          "mode": "{{value}}",
          "msg_type": "drone_ground_station_set_mode"
        }
      },
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "drone_ground_station_state"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "mode"
        }
      ]
    },
    "dgs-rc": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
