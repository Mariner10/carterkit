{
  "accentColor": "#667eea",
  "appearance": {
    "colorScheme": "dark",
    "showHeader": true,
    "statusBarStyle": "light"
  },
  "connectivity": {
    "lab-energy": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "lab_energy"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "sankey"
        }
      ]
    },
    "lab-eq": {
      "action": {
        "event": "broadcast_request",
        "method": "meshsocket",
        "mode": "broadcast",
        "payload": {
          "bands": "{{value}}",
          "msg_type": "lab_eq"
        }
      }
    },
    "lab-histogram": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "lab_histo"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "samples"
        }
      ]
    },
    "lab-latency": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "lab_latency"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "regions"
        }
      ]
    },
    "lab-mesh": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "lab_mesh"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "chord"
        }
      ]
    },
    "lab-poll": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "lab_poll"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "results"
        }
      ]
    },
    "lab-power": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "lab_power"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "split"
        }
      ]
    },
    "lab-sprint": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "lab_sprint"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "gantt"
        }
      ]
    },
    "lab-telemetry": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "lab_telemetry"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "chart"
        }
      ]
    },
    "lab-temps": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "lab_temps"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "grid"
        }
      ]
    }
