{
  "accentColor": "#FF9500",
  "appearance": {
    "colorScheme": "dark"
  },
  "connectivity": {
    "atlas-board": {
      "action": {
        "event": "broadcast_request",
        "method": "meshsocket",
        "mode": "broadcast",
        "payload": {
          "from": "{{from}}",
          "index": "{{index}}",
          "item": "{{item}}",
          "msg_type": "atlas.card-moved",
          "to": "{{to}}"
        }
      },
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "atlas.board"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "state"
        }
      ]
    },
    "atlas-dispatch-log": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "atlas.log"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "entry"
        }
      ]
    },
    "atlas-dispatch-status": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "atlas.status"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "dispatch"
        }
      ]
    },
    "atlas-floor": {
      "action": {
        "event": "broadcast_request",
        "method": "meshsocket",
        "mode": "broadcast",
        "payload": {
          "item": "{{item}}",
          "msg_type": "atlas.sensor-placed",
          "x": "{{x}}",
          "y": "{{y}}"
        }
      }
    },
    "atlas-last-dispatch": {
      "sync": [
        {
          "event": "broadcast",
          "filter": {
            "msg_type": "atlas.status"
          },
          "method": "meshsocket",
          "type": "listen",
          "valuePath": "lastDispatch"
        }
      ]
    },
    "atlas-ring": {
      "sync": [
        {
          "method": "sensor",
          "sensor": "heading"
        }
      ]
    }
  },
  "headerTitle": "ATLAS",
  "name": "Atlas Ops",
  "placements": {
    "atlas-board": {
      "position": [
        0,
        0
      ],
      "span": [
        10,
        4
      ]
    },
    "atlas-dispatch-log": {
      "position": [
        8,
        0
      ],
      "span": [
        2,
        4
      ]
    },
    "atlas-dispatch-status": {
      "position": [
        7,
        0
      ],
      "span": [
        1,
        2
      ]
    },
    "atlas-floor": {
      "position": [
        0,
        0
      ],
      "span": [
        10,
        4
      ]
    },
    "atlas-last-dispatch": {
      "position": [
        7,
        2
      ],
      "span": [
        1,
        2
      ]
    },
    "atlas-ring": {
      "position": [
        0,
        0
      ],
      "span": [
        7,
        4
      ]
    }
  },
  "schemaVersion": 2,
  "tabs": [
    {
      "children": [
        {
          "id": "atlas-board",
          "label": "Incident Triage",
          "sortboardConfig": {
            "columns": 3,
            "items": [
              {
                "icon": "wifi.exclamationmark",
                "id": "NET-31",
                "label": "Uplink flap",
                "tint": "#FF6B6B"
              },
              {
                "icon": "bolt.badge.clock",
                "id": "PWR-07",
                "label": "UPS on battery",
                "tint": "#FFD60A"
              },
              {
                "icon": "video.slash.fill",
                "id": "CAM-12",
                "label": "Dock cam offline",
                "tint": "#FF9500",
                "zone": "active"
              },
              {
                "icon": "thermometer.high",
                "id": "ENV-19",
                "label": "Server room 31\u00b0C",
                "tint": "#FF453A",
                "zone": "active"
              },
              {
                "icon": "person.badge.shield.checkmark",
                "id": "SEC-02",
                "label": "Badge reader jam",
                "tint": "#30D158",
                "zone": "resolved"
              }
            ],
            "paletteLabel": "Unsorted reports",
            "searchable": true,
            "zones": [
              {
                "id": "triage",
                "label": "Triage"
              },
              {
                "capacity": 4,
                "id": "active",
                "label": "Active",
                "tint": "#FF9500"
              },
              {
                "id": "resolved",
                "label": "Resolved",
                "tint": "#30D158"
              }
            ]
          },
          "type": "sortboard"
        }
      ],
      "grid": {
        "columns": 4,
        "mode": "grid",
        "rows": 10
      },
      "icon": "square.stack.3d.up.fill",
      "title": "Triage"
    },
    {
      "children": [
        {
          "id": "atlas-floor",
          "label": "Sensor Placement",
          "pinboardConfig": {
            "background": "building.2.fill",
            "items": [
              {
                "action": {
                  "event": "broadcast_request",
                  "method": "meshsocket",
                  "mode": "broadcast",
                  "payload": {
                    "msg_type": "atlas.sensor-tapped",
                    "sensor": "{{value}}"
                  }
                },
                "icon": "thermometer.medium",
                "id": "th-lobby",
                "label": "Lobby T/H",
                "tint": "#FF9500",
                "x": 0.22,
                "y": 0.3
              },
              {
                "action": {
                  "event": "broadcast_request",
                  "method": "meshsocket",
                  "mode": "broadcast",
                  "payload": {
                    "msg_type": "atlas.sensor-tapped",
                    "sensor": "{{value}}"
                  }
                },
                "icon": "thermometer.high",
                "id": "th-server",
                "label": "Server room",
                "tint": "#FF453A",
                "x": 0.72,
                "y": 0.24
              },
              {
                "icon": "drop.fill",
                "id": "leak-basement",
                "label": "Leak sensor",
                "tint": "#64D2FF"
              },
              {
                "icon": "video.fill",
                "id": "cam-dock",
                "label": "Dock cam",
                "tint": "#30D158"
              }
            ],
            "paletteLabel": "Unplaced sensors",
            "surfaceAspect": 1.4
          },
          "type": "pinboard"
        }
      ],
      "grid": {
        "columns": 4,
        "mode": "grid",
        "rows": 10
      },
      "icon": "map.fill",
      "title": "Floor"
    },
    {
      "children": [
        {
          "compassConfig": {
            "dwell": 0.8,
            "pucks": [
              {
                "action": {
                  "event": "broadcast_request",
                  "method": "meshsocket",
                  "mode": "broadcast",
                  "payload": {
                    "crew": "{{value}}",
                    "msg_type": "atlas.dispatch"
                  }
                },
                "bearing": 0,
                "icon": "figure.walk",
                "id": "crew-north",
                "label": "North crew",
                "tint": "#FF9500"
              },
              {
                "action": {
                  "event": "broadcast_request",
                  "method": "meshsocket",
                  "mode": "broadcast",
                  "payload": {
                    "crew": "{{value}}",
                    "msg_type": "atlas.dispatch"
                  }
                },
                "bearing": 90,
                "icon": "figure.run",
                "id": "crew-east",
                "label": "East crew",
                "tint": "#30D158"
              },
              {
                "action": {
                  "event": "broadcast_request",
                  "method": "meshsocket",
                  "mode": "broadcast",
                  "payload": {
                    "crew": "{{value}}",
                    "msg_type": "atlas.dispatch"
                  }
                },
                "bearing": 180,
                "icon": "wrench.and.screwdriver.fill",
                "id": "crew-south",
                "label": "South crew",
                "tint": "#64D2FF"
              },
              {
                "action": {
                  "event": "broadcast_request",
                  "method": "meshsocket",
                  "mode": "broadcast",
                  "payload": {
                    "crew": "{{value}}",
                    "msg_type": "atlas.dispatch"
                  }
                },
                "bearing": 270,
                "icon": "cross.case.fill",
                "id": "crew-west",
                "label": "West crew",
                "tint": "#FF453A"
              }
            ],
            "tolerance": 18
          },
          "defaultValue": 15,
          "id": "atlas-ring",
          "label": "Point to dispatch",
          "type": "compass"
        },
        {
          "defaultValue": "idle",
          "id": "atlas-dispatch-status",
          "label": "Dispatch",
          "pulse": true,
          "statusColors": {
            "enroute": "#FF9500",
            "idle": "#8E8E93",
            "onsite": "#30D158"
          },
          "style": "badge",
          "type": "statusLight"
        },
        {
          "align": "trailing",
          "defaultValue": "no crew dispatched",
          "id": "atlas-last-dispatch",
          "style": "mono",
          "type": "label"
        },
        {
          "id": "atlas-dispatch-log",
          "label": "Dispatch log",
          "type": "logConsole"
        }
      ],
      "grid": {
        "columns": 4,
        "mode": "grid",
        "rows": 10
      },
      "icon": "location.north.circle.fill",
      "title": "Dispatch"
    }
  ],
  "theme": {
    "accentColor": "#FF9500",
    "accentGradient": [
      "#FF9500",
      "#FF6B6B"
    ],
    "borderColor": "#3A2A10",
    "borderWidth": 1,
    "cardPadding": 10,
    "cornerRadius": 16,
    "pageBackgroundGradient": [
      "#120B02",
      "#1F1206"
    ],
    "tabBarTint": "#FF9500"
  },
  "version": 1
}
